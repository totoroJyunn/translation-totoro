            </t>
            <t vertical="0" torder="1" id="" index="455" hasRuby="0" time="">
                <start-time>00:21:57,363</start-time>
                <end-time>00:21:59,300</end-time>
                <translation>你肯定会想到铅笔吧</translation>
                <original>まあ鉛筆イメージしますよね</original>
