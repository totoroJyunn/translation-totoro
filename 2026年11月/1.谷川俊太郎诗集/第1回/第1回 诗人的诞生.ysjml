            <t vertical="0" torder="1" id="" index="468" hasRuby="0" time="">
                <start-time>00:22:29,798</start-time>
                <end-time>00:22:31,566</end-time>
                <translation>我希望能够温和地引导听众</translation>
                <original>緩やかに誘導したいが</original>
