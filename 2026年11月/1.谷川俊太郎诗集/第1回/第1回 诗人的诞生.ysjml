            <t vertical="0" torder="1" id="" index="449" hasRuby="0" time="">
                <start-time>00:21:42,520</start-time>
                <end-time>00:21:43,940</end-time>
                <translation>所以他才写下这首诗</translation>
                <original>目の前にあるから書いてるんです</original>
