            <t vertical="0" torder="1" id="" index="454" hasRuby="0" time="">
                <start-time>00:21:55,123</start-time>
                <end-time>00:21:57,363</end-time>
                <translation>请试着在脑海中想象一支铅笔</translation>
                <original>鉛筆をイメージしてみてください</original>
