            <t vertical="0" torder="1" id="" index="457" hasRuby="0" time="">
                <start-time>00:22:00,702</start-time>
                <end-time>00:22:02,642</end-time>
                <translation>但是所谓意象</translation>
                <original>でもイマージュっていうのは</original>
