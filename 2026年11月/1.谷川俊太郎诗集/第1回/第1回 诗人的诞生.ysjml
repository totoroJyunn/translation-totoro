        <part updateMethod="0" lastModifyTime="0">
            <t vertical="0" torder="1" id="" index="1" hasRuby="0" time="">
                <start-time>00:00:05,275</start-time>
                <end-time>00:00:08,333</end-time>
                <translation>越过天空</translation>
                <original>空をこえて</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="2" hasRuby="0" time="">
                <start-time>00:00:08,333</start-time>
                <end-time>00:00:12,175</end-time>
                <translation>啦啦啦 飞向群星的彼方</translation>
                <original>ラララ星のかなた</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="3" hasRuby="0" time="">
                <start-time>00:00:12,175</start-time>
                <end-time>00:00:15,800</end-time>
                <translation>出发吧 阿童木</translation>
                <original>行くぞアトム</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="4" hasRuby="0" time="">
                <start-time>00:00:15,800</start-time>
                <end-time>00:00:21,175</end-time>
                <translation>喷气引擎的极限</translation>
                <original>ジェットの限り</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="5" hasRuby="0" time="">
                <start-time>00:00:21,175</start-time>
                <end-time>00:00:24,495</end-time>
                <translation>曾经有一位热爱宇宙的少年</translation>
                <original>かつて宇宙が大好きだった一人の少年は</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="6" hasRuby="0" time="">
                <start-time>00:00:24,495</start-time>
                <end-time>00:00:26,375</end-time>
                <translation>长大成人后</translation>
                <original>大人になり</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="7" hasRuby="0" time="">
                <start-time>00:00:26,375</start-time>
                <end-time>00:00:30,650</end-time>
                <translation>为这首家喻户晓的歌曲填了词</translation>
                <original>誰もが知るこの曲を作詞しました</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="8" hasRuby="0" time="">
                <start-time>00:00:30,650</start-time>
                <end-time>00:00:33,675</end-time>
                <translation>他就是诗人谷川俊太郎
詩人谷川俊太郎です</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="9" hasRuby="0" time="">
                <start-time>00:00:36,580</start-time>
                <end-time>00:00:40,725</end-time>
                <translation>一直引领诗歌世界的谷川俊太郎
詩の世界をリードし続けた谷川俊太郎</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="10" hasRuby="0" time="">
                <start-time>00:00:42,625</start-time>
                <end-time>00:00:46,775</end-time>
                <translation>自二十岁惊艳文坛以来</translation>
                <original>20歳で鮮烈なデビューを飾って以来</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="11" hasRuby="0" time="">
                <start-time>00:00:46,775</start-time>
                <end-time>00:00:49,375</end-time>
                <translation>他为合唱曲和校歌作词
合唱曲や校歌の作詞</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="12" hasRuby="0" time="">
                <start-time>00:00:51,125</start-time>
                <end-time>00:00:54,275</end-time>
                <translation>翻译绘本和儿童文学作品
絵本や児童文学の翻訳など</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="13" hasRuby="0" time="">
                <start-time>00:00:54,275</start-time>
                <end-time>00:00:59,160</end-time>
                <translation>以诗歌为起点展开了广泛的创作活动</translation>
                <original>詩を足掛かりに幅広い創作活動を行ってきました</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="14" hasRuby="0" time="">
                <start-time>00:01:01,660</start-time>
                <end-time>00:01:05,300</end-time>
                <translation>源自敏锐感性的谷川诗作</translation>
                <original>鋭い感性から生まれる谷川の詩は</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="15" hasRuby="0" time="">
                <start-time>00:01:05,300</start-time>
                <end-time>00:01:07,900</end-time>
                <translation>跨越时代和体裁的界限</translation>
                <original>時代やジャンルの垣根を越えて</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="16" hasRuby="0" time="">
                <start-time>00:01:07,900</start-time>
                <end-time>00:01:10,100</end-time>
                <translation>被一代代读者阅读至今</translation>
                <original>多くの人に読み継がれています</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="17" hasRuby="0" time="">
                <start-time>00:01:13,025</start-time>
                <end-time>00:01:18,050</end-time>
                <translation>诗人谷川俊太郎究竟是如何诞生的</translation>
                <original>いかにして詩人谷川俊太郎は生まれたのか</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="18" hasRuby="0" time="">
                <start-time>00:01:18,050</start-time>
                <end-time>00:01:20,575</end-time>
                <translation>让我们追溯谷川诗歌的源头</translation>
                <original>谷川の源流をたどってみましょう</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="19" hasRuby="0" time="">
                <start-time>00:01:38,950</start-time>
                <end-time>00:01:44,933</end-time>
                <translation>第1回 诗人的诞生
第1回 詩人の誕生</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="20" hasRuby="0" time="">
                <start-time>00:01:45,870</start-time>
                <end-time>00:01:49,200</end-time>
                <translation>-100分de名著主持人安部美智子 -伊集院光
-100分de名著司会の安部みちこです　-伊集院光です</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="21" hasRuby="0" time="">
                <start-time>00:01:49,200</start-time>
                <end-time>00:01:52,625</end-time>
                <translation>本月我们要介绍的是2013年出版的
今月は2013年に出版された</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="22" hasRuby="0" time="">
                <start-time>00:01:52,625</start-time>
                <end-time>00:01:55,475</end-time>
                <translation>谷川老师的《自选谷川俊太郎诗集》
谷川さん自選の『谷川俊太郎詩集』を取り上げます</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="23" hasRuby="0" time="">
                <start-time>00:01:55,475</start-time>
                <end-time>00:01:57,775</end-time>
                <translation>伊集院 谷川你当然知道吧</translation>
                <original>伊集院さん、谷川さんはご存じですよね</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="24" hasRuby="0" time="">
                <start-time>00:01:57,775</start-time>
                <end-time>00:02:01,050</end-time>
                <translation>刚才播放的《铁臂阿童木》就是他的作品</translation>
                <original>それこそ今流れた『鉄腕アトム』もそうですし</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="25" hasRuby="0" time="">
                <start-time>00:02:01,050</start-time>
                <end-time>00:02:02,850</end-time>
                <translation>前阵子我在广播节目里</translation>
                <original>この間ねラジオで</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="26" hasRuby="0" time="">
                <start-time>00:02:02,850</start-time>
                <end-time>00:02:05,900</end-time>
                <translation>向听众征集最想让孩子读的绘本
自分の子供に絶対読ませたい絵本は何ですか</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="27" hasRuby="0" time="">
                <start-time>00:02:05,900</start-time>
                <end-time>00:02:09,000</end-time>
                <translation>结果很多人在投稿</translation>
                <original>っていう投稿を募集したら</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="28" hasRuby="0" time="">
                <start-time>00:02:09,000</start-time>
                <end-time>00:02:10,925</end-time>
                <translation>提到了谷川老师
谷川先生の</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="29" hasRuby="0" time="">
                <start-time>00:02:10,925</start-time>
                <end-time>00:02:16,050</end-time>
                <translation>各种各样的童话或者说绘本</translation>
                <original>もういろんな種類の童話というか絵本が出てきて</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="30" hasRuby="0" time="">
                <start-time>00:02:16,050</start-time>
                <end-time>00:02:18,650</end-time>
                <translation>我才发现他影响了这么多人</translation>
                <original>こんなにいろんな人に影響を与えてるんだ</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="31" hasRuby="0" time="">
                <start-time>00:02:18,650</start-time>
                <end-time>00:02:19,933</end-time>
                <translation>是啊</translation>
                <original>そうなんですよね</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="32" hasRuby="0" time="">
                <start-time>00:02:19,933</start-time>
                <end-time>00:02:23,650</end-time>
                <translation>他的活动不限于诗歌 还涉及各个领域</translation>
                <original>詩にとどまらないいろんなジャンルで活躍された方なんですよね</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="33" hasRuby="0" time="">
                <start-time>00:02:23,650</start-time>
                <end-time>00:02:27,650</end-time>
                <translation>这个月就让我们沉浸在谷川先生的诗歌世界中</translation>
                <original>さあ今月は谷川さんの詩の世界に浸っていこうと思います</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="34" hasRuby="0" time="">
                <start-time>00:02:27,650</start-time>
                <end-time>00:02:31,050</end-time>
                <translation>为我们领读的是评论家兼诗人若松英辅老师
指南役は批評家で詩人の若松英輔さんです</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="35" hasRuby="0" time="">
                <start-time>00:02:31,050</start-time>
                <end-time>00:02:32,525</end-time>
                <translation>若松老师 请多指教</translation>
                <original>若松さんよろしくお願いします</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="36" hasRuby="0" time="">
                <start-time>00:02:32,525</start-time>
                <end-time>00:02:33,655</end-time>
                <translation>大家请多指教</translation>
                <original>(一同に)よろしくお願いします</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="37" hasRuby="0" time="">
                <start-time>00:02:37,405</start-time>
                <end-time>00:02:40,666</end-time>
                <translation>作为诗人也出版了许多著作的</translation>
                <original>詩人としても多くの著作を発表している</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="38" hasRuby="0" time="">
                <start-time>00:02:40,666</start-time>
                <end-time>00:02:42,150</end-time>
                <translation>若松英辅老师
若松英輔さん</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="39" hasRuby="0" time="">
                <start-time>00:02:43,800</start-time>
                <end-time>00:02:47,300</end-time>
                <translation>他认为谷川彻底改变了
谷川が日本人の詩の常識を</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="40" hasRuby="0" time="">
                <start-time>00:02:47,300</start-time>
                <end-time>00:02:49,035</end-time>
                <translation>日本人对于诗歌的传统观念</translation>
                <original>大きく変えたと考えています</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="41" hasRuby="0" time="">
                <start-time>00:02:51,460</start-time>
                <end-time>00:02:52,875</end-time>
                <translation>在谷川先生出现之前</translation>
                <original>谷川さんが出てくるまでは</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="42" hasRuby="0" time="">
                <start-time>00:02:52,875</start-time>
                <end-time>00:02:54,800</end-time>
                <translation>诗歌越难懂越好</translation>
                <original>詩っていうのは難しい方が</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="43" hasRuby="0" time="">
                <start-time>00:02:54,800</start-time>
                <end-time>00:02:57,175</end-time>
                <translation>甚至会有这种氛围</translation>
                <original>いいというような雰囲気すらあった</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="44" hasRuby="0" time="">
                <start-time>00:02:57,175</start-time>
                <end-time>00:02:59,033</end-time>
                <translation>但谷川先生出现之后</translation>
                <original>だけど谷川さんが出てきて</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="45" hasRuby="0" time="">
                <start-time>00:02:59,033</start-time>
                <end-time>00:03:01,125</end-time>
                <translation>我们平日所说的</translation>
                <original>私たちが日頃話している</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="46" hasRuby="0" time="">
                <start-time>00:03:01,125</start-time>
                <end-time>00:03:04,225</end-time>
                <translation>这些话语也可以成为诗的语言</translation>
                <original>そういう言葉も詩の言葉として用いることができるんだ</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="47" hasRuby="0" time="">
                <start-time>00:03:04,225</start-time>
                <end-time>00:03:07,325</end-time>
                <translation>我想人们开始有了这样的认识</translation>
                <original>というふうになったんだと思うんですね</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="48" hasRuby="0" time="">
                <start-time>00:03:07,325</start-time>
                <end-time>00:03:09,500</end-time>
                <translation>用浅显易懂的话语写成的诗</translation>
                <original>分かりやすい言葉で書かれている詩</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="49" hasRuby="0" time="">
                <start-time>00:03:09,500</start-time>
                <end-time>00:03:11,875</end-time>
                <translation>原来是比较晚近才出现的啊</translation>
                <original>って割と最近なんですね</original>
                <spell/>
            </t>
            <t vertical="0" torder="1" id="" index="50" hasRuby="0" time="">
                <start-time>00:03:11,875</start-time>
                <end-time>00:03:16,066</end-time>
                <translation>所以我们总觉得要费心琢磨学过的词句</translation>
                <original>だから何か私たちはこう習った言葉を一生懸命工夫して</original>
                <spell/>
