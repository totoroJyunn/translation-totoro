            </t>
            <t hasRuby="0" index="320" vertical="0" time="" torder="1" id="">
                <start-time>00:14:21,593</start-time>
                <end-time>00:14:23,053</end-time>
                <translation>平时不太会听到吧</translation>
                <original>あまり聞き慣れない言葉ですけれども</original>
