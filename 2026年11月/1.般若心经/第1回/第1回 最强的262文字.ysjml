                <start-time>00:10:27,623</start-time>
                <end-time>00:10:35,123</end-time>
                <translation>揭谛揭谛 波罗揭谛 波罗僧揭谛 菩提萨婆诃
羯諦羯諦波羅羯諦波羅僧羯諦菩提薩婆訶</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" index="241" vertical="0" time="" torder="1" id="">
                <start-time>00:10:35,123</start-time>
                <end-time>00:10:36,598</end-time>
                <translation>感觉如何？</translation>
                <original>いかがですか</original>
                <spell/>
            </t>
            <t hasRuby="0" index="242" vertical="0" time="" torder="1" id="">
                <start-time>00:10:36,598</start-time>
                <end-time>00:10:38,948</end-time>
                <translation>这个我听过</translation>
                <original>これ聞いたことがあります</original>
                <spell/>
            </t>
            <t hasRuby="0" index="243" vertical="0" time="" torder="1" id="">
                <start-time>00:10:38,948</start-time>
                <end-time>00:10:40,403</end-time>
                <translation>尤其是“揭谛揭谛”这句</translation>
                <original>羯諦羯諦っていうの</original>
                <spell/>
            </t>
            <t hasRuby="0" index="244" vertical="0" time="" torder="1" id="">
                <start-time>00:10:40,403</start-time>
                <end-time>00:10:42,873</end-time>
                <translation>我小时候听了最兴奋的就是这段</translation>
                <original>これ子供心に一番心躍ったところなんです</original>
                <spell/>
            </t>
            <t hasRuby="0" index="245" vertical="0" time="" torder="1" id="">
                <start-time>00:10:42,873</start-time>
                <end-time>00:10:48,048</end-time>
                <translation>大人那么认真地念着“揭谛揭谛”</translation>
                <original>大人が真面目にこの「羯諦羯諦」を言ってるリズムとか</original>
                <spell/>
            </t>
