        <part updateMethod="0" lastModifyTime="0">
            <t hasRuby="0" index="1" vertical="0" time="" torder="1" id="">
                <start-time>00:00:00,000</start-time>
                <end-time>00:00:03,505</end-time>
                <translation>经济持续低迷 失业率居高不下
長引く不況、高い失業率</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" index="2" vertical="0" time="" torder="1" id="">
                <start-time>00:00:03,505</start-time>
                <end-time>00:00:05,465</end-time>
                <translation>社会弥漫着压抑感
蔓延する閉塞感</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" index="3" vertical="0" time="" torder="1" id="">
                <start-time>00:00:05,465</start-time>
                <end-time>00:00:10,315</end-time>
                <translation>做什么都不顺利</translation>
                <original>何もかもうまくいかない</original>
                <spell/>
            </t>
            <t hasRuby="0" index="4" vertical="0" time="" torder="1" id="">
                <start-time>00:00:10,315</start-time>
                <end-time>00:00:13,740</end-time>
                <translation>有能战胜所有的烦恼方法么？</translation>
                <original>どんな悩みにも打ち勝つことができる方法はないだろうか</original>
                <spell/>
            </t>
            <t hasRuby="0" index="5" vertical="0" time="" torder="1" id="">
                <start-time>00:00:13,740</start-time>
                <end-time>00:00:17,896</end-time>
                <translation>在日本流传诵读了1500年的佛经</translation>
                <original>日本で1500年の昔から読み継がれてきたお経</original>
                <spell/>
            </t>
            <t hasRuby="0" index="6" vertical="0" time="" torder="1" id="">
                <start-time>00:00:17,896</start-time>
                <end-time>00:00:19,290</end-time>
                <translation>《般若心经》</translation>
                <original>般若心経</original>
                <spell/>
            </t>
            <t hasRuby="0" index="7" vertical="0" time="" torder="1" id="">
                <start-time>00:00:19,290</start-time>
                <end-time>00:00:21,565</end-time>
                <translation>不仅是修行佛道的僧人</translation>
                <original>仏道に生きる僧だけでなく</original>
                <spell/>
            </t>
            <t hasRuby="0" index="8" vertical="0" time="" torder="1" id="">
                <start-time>00:00:21,565</start-time>
                <end-time>00:00:26,060</end-time>
                <translation>普通人也从这短短262字的经文中</translation>
                <original>普通の人々がわずか262文字のお経の言葉に</original>
                <spell/>
            </t>
            <t hasRuby="0" index="9" vertical="0" time="" torder="1" id="">
                <start-time>00:00:26,060</start-time>
                <end-time>00:00:29,290</end-time>
                <translation>获得了心灵的安宁和生活的勇气</translation>
                <original>心の安らぎや生きる勇気を得てきました</original>
                <spell/>
            </t>
            <t hasRuby="0" index="10" vertical="0" time="" torder="1" id="">
                <start-time>00:00:29,290</start-time>
                <end-time>00:00:31,915</end-time>
                <translation>那么 这部《般若心经》
では一体この般若心経には</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" index="11" vertical="0" time="" torder="1" id="">
                <start-time>00:00:31,915</start-time>
                <end-time>00:00:36,265</end-time>
                <translation>究竟蕴含着怎样的信息呢？</translation>
                <original>どんなメッセージが込められているのでしょうか</original>
                <spell/>
            </t>
            <t hasRuby="0" index="12" vertical="0" time="" torder="1" id="">
                <start-time>00:00:36,265</start-time>
                <end-time>00:00:39,315</end-time>
                <translation>《100分de名著》之《般若心经》</translation>
                <original>100分de名著般若心経</original>
                <spell/>
            </t>
            <t hasRuby="0" index="13" vertical="0" time="" torder="1" id="">
                <start-time>00:00:39,315</start-time>
                <end-time>00:00:43,090</end-time>
                <translation>第1回以“最强的262字”为题
第1回は「最強の262文字」と題して</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" index="14" vertical="0" time="" torder="1" id="">
                <start-time>00:00:43,090</start-time>
                <end-time>00:00:45,140</end-time>
                <translation>《般若心经》究竟是什么？
般若心経とは何か</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" index="15" vertical="0" time="" torder="1" id="">
                <start-time>00:00:45,140</start-time>
                <end-time>00:00:47,520</end-time>
                <translation>我们将探寻它的精髓</translation>
                <original>その神髄に迫ります</original>
                <spell/>
            </t>
            <t hasRuby="0" index="16" vertical="0" time="" torder="1" id="">
                <start-time>00:00:47,520</start-time>
                <end-time>00:00:52,995</end-time>
                <translation>第1回 最强的262字</translation>
                <original>第1回　最強の262文字</original>
                <spell/>
            </t>
            <t hasRuby="0" index="17" vertical="0" time="" torder="1" id="">
                <start-time>00:00:52,995</start-time>
                <end-time>00:00:56,970</end-time>
                <translation>伊集院 这次我们要讲《般若心经》
伊集院さん、今回は般若心経を取り上げるんですが</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" index="18" vertical="0" time="" torder="1" id="">
                <start-time>00:00:56,970</start-time>
                <end-time>00:01:00,145</end-time>
                <translation>你对它有什么印象呢？</translation>
                <original>般若心経というとどんなイメージをお持ちですか</original>
                <spell/>
            </t>
            <t hasRuby="0" index="19" vertical="0" time="" torder="1" id="">
                <start-time>00:01:00,145</start-time>
                <end-time>00:01:01,790</end-time>
                <translation>这个嘛</translation>
                <original>そうですね</original>
                <spell/>
            </t>
            <t hasRuby="0" index="20" vertical="0" time="" torder="1" id="">
                <start-time>00:01:01,790</start-time>
                <end-time>00:01:03,545</end-time>
                <translation>我没什么宗教信仰
僕、基本無宗教なんですけど</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" index="21" vertical="0" time="" torder="1" id="">
                <start-time>00:01:03,545</start-time>
                <end-time>00:01:05,355</end-time>
                <translation>但还是经常能听到它</translation>
                <original>でも耳にする機会多いし</original>
                <spell/>
            </t>
            <t hasRuby="0" index="22" vertical="0" time="" torder="1" id="">
                <start-time>00:01:05,355</start-time>
                <end-time>00:01:06,595</end-time>
                <translation>今天早上我还问了太太</translation>
                <original>あと、今朝カミさん</original>
                <spell/>
            </t>
            <t hasRuby="0" index="23" vertical="0" time="" torder="1" id="">
                <start-time>00:01:06,595</start-time>
                <end-time>00:01:08,245</end-time>
                <translation>她也不信教</translation>
                <original>これまた無宗教なんですけど</original>
                <spell/>
            </t>
            <t hasRuby="0" index="24" vertical="0" time="" torder="1" id="">
                <start-time>00:01:08,245</start-time>
                <end-time>00:01:09,555</end-time>
                <translation>问她对这个有什么印象</translation>
                <original>どう？って聞いたら</original>
                <spell/>
            </t>
            <t hasRuby="0" index="25" vertical="0" time="" torder="1" id="">
                <start-time>00:01:09,555</start-time>
                <end-time>00:01:11,415</end-time>
                <translation>她说好像是跟奶奶学过</translation>
                <original>なんかおばあちゃんに習ったかなんかで</original>
                <spell/>
            </t>
            <t hasRuby="0" index="26" vertical="0" time="" torder="1" id="">
                <start-time>00:01:11,415</start-time>
                <end-time>00:01:14,535</end-time>
                <translation>姑且 整部她大概都能背下来</translation>
                <original>一応全部暗唱できるよ、なんて言ってましたね</original>
                <spell/>
            </t>
            <t hasRuby="0" index="27" vertical="0" time="" torder="1" id="">
                <start-time>00:01:14,535</start-time>
                <end-time>00:01:16,645</end-time>
                <translation>不过仔细想想 我奶奶也经常</translation>
                <original>でも確かにうちのおばあちゃんも</original>
                <spell/>
            </t>
            <t hasRuby="0" index="28" vertical="0" time="" torder="1" id="">
                <start-time>00:01:16,645</start-time>
                <end-time>00:01:18,475</end-time>
                <translation>在家里的佛龛前</translation>
                <original>よくお仏壇の前で</original>
                <spell/>
            </t>
            <t hasRuby="0" index="29" vertical="0" time="" torder="1" id="">
                <start-time>00:01:18,475</start-time>
                <end-time>00:01:20,145</end-time>
                <translation>诵念《般若心经》</translation>
                <original>般若心経を唱えていたんですよね</original>
                <spell/>
            </t>
            <t hasRuby="0" index="30" vertical="0" time="" torder="1" id="">
                <start-time>00:01:20,145</start-time>
                <end-time>00:01:21,110</end-time>
                <translation>感觉真是很亲切呢</translation>
                <original>なんか身近ですよね</original>
                <spell/>
            </t>
            <t hasRuby="0" index="31" vertical="0" time="" torder="1" id="">
                <start-time>00:01:21,110</start-time>
                <end-time>00:01:24,170</end-time>
                <translation>很多人多少都听过这部经吧</translation>
                <original>聞いたことがなんとなくあるって方、多いですよね</original>
                <spell/>
            </t>
            <t hasRuby="0" index="32" vertical="0" time="" torder="1" id="">
                <start-time>00:01:24,170</start-time>
                <end-time>00:01:29,170</end-time>
                <translation>这就是《般若心经》的262个字</translation>
                <original>でこちらが般若心経の262文字です</original>
                <spell/>
            </t>
            <t hasRuby="0" index="33" vertical="0" time="" torder="1" id="">
                <start-time>00:01:29,170</start-time>
                <end-time>00:01:32,588</end-time>
                <translation>这样一看 真是只有262字啊</translation>
                <original>こうしてみると262文字ですか</original>
                <spell/>
            </t>
            <t hasRuby="0" index="34" vertical="0" time="" torder="1" id="">
                <start-time>00:01:32,588</start-time>
                <end-time>00:01:34,545</end-time>
                <translation>这节目还真是走极端啊</translation>
                <original>この番組、極端ですよね</original>
                <spell/>
            </t>
            <t hasRuby="0" index="35" vertical="0" time="" torder="1" id="">
                <start-time>00:01:34,545</start-time>
                <end-time>00:01:37,145</end-time>
                <translation>像《源氏物语》那么长的作品</translation>
                <original>あの『源氏物語』みたいに長いやつも</original>
                <spell/>
            </t>
            <t hasRuby="0" index="36" vertical="0" time="" torder="1" id="">
                <start-time>00:01:37,145</start-time>
                <end-time>00:01:39,695</end-time>
                <translation>我们也要试着用100分钟讲明白</translation>
                <original>100分で一応読み解いていこうと</original>
                <spell/>
            </t>
            <t hasRuby="0" index="37" vertical="0" time="" torder="1" id="">
                <start-time>00:01:39,695</start-time>
                <end-time>00:01:43,995</end-time>
                <translation>这次则要用100分钟讲262个字</translation>
                <original>で今回は262文字を100分でやっていこうということですね</original>
                <spell/>
            </t>
            <t hasRuby="0" index="38" vertical="0" time="" torder="1" id="">
                <start-time>00:01:43,995</start-time>
                <end-time>00:01:45,434</end-time>
                <translation>这部《般若心经》
この般若心経</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" index="39" vertical="0" time="" torder="1" id="">
                <start-time>00:01:45,434</start-time>
                <end-time>00:01:49,620</end-time>
                <translation>是众多佛经中最受日本人喜爱的</translation>
                <original>数あるお経の中でも最も日本人に愛されてきました</original>
                <spell/>
            </t>
            <t hasRuby="0" index="40" vertical="0" time="" torder="1" id="">
                <start-time>00:01:49,620</start-time>
                <end-time>00:01:51,540</end-time>
                <translation>至于为何一直深受喜爱</translation>
                <original>なぜ愛されてきたかというと</original>
                <spell/>
            </t>
            <t hasRuby="0" index="41" vertical="0" time="" torder="1" id="">
                <start-time>00:01:51,540</start-time>
                <end-time>00:01:54,495</end-time>
                <translation>是因为在这短短262字里</translation>
                <original>この262文字という短い言葉の中に</original>
                <spell/>
            </t>
            <t hasRuby="0" index="42" vertical="0" time="" torder="1" id="">
                <start-time>00:01:54,495</start-time>
                <end-time>00:01:57,913</end-time>
                <translation>藏满了使人摆脱一切烦恼的最强智慧</translation>
                <original>あらゆる悩みから解き放たれる最強の知恵</original>
                <spell/>
            </t>
            <t hasRuby="0" index="43" vertical="0" time="" torder="1" id="">
                <start-time>00:01:57,913</start-time>
                <end-time>00:02:00,995</end-time>
                <translation>还有强大的力量</translation>
                <original>パワーが詰まっているからということなんです</original>
                <spell/>
            </t>
            <t hasRuby="0" index="44" vertical="0" time="" torder="1" id="">
                <start-time>00:02:00,995</start-time>
                <end-time>00:02:03,719</end-time>
                <translation>要说烦恼和妄念有多少</translation>
                <original>悩みと煩悩の数においてはですね</original>
                <spell/>
            </t>
            <t hasRuby="0" index="45" vertical="0" time="" torder="1" id="">
                <start-time>00:02:03,719</start-time>
                <end-time>00:02:04,653</end-time>
                <translation>我可是很有自信的</translation>
                <original>自信がありますので</original>
                <spell/>
            </t>
            <t hasRuby="0" index="46" vertical="0" time="" torder="1" id="">
                <start-time>00:02:04,653</start-time>
                <end-time>00:02:05,935</end-time>
                <translation>所以还挺期待的</translation>
                <original>ちょっと楽しみでございます</original>
                <spell/>
            </t>
            <t hasRuby="0" index="47" vertical="0" time="" torder="1" id="">
                <start-time>00:02:05,935</start-time>
                <end-time>00:02:09,115</end-time>
                <translation>接下来将花费四周</translation>
                <original>はい100分de名著、これから4週にわたって</original>
                <spell/>
            </t>
            <t hasRuby="0" index="48" vertical="0" time="" torder="1" id="">
                <start-time>00:02:09,115</start-time>
                <end-time>00:02:14,220</end-time>
                <translation>解读《般若心经》这262字的秘密
般若心経、最強の262文字の秘密を読み解いていきます</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" index="49" vertical="0" time="" torder="1" id="">
                <start-time>00:02:14,220</start-time>
                <end-time>00:02:16,885</end-time>
                <translation>那么先来介绍本次的讲解嘉宾</translation>
                <original>それでは今回の指南役をご紹介しましょう</original>
                <spell/>
            </t>
            <t hasRuby="0" index="50" vertical="0" time="" torder="1" id="">
                <start-time>00:02:16,885</start-time>
                <end-time>00:02:19,495</end-time>
                <translation>花园大学的佐佐木闲老师
花園大学の佐々木閑です</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" index="51" vertical="0" time="" torder="1" id="">
                <start-time>00:02:19,495</start-time>
                <end-time>00:02:23,320</end-time>
                <translation>请多关照</translation>
                <original>よろしくお願いいたします</original>
                <spell/>
