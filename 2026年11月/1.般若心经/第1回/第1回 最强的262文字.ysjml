            </t>
            <t hasRuby="0" index="314" vertical="0" time="" torder="1" id="">
                <start-time>00:14:09,258</start-time>
                <end-time>00:14:10,053</end-time>
                <translation>这边啊？</translation>
                <original>そうですか</original>
