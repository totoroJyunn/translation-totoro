            </t>
            <t hasRuby="0" index="315" vertical="0" time="" torder="1" id="">
                <start-time>00:14:10,053</start-time>
                <end-time>00:14:12,208</end-time>
                <translation>这台摄影机也拍到了吗？</translation>
                <original>もうこのカメラに映っておりましたか</original>
                <spell/>
            </t>
            <t hasRuby="0" index="316" vertical="0" time="" torder="1" id="">
                <start-time>00:14:12,208</start-time>
                <end-time>00:14:15,183</end-time>
                <translation>我真有点听不明白啊</translation>
                <original>わかんないですね</original>
                <spell/>
            </t>
            <t hasRuby="0" index="317" vertical="0" time="" torder="1" id="">
                <start-time>00:14:15,183</start-time>
                <end-time>00:14:17,033</end-time>
                <translation>一下子冒出这么多词</translation>
