            <t hasRuby="0" time="" index="388" torder="1" vertical="0" id="">
                <start-time>00:18:19,660</start-time>
                <end-time>00:18:22,180</end-time>
                <translation>这也是这一定义的意义
そういう定理でもあるんですね</translation>
                <original/>
