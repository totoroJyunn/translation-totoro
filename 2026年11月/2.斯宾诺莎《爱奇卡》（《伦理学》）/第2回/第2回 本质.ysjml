                <start-time>00:23:13,917</start-time>
                <end-time>00:23:16,638</end-time>
                <translation>也许通过分析就能解决
多分分析でなんとかなったりとか</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="499" torder="1" vertical="0" id="">
                <start-time>00:23:16,638</start-time>
                <end-time>00:23:18,680</end-time>
                <translation>至少怒气会减轻
少なくとも減るんだ</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="500" torder="1" vertical="0" id="">
                <start-time>00:23:18,680</start-time>
                <end-time>00:23:19,880</end-time>
                <translation>我很喜欢这一点
っていうことに関しては</translation>
                <original/>
