                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="509" torder="1" vertical="0" id="">
                <start-time>00:23:33,547</start-time>
                <end-time>00:23:34,880</end-time>
                <translation>这是从程度上来思考的
そういう考え方であるって言うんです</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="510" torder="1" vertical="0" id="">
                <start-time>00:23:34,880</start-time>
                <end-time>00:23:37,821</end-time>
                <translation>斯宾诺莎的思想是非常实用</translation>
