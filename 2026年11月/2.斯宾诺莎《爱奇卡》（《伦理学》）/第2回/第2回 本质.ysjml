                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="420" torder="1" vertical="0" id="">
                <start-time>00:20:07,428</start-time>
                <end-time>00:20:08,980</end-time>
                <translation>气得浑身发抖
怒りに震えました</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="421" torder="1" vertical="0" id="">
                <start-time>00:20:10,547</start-time>
                <end-time>00:20:12,285</end-time>
                <translation>据说他打算前往屠杀现场
