                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="391" torder="1" vertical="0" id="">
                <start-time>00:18:29,389</start-time>
                <end-time>00:18:31,241</end-time>
                <translation>作如此详尽的论述？
