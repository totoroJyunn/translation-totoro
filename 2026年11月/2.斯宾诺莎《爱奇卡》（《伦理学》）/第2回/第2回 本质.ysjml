            <t hasRuby="0" time="" index="437" torder="1" vertical="0" id="">
                <start-time>00:20:56,903</start-time>
                <end-time>00:20:58,441</end-time>
                <translation>那就是宗教战争
宗教戦争ですね</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="438" torder="1" vertical="0" id="">
                <start-time>00:20:58,441</start-time>
                <end-time>00:20:59,640</end-time>
                <translation>宗教改革后
宗教改革があって</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="439" torder="1" vertical="0" id="">
                <start-time>00:20:59,640</start-time>
                <end-time>00:21:02,943</end-time>
                <translation>新教和旧教激烈对立</translation>
                <original>その後新教と旧教が猛烈に対立して</original>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="440" torder="1" vertical="0" id="">
                <start-time>00:21:02,943</start-time>
                <end-time>00:21:04,823</end-time>
                <translation>即使是普通人
