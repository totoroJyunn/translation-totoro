                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="508" torder="1" vertical="0" id="">
                <start-time>00:23:31,480</start-time>
                <end-time>00:23:33,547</end-time>
                <translation>悲伤也稍稍减少了吧？
