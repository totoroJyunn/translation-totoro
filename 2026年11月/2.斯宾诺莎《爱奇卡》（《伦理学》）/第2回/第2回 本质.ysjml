                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="86" torder="1" vertical="0" id="">
                <start-time>00:04:38,194</start-time>
                <end-time>00:04:39,740</end-time>
                <translation>本质被称为“Eidos”
