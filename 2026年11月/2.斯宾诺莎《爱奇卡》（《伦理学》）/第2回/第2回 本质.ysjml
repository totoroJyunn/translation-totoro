            <t hasRuby="0" time="" index="434" torder="1" vertical="0" id="">
                <start-time>00:20:49,851</start-time>
                <end-time>00:20:52,444</end-time>
                <translation>斯宾诺莎是17世纪的哲学家
スピノザ17世紀の哲学者ですけれども</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="435" torder="1" vertical="0" id="">
                <start-time>00:20:52,444</start-time>
                <end-time>00:20:54,709</end-time>
                <translation>而思考16、17世纪的欧洲
16世紀17世紀を考えるときに</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="436" torder="1" vertical="0" id="">
                <start-time>00:20:54,709</start-time>
                <end-time>00:20:56,903</end-time>
                <translation>有一件事绝对绕不开
