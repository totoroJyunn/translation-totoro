            <t hasRuby="0" time="" index="407" torder="1" vertical="0" id="">
                <start-time>00:19:18,507</start-time>
                <end-time>00:19:21,642</end-time>
                <translation>荷兰与英国爆发战争
イギリスと戦争が勃発</translation>
                <original/>
                <spell/>
