                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="424" torder="1" vertical="0" id="">
                <start-time>00:20:18,626</start-time>
                <end-time>00:20:21,680</end-time>
                <translation>但被房东拦住了
