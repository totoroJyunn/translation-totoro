                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="393" torder="1" vertical="0" id="">
                <start-time>00:18:35,732</start-time>
                <end-time>00:18:39,219</end-time>
                <translation>在斯宾诺莎生活的17世纪中叶的荷兰
