            </t>
            <t hasRuby="0" time="" index="414" torder="1" vertical="0" id="">
                <start-time>00:19:45,834</start-time>
                <end-time>00:19:48,239</end-time>
                <translation>迎接被诬陷逮捕的哥哥时
