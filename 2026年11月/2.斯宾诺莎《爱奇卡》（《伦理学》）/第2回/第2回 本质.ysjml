                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="416" torder="1" vertical="0" id="">
                <start-time>00:19:53,053</start-time>
                <end-time>00:19:54,843</end-time>
                <translation>民众出于仇恨
