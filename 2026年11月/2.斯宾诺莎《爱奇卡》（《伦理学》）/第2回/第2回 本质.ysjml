                <start-time>00:18:39,219</start-time>
                <end-time>00:18:41,560</end-time>
                <translation>曾发生一场悲剧
ある悲劇的な事件がありました</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="395" torder="1" vertical="0" id="">
                <start-time>00:18:44,337</start-time>
                <end-time>00:18:45,741</end-time>
                <translation>事件的主人公
その主人公は</translation>
                <original/>
