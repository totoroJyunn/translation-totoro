            <t hasRuby="0" time="" index="419" torder="1" vertical="0" id="">
                <start-time>00:20:02,698</start-time>
                <end-time>00:20:07,428</end-time>
                <translation>斯宾诺莎得知德·维特兄弟惨遭杀害
