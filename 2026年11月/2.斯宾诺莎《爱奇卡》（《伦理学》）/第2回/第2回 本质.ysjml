                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="386" torder="1" vertical="0" id="">
                <start-time>00:18:14,560</start-time>
                <end-time>00:18:17,580</end-time>
                <translation>他把嘲弄性的笑
