        <part lastModifyTime="0" updateMethod="0">
            <t hasRuby="0" time="" index="1" torder="1" vertical="0" id="">
                <start-time>00:00:03,500</start-time>
                <end-time>00:00:08,875</end-time>
                <translation>哲学家斯宾诺莎的代表作《伦理学》
哲学者スピノザの代表作エチカ</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="2" torder="1" vertical="0" id="">
                <start-time>00:00:08,875</start-time>
                <end-time>00:00:11,060</end-time>
                <translation>在这部著作中斯宾诺莎思考了
ここでスピノザが考えるのは</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="3" torder="1" vertical="0" id="">
                <start-time>00:00:11,060</start-time>
                <end-time>00:00:13,820</end-time>
                <translation>人的本质</translation>
                <original>人間の本質について</original>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="4" torder="1" vertical="0" id="">
                <start-time>00:00:15,295</start-time>
                <end-time>00:00:17,120</end-time>
                <translation>斯宾诺莎认为 一种被称为“conatus”的力量
スピノザはコナトゥスと言われる力こそと言われる力こそ</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="5" torder="1" vertical="0" id="">
                <start-time>00:00:18,968</start-time>
                <end-time>00:00:22,000</end-time>
                <translation>才是人的本质
人間の本質だと言います</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="6" torder="1" vertical="0" id="">
                <start-time>00:00:22,000</start-time>
                <end-time>00:00:26,270</end-time>
                <translation>这彻底颠覆了自古希腊以来的传统观念
これは古代以来の考え方の大転換でした</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="7" torder="1" vertical="0" id="">
                <start-time>00:00:28,220</start-time>
                <end-time>00:00:31,975</end-time>
                <translation>驱使人行动的欲望
人間を突き動かす欲望</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="8" torder="1" vertical="0" id="">
                <start-time>00:00:31,975</start-time>
                <end-time>00:00:34,584</end-time>
                <translation>以及形形色色的情感
そして様々な感情</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="9" torder="1" vertical="0" id="">
                <start-time>00:00:35,775</start-time>
                <end-time>00:00:39,475</end-time>
                <translation>斯宾诺莎之所以深刻审视这些事物
それらをスピノザが深く見つめた背景には</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="10" torder="1" vertical="0" id="">
                <start-time>00:00:39,475</start-time>
                <end-time>00:00:43,200</end-time>
                <translation>是因为他身处一个“激情”肆虐的时代
激しい情念が吹き荒れた時代がありました</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="11" torder="1" vertical="0" id="">
                <start-time>00:00:46,950</start-time>
                <end-time>00:00:52,000</end-time>
                <translation>本回我们将进一步理解
人所具有的力量
今回は人間が持つ力について理解を深めます</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="12" torder="1" vertical="0" id="">
                <start-time>00:01:15,250</start-time>
                <end-time>00:01:20,597</end-time>
                <translation>第2回　本质</translation>
                <original>第2回　本質</original>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="13" torder="1" vertical="0" id="">
                <start-time>00:01:21,275</start-time>
                <end-time>00:01:23,525</end-time>
                <translation>《100分de名著》主持人安部美智子
100分で名著司会の安部みちこです</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="14" torder="1" vertical="0" id="">
                <start-time>00:01:23,525</start-time>
                <end-time>00:01:24,925</end-time>
                <translation>伊集院光
伊集院光です</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="15" torder="1" vertical="0" id="">
                <start-time>00:01:24,925</start-time>
                <end-time>00:01:27,880</end-time>
                <translation>本月的名著是斯宾诺莎的《伦理学》
さあ今月の名著はスピノザのエチカですが</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="16" torder="1" vertical="0" id="">
                <start-time>00:01:27,880</start-time>
                <end-time>00:01:31,650</end-time>
                <translation>上一回谈到了斯宾诺莎独特的善恶观
前回はスピノザ独特の善と悪について取り上げました</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="17" torder="1" vertical="0" id="">
                <start-time>00:01:31,650</start-time>
                <end-time>00:01:32,980</end-time>
                <translation>伊集院 有什么感想？
伊集院さんいかがでしたか</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="18" torder="1" vertical="0" id="">
                <start-time>00:01:32,980</start-time>
                <end-time>00:01:34,600</end-time>
                <translation>一开始就说这部书非常难
最初すごく難しいと言われて</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="19" torder="1" vertical="0" id="">
                <start-time>00:01:34,600</start-time>
                <end-time>00:01:36,900</end-time>
                <translation>实际读起来也确实很难
実際に読むのは難しいんですけど</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="20" torder="1" vertical="0" id="">
                <start-time>00:01:36,900</start-time>
                <end-time>00:01:38,381</end-time>
                <translation>不过 大致说来
大雑把に言うと</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="21" torder="1" vertical="0" id="">
                <start-time>00:01:38,381</start-time>
                <end-time>00:01:40,725</end-time>
                <translation>自己觉得有趣、感到高兴
自分が楽しかったり嬉しかったり</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="22" torder="1" vertical="0" id="">
                <start-time>00:01:40,725</start-time>
                <end-time>00:01:43,750</end-time>
                <translation>或是令人喜悦的事情
喜ばしいと思うことは</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="23" torder="1" vertical="0" id="">
                <start-time>00:01:43,750</start-time>
                <end-time>00:01:46,080</end-time>
                <translation>便可以说是好的、善的
良いこと善だろうみたいのは</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="24" torder="1" vertical="0" id="">
                <start-time>00:01:46,080</start-time>
                <end-time>00:01:47,625</end-time>
                <translation>这种话很鼓舞人呢
元気が出る言葉でしたね</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="25" torder="1" vertical="0" id="">
                <start-time>00:01:47,625</start-time>
                <end-time>00:01:50,250</end-time>
                <translation>是啊 听起来就很容易接受
そうですねスーッと入ってきましたもんね</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="26" torder="1" vertical="0" id="">
                <start-time>00:01:50,250</start-time>
                <end-time>00:01:53,780</end-time>
                <translation>国分老师 第2回要讨论什么？
国分さん第2回の今日はどんなところを見ていきますか</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="27" torder="1" vertical="0" id="">
                <start-time>00:01:53,780</start-time>
                <end-time>00:01:56,400</end-time>
                <translation>是呢 上一回我们谈的是善与恶
そうですね前回は善と悪っていう</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="28" torder="1" vertical="0" id="">
                <start-time>00:01:56,400</start-time>
                <end-time>00:01:58,420</end-time>
                <translation>也就是好与坏
良い悪いの話をしましたけれども</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="29" torder="1" vertical="0" id="">
                <start-time>00:01:58,420</start-time>
                <end-time>00:02:00,837</end-time>
                <translation>其中提到了“活动能力”
そこで活動能力っていうね</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="30" torder="1" vertical="0" id="">
                <start-time>00:02:00,837</start-time>
                <end-time>00:02:02,575</end-time>
                <translation>提到了这个词呢
言葉が出てきましたよね</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="31" torder="1" vertical="0" id="">
                <start-time>00:02:02,575</start-time>
                <end-time>00:02:05,140</end-time>
                <translation>既然说是能力 也就是力量
能力ってことですからつまり力ですね</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="32" torder="1" vertical="0" id="">
                <start-time>00:02:05,140</start-time>
                <end-time>00:02:07,150</end-time>
                <translation>而这种力量
この力っていうものを</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="33" torder="1" vertical="0" id="">
                <start-time>00:02:07,150</start-time>
                <end-time>00:02:09,700</end-time>
                <translation>其实是斯宾诺莎非常重视的东西
実はスピノーザ非常に重視していたんですよね</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="34" torder="1" vertical="0" id="">
                <start-time>00:02:09,700</start-time>
                <end-time>00:02:12,725</end-time>
                <translation>今天我们希望从“力量”的概念出发
この力っていう概念を見ながら</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="35" torder="1" vertical="0" id="">
                <start-time>00:02:12,725</start-time>
                <end-time>00:02:15,650</end-time>
                <translation>逐渐接近人的本质
人間の本質っていうのに迫っていきたいなっていうのが</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="36" torder="1" vertical="0" id="">
                <start-time>00:02:15,650</start-time>
                <end-time>00:02:16,775</end-time>
                <translation>这就是今天的目标
今日の目論みになります</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="37" torder="1" vertical="0" id="">
                <start-time>00:02:16,775</start-time>
                <end-time>00:02:19,322</end-time>
                <translation>那么 关于这种力量
はいその力について</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="38" torder="1" vertical="0" id="">
                <start-time>00:02:19,322</start-time>
                <end-time>00:02:21,020</end-time>
                <translation>斯宾诺莎究竟是怎么说的？
スピノザはどのように言っているのか</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="39" torder="1" vertical="0" id="">
                <start-time>00:02:21,020</start-time>
                <end-time>00:02:22,550</end-time>
                <translation>请先看这一段
まずこちらご覧ください</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="40" torder="1" vertical="0" id="">
                <start-time>00:02:24,575</start-time>
                <end-time>00:02:26,475</end-time>
                <translation>斯宾诺莎认为
スピノザは考えました</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="41" torder="1" vertical="0" id="">
                <start-time>00:02:26,475</start-time>
                <end-time>00:02:31,875</end-time>
                <translation>不论是人、动物 还是草木、石头
人間であれ動物であれ草木や石であれ</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="42" torder="1" vertical="0" id="">
                <start-time>00:02:31,875</start-time>
                <end-time>00:02:34,120</end-time>
                <translation>世间的一切事物
この世界にあるあらゆるものは</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="43" torder="1" vertical="0" id="">
                <start-time>00:02:34,120</start-time>
                <end-time>00:02:37,525</end-time>
                <translation>都是神的显现
全て神の現れであると</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="44" torder="1" vertical="0" id="">
                <start-time>00:02:37,525</start-time>
                <end-time>00:02:42,000</end-time>
                <translation>那么 每一个独立的存在究竟是什么？
では一つ一つの存在とはどういうものなのか</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="45" torder="1" vertical="0" id="">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:02:44,725</start-time>
                <end-time>00:02:50,325</end-time>
                <translation>每个事物努力保持自身存在的努力</translation>
                <original>Conatus, quo unaquaeque res in suo esse perseverare conatur,</original>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="46" torder="1" vertical="0" id="">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:02:50,325</start-time>
                <end-time>00:02:54,350</end-time>
                <translation>无非就是它现实的本质</translation>
                <original>nihil est praeter ipsius rei actualem essentiam.</original>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="47" torder="1" vertical="0" id="">
                <start-time>00:02:56,300</start-time>
                <end-time>00:03:01,575</end-time>
                <translation>万物都具有一种
すべての者には</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="48" torder="1" vertical="0" id="">
                <start-time>00:03:01,575</start-time>
                <end-time>00:03:04,250</end-time>
                <translation>竭力维持自身存在的努力</translation>
                <original>コナトゥスがある</original>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="49" torder="1" vertical="0" id="">
                <start-time>00:03:04,250</start-time>
                <end-time>00:03:06,300</end-time>
                <translation>正是这种力量
この力こそが</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="50" torder="1" vertical="0" id="">
                <start-time>00:03:06,300</start-time>
                <end-time>00:03:08,775</end-time>
                <translation>构成了我们的本质
私たちの本質なのだと</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="51" torder="1" vertical="0" id="">
                <start-time>00:03:08,775</start-time>
                <end-time>00:03:12,200</end-time>
                <translation>斯宾诺莎如是说
スピノザは言うのです</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="52" torder="1" vertical="0" id="">
                <start-time>00:03:12,200</start-time>
                <end-time>00:03:14,625</end-time>
                <translation>就是想继续活下去之类的吧？
