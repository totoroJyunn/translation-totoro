            <t hasRuby="0" time="" index="401" torder="1" vertical="0" id="">
                <start-time>00:18:59,234</start-time>
                <end-time>00:19:01,616</end-time>
                <translation>斯宾诺莎也对他抱有共鸣
スピノザも共感を寄せていました</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="402" torder="1" vertical="0" id="">
                <start-time>00:19:02,820</start-time>
                <end-time>00:19:05,494</end-time>
                <translation>然而 作为议会领袖的他
