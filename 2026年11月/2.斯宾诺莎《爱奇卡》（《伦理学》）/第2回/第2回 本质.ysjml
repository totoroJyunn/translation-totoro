                <original/>
                <spell/>
            </t>
            <t hasRuby="0" time="" index="431" torder="1" vertical="0" id="">
                <start-time>00:20:43,213</start-time>
                <end-time>00:20:45,150</end-time>
                <translation>也并非直接影响了著作的形成
