                <spell/>
            </t>
            <t index="164" torder="1" vertical="0" id="" hasRuby="0" time="">
                <start-time>00:08:03,950</start-time>
                <end-time>00:08:06,180</end-time>
                <translation>这一点任何人都无法否认
