                <spell/>
            </t>
            <t index="163" torder="1" vertical="0" id="" hasRuby="0" time="">
                <start-time>00:07:59,875</start-time>
                <end-time>00:08:03,950</end-time>
                <translation>此刻正在思考的“我”确实存在
