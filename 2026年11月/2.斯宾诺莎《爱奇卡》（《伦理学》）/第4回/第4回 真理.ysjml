                <original/>
                <spell/>
            </t>
            <t index="118" torder="1" vertical="0" id="" hasRuby="0" time="">
                <start-time>00:06:02,900</start-time>
                <end-time>00:06:05,020</end-time>
                <translation>那我当然会问他
