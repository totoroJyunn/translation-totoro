            </t>
            <t index="524" torder="1" vertical="0" id="" hasRuby="0" time="">
                <start-time>00:22:45,080</start-time>
                <end-time>00:22:46,803</end-time>
                <translation>才懂《伦理学》的意思</translation>
                <original>エチカ って</original>
                <spell/>
            </t>
            <t index="525" torder="1" vertical="0" id="" hasRuby="0" time="">
                <start-time>00:22:46,803</start-time>
                <end-time>00:22:49,217</end-time>
                <translation>这样的事情确实有可能发生
