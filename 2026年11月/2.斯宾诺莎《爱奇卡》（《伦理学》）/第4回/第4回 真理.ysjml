                <original/>
                <spell/>
            </t>
            <t index="522" torder="1" vertical="0" id="" hasRuby="0" time="">
                <start-time>00:22:41,000</start-time>
                <end-time>00:22:42,497</end-time>
                <translation>直到自己终于有所改变
変化して変化してスタンバイできた時に</translation>
                <original/>
                <spell/>
            </t>
            <t index="523" torder="1" vertical="0" id="" hasRuby="0" time="">
                <start-time>00:22:42,497</start-time>
                <end-time>00:22:45,080</end-time>
                <translation>忽然就会明白“啊 原来是这个意思”
