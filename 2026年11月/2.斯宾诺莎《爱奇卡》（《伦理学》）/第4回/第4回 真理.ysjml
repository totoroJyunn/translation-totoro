                <original/>
                <spell/>
            </t>
            <t index="132" torder="1" vertical="0" id="" hasRuby="0" time="">
                <start-time>00:06:36,600</start-time>
                <end-time>00:06:38,247</end-time>
                <translation>也就是说</translation>
