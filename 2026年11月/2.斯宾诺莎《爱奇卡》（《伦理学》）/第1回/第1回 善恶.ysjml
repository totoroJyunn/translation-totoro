        <part lastModifyTime="0" updateMethod="0">
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="1">
                <start-time>00:00:02,700</start-time>
                <end-time>00:00:05,450</end-time>
                <translation>17世纪的荷兰</translation>
                <original>17世紀のオランダ</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="2">
                <start-time>00:00:05,450</start-time>
                <end-time>00:00:06,823</end-time>
                <translation>有一位被世人厌恶</translation>
                <original>世間から嫌われ、</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="3">
                <start-time>00:00:06,823</start-time>
                <end-time>00:00:09,800</end-time>
                <translation>不断遭到声讨的哲学家</translation>
                <original>糾弾され続けた哲学者がいました</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="4">
                <start-time>00:00:11,575</start-time>
                <end-time>00:00:15,725</end-time>
                <translation>本笃·德·斯宾诺莎</translation>
                <original>ベネディクトゥス・デ・スピノザ</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="5">
                <start-time>00:00:15,725</start-time>
                <end-time>00:00:18,200</end-time>
                <translation>他出生于荷兰的犹太家庭</translation>
                <original>オランダ生まれのユダヤ人でしたが</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="6">
                <start-time>00:00:18,200</start-time>
                <end-time>00:00:20,435</end-time>
                <translation>却与犹太教决裂</translation>
                <original>ユダヤ教と決別</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="7">
                <start-time>00:00:20,435</start-time>
                <end-time>00:00:24,495</end-time>
                <translation>作为哲学家度过了孤高的一生</translation>
                <original>哲学者として孤高の人生を送りました</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="8">
                <start-time>00:00:26,590</start-time>
                <end-time>00:00:29,560</end-time>
                <translation>靠磨制镜片等工作谋生的同时</translation>
                <original>レンズ磨きなどで生計を立てながら</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="9">
                <start-time>00:00:29,560</start-time>
                <end-time>00:00:31,450</end-time>
                <translation>斯宾诺莎思考的问题是</translation>
                <original>スピノザが考えたのは</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="10">
                <start-time>00:00:31,450</start-time>
                <end-time>00:00:34,120</end-time>
                <translation>人如何才能幸福地生活</translation>
                <original>人間が幸せに生きる道、</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="11">
                <start-time>00:00:34,120</start-time>
                <end-time>00:00:36,740</end-time>
                <translation>以及关于“神”的种种</translation>
                <original>そして神について</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="12">
                <start-time>00:00:38,925</start-time>
                <end-time>00:00:45,175</end-time>
                <translation>他的想法与犹太教和基督教都格格不入</translation>
                <original>その考えはユダヤ教にもキリスト教にもそぐわない異質なもの</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="13">
                <start-time>00:00:45,175</start-time>
                <end-time>00:00:48,031</end-time>
                <translation>人们骂他是异端 是无神论者
異端、無神論者と罵られ、</translation>
                <original/>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="14">
                <start-time>00:00:48,031</start-time>
                <end-time>00:00:51,345</end-time>
                <translation>他终其一生都没有获得声望</translation>
                <original>生涯名声を得ることはありませんでした</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="15">
                <start-time>00:00:54,345</start-time>
                <end-time>00:00:57,107</end-time>
                <translation>他去世后出版的</translation>
                <original>彼の死後、出版されたのが</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="16">
                <start-time>00:00:57,107</start-time>
                <end-time>00:00:58,250</end-time>
                <translation>就是《伦理学》</translation>
                <original>『エチカ』です</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="17">
                <start-time>00:00:59,675</start-time>
                <end-time>00:01:03,079</end-time>
                <translation>他的思想至今仍对后世的哲学家和科学家
その思想は後の哲学者や科学者に</translation>
                <original/>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="18">
                <start-time>00:01:03,079</start-time>
                <end-time>00:01:05,750</end-time>
                <translation>产生着深远的影响</translation>
                <original>多大な影響を与え続けています</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="19">
                <start-time>00:01:08,815</start-time>
                <end-time>00:01:13,625</end-time>
                <translation>这次我们来解读这部以晦涩著称的哲学著作《伦理学》</translation>
                <original>難解とも言われる哲学書『エチカ』を読み解きます</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="20">
                <start-time>00:01:36,700</start-time>
                <end-time>00:01:42,925</end-time>
                <translation>第1回 善与恶
第1回　善悪</translation>
                <original/>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="21">
                <start-time>00:01:43,625</start-time>
                <end-time>00:01:45,750</end-time>
                <translation>《100分de名著》 主持人安部美知子
100分de名著　司会の安部みちこです</translation>
                <original/>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="22">
                <start-time>00:01:45,750</start-time>
                <end-time>00:01:47,100</end-time>
                <translation>伊集院光
伊集院光です</translation>
                <original/>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="23">
                <start-time>00:01:47,100</start-time>
                <end-time>00:01:50,627</end-time>
                <translation>伊集院 这个月的名著可得做好心理准备啊
伊集院さん今月の名著は覚悟が必要ですよ</translation>
                <original/>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="24">
                <start-time>00:01:50,627</start-time>
                <end-time>00:01:52,795</end-time>
                <translation>工作人员都一个劲儿给我施压</translation>
                <original>みんなスタッフもプレッシャーかけてくるんですよ</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="25">
                <start-time>00:01:52,800</start-time>
                <end-time>00:01:54,575</end-time>
                <translation>说这次可不好办啊</translation>
                <original>大変ですよ、みたいな</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="26">
                <start-time>00:01:54,575</start-time>
                <end-time>00:01:56,975</end-time>
                <translation>究竟是哪本书呢 请看</translation>
                <original>何かと言いますとこちら</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="27">
                <start-time>00:01:56,975</start-time>
                <end-time>00:01:59,000</end-time>
                <translation>斯宾诺莎的《伦理学》</translation>
                <original>スピノザの『エチカ』なんです</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="28">
                <start-time>00:01:59,000</start-time>
                <end-time>00:02:00,375</end-time>
                <translation>这是一本哲学书</translation>
                <original>哲学の本なんですけども</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="29">
                <start-time>00:02:00,375</start-time>
                <end-time>00:02:02,915</end-time>
                <translation>我也是第一次读</translation>
                <original>私も今回初めて読んだんですけど</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="30">
                <start-time>00:02:02,915</start-time>
                <end-time>00:02:05,950</end-time>
                <translation>结果读到上册第42页就放弃了
上巻の42ページ目で挫折</translation>
                <original/>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="31">
                <start-time>00:02:05,950</start-time>
                <end-time>00:02:08,075</end-time>
                <translation>完全看不懂</translation>
                <original>全然わからなかったです</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="32">
                <start-time>00:02:08,075</start-time>
                <end-time>00:02:09,375</end-time>
                <translation>这可真叫人不安</translation>
                <original>不安だねこれは</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="33">
                <start-time>00:02:09,375</start-time>
                <end-time>00:02:11,240</end-time>
                <translation>只能依靠老师了</translation>
                <original>もう先生に頼るしかありません</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="34">
                <start-time>00:02:11,240</start-time>
                <end-time>00:02:16,275</end-time>
                <translation>有请哲学家 东京工业大学教授国分功一郎先生</translation>
                <original>哲学者で東京工業大学教授の國分功一郎さんです</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="35">
                <start-time>00:02:16,275</start-time>
                <end-time>00:02:17,555</end-time>
                <translation>初次见面 大家好</translation>
                <original>どうも初めまして</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="36">
                <start-time>00:02:17,555</start-time>
                <end-time>00:02:20,295</end-time>
                <translation>-请多关照 -请多关照</translation>
                <original>-よろしくお願いします　-よろしくお願いします</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="37">
                <start-time>00:02:22,245</start-time>
                <end-time>00:02:26,000</end-time>
                <translation>国分功一郎老师
國分功一郎さん</translation>
                <original/>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="38">
                <start-time>00:02:26,000</start-time>
                <end-time>00:02:28,055</end-time>
                <translation>研究法国当代思想</translation>
                <original>フランス現代思想や</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="39">
                <start-time>00:02:28,055</start-time>
                <end-time>00:02:33,250</end-time>
                <translation>以及17世纪西方哲学的国分老师
17世紀の西洋哲学を研究してきた國分さん</translation>
                <original/>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="40">
                <start-time>00:02:33,250</start-time>
                <end-time>00:02:37,275</end-time>
                <translation>其中他持续研究了20多年的</translation>
                <original>中でも20年以上取り組み続けているのが</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="41">
                <start-time>00:02:37,275</start-time>
                <end-time>00:02:39,035</end-time>
                <translation>就是斯宾诺莎</translation>
                <original>スピノザだといいます</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="42">
                <start-time>00:02:41,760</start-time>
                <end-time>00:02:43,875</end-time>
                <translation>你是如何与斯宾诺莎结缘的呢</translation>
                <original>出会いはどんなところだったのか</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="43">
                <start-time>00:02:43,875</start-time>
                <end-time>00:02:47,375</end-time>
                <translation>我年轻的时候 法国的吧</translation>
                <original>あのう僕が若い頃、フランスの</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="44">
                <start-time>00:02:47,375</start-time>
                <end-time>00:02:49,650</end-time>
                <translation>20世纪哲学家特别流行</translation>
                <original>20世紀の哲学者ってすごくはやったんですよ</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="45">
                <start-time>00:02:49,650</start-time>
                <end-time>00:02:50,875</end-time>
                <translation>真是风靡一时</translation>
                <original>非常に流行したんです</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="46">
                <start-time>00:02:50,875</start-time>
                <end-time>00:02:52,850</end-time>
                <translation>那就是所谓的后现代思想</translation>
                <original>ポストモダンの思想っていって</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="47">
                <start-time>00:02:52,850</start-time>
                <end-time>00:02:57,125</end-time>
                <translation>在这些思想家当中 备受关注的就是斯宾诺莎</translation>
                <original>彼らの中で結構人気があったし 注目されていたのがスピノザで</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="48">
                <start-time>00:02:57,125</start-time>
                <end-time>00:02:58,235</end-time>
                <translation>所以怎么说呢</translation>
                <original>だからなんていうか</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="49">
                <start-time>00:02:58,235</start-time>
                <end-time>00:03:00,550</end-time>
                <translation>如果说自己不喜欢斯宾诺莎</translation>
                <original>スピノザを好きじゃないなんて</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="50">
                <start-time>00:03:00,550</start-time>
                <end-time>00:03:02,315</end-time>
                <translation>就会被人觉得很没品位</translation>
                <original>えっかっこ悪いな、みたいな</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="51">
                <start-time>00:03:02,315</start-time>
                <end-time>00:03:03,900</end-time>
                <translation>当时就是这种风气啊</translation>
                <original>そういうもんだったんですよ</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" hasRuby="0" vertical="0" index="52">
