            <t id="" time="" torder="1" vertical="0" hasRuby="0" index="115">
                <start-time>00:07:46,650</start-time>
                <end-time>00:07:49,915</end-time>
                <translation>是不得已才做的</translation>
                <original>まああの仕方なくやったんだなというふうに</original>
