                <spell/>
            </t>
            <t id="" time="" torder="1" vertical="0" hasRuby="0" index="119">
                <start-time>00:07:57,730</start-time>
                <end-time>00:08:01,475</end-time>
                <translation>自己是一个尊重法律的公民</translation>
                <original>で自分は法というものを尊重する市民であると</original>
