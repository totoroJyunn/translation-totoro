            <t id="" time="" torder="1" vertical="0" hasRuby="0" index="111">
                <start-time>00:07:32,898</start-time>
                <end-time>00:07:34,550</end-time>
                <translation>也遵守了法律</translation>
                <original>法にもしたがっていたのだ</original>
