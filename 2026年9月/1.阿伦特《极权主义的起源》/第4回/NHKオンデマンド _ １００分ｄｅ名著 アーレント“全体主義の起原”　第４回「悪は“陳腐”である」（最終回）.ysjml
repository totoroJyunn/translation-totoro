            </t>
            <t id="" time="" torder="1" vertical="0" hasRuby="0" index="120">
                <start-time>00:08:01,475</start-time>
                <end-time>00:08:03,295</end-time>
                <translation>并不是服从某个人</translation>
                <original>誰かに従うんじゃなくて</original>
