            </t>
            <t index="301" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:19:25,068</start-time>
                <end-time>00:19:27,440</end-time>
                <translation>时代在加速前进</translation>
                <original>時代は加速してゆくのです</original>
                <spell/>
            </t>
            <t index="302" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:19:33,000</start-time>
                <end-time>00:19:35,369</end-time>
                <translation>天啊 有点能想象出来了</translation>
                <original>うわなんかちょっと想像がついてきた</original>
