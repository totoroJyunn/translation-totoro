                <start-time>00:21:47,200</start-time>
                <end-time>00:21:49,387</end-time>
                <translation>是否有可能发生呢</translation>
                <original>起こり得るのかっていう</original>
                <spell/>
            </t>
            <t id="" index="344" hasRuby="0" torder="1" vertical="0" time="">
                <start-time>00:21:49,387</start-time>
                <end-time>00:21:50,940</end-time>
                <translation>比如说</translation>
                <original>あの例えばね</original>
                <spell/>
            </t>
            <t id="" index="345" hasRuby="0" torder="1" vertical="0" time="">
                <start-time>00:21:50,970</start-time>
                <end-time>00:21:54,125</end-time>
