            </t>
            <t id="" index="346" hasRuby="0" torder="1" vertical="0" time="">
                <start-time>00:21:54,125</start-time>
                <end-time>00:21:56,875</end-time>
                <translation>非常贫困的孩子越来越多</translation>
                <original>まあすごくその貧困な子が増えて</original>
                <spell/>
            </t>
            <t id="" index="347" hasRuby="0" torder="1" vertical="0" time="">
                <start-time>00:21:56,875</start-time>
                <end-time>00:22:01,265</end-time>
