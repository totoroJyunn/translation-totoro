            <t index="152" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:09:19,015</start-time>
                <end-time>00:09:22,675</end-time>
                <translation>我们来回顾一下诗人保罗·瓦莱里的话</translation>
