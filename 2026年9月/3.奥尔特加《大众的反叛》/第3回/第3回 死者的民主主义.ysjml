            <t index="137" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:08:22,575</start-time>
                <end-time>00:08:25,100</end-time>
                <translation>当发现往右是错的时候</translation>
                <original>右やったら間違ったって時に</original>
