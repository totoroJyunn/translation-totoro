            </t>
            <t index="213" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:12:19,650</start-time>
                <end-time>00:12:22,275</end-time>
                <translation>如果变成了那样的存在</translation>
                <original>そんな存在になっているとするならば</original>
