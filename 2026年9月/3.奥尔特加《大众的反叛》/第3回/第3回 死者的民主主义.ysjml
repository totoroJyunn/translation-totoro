            </t>
            <t index="154" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:09:27,250</start-time>
                <end-time>00:09:30,275</end-time>
                <translation>这个想法与奥尔特加的思想是共通的</translation>
