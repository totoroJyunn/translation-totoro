                <original/>
                <spell/>
            </t>
            <t index="149" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:09:07,625</start-time>
                <end-time>00:09:10,550</end-time>
                <translation>正是通过直视过去</translation>
