            <t index="294" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:16:40,800</start-time>
                <end-time>00:16:42,725</end-time>
                <translation>大家共同形成共识的事情</translation>
                <original>みんなで合意形成をしてきたこと</original>
