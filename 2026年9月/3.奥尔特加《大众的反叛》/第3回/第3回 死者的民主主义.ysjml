            </t>
            <t index="142" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:08:39,145</start-time>
                <end-time>00:08:41,600</end-time>
                <translation>在理解奥尔特加的思想时</translation>
                <original>オルテガの考えを理解する上で</original>
