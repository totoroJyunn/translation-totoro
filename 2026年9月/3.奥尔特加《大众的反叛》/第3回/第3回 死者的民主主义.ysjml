            </t>
            <t index="144" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:08:47,625</start-time>
                <end-time>00:08:51,125</end-time>
                <translation>就像划着浮在湖上的小船</translation>
                <original>湖に浮かべたボートを漕ぐように</original>
                <spell/>
            </t>
            <t index="145" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:08:51,125</start-time>
                <end-time>00:08:55,952</end-time>
                <translation>人是背对着未来进入未来的</translation>
                <original>人は後ろ向きに未来へ入っていく</original>
