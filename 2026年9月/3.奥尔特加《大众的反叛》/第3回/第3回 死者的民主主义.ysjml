                <start-time>00:09:31,660</start-time>
                <end-time>00:09:33,189</end-time>
                <translation>认真地审视过去</translation>
                <original>過去をしっかりと見る</original>
                <spell/>
            </t>
            <t index="157" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:09:33,189</start-time>
                <end-time>00:09:36,592</end-time>
                <translation>仔细地观察那些逝者们的热忱</translation>
                <original>その死者たちの鋭意というものをじっくり見てみること</original>
                <spell/>
            </t>
            <t index="158" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:09:36,592</start-time>
                <end-time>00:09:38,700</end-time>
                <translation>这绝不是消极的</translation>
                <original>というのは何も後ろ向きじゃないと</original>
