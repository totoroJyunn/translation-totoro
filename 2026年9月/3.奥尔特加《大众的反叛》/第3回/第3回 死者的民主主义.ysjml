                <spell/>
            </t>
            <t index="218" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:12:32,735</start-time>
                <end-time>00:12:35,100</end-time>
                <translation>我想 一起活下去不就好了吗</translation>
                <original>一緒に生きていけばいいんじゃないかと思ったんですね</original>
                <spell/>
            </t>
            <t index="219" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:12:35,100</start-time>
                <end-time>00:12:37,072</end-time>
                <translation>恐怕那样的事情</translation>
                <original>おそらくそういうことが</original>
                <spell/>
            </t>
            <t index="220" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:12:37,072</start-time>
                <end-time>00:12:40,725</end-time>
                <translation>正被灾区追问着吧 我这么想</translation>
