            </t>
            <t index="212" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:12:17,475</start-time>
                <end-time>00:12:19,650</end-time>
                <translation>仿佛在某个地方向我投来</translation>
                <original>どこかで私に投げかけてくるような</original>
