            <t id="" vertical="0" index="284" time="" hasRuby="0" torder="1">
                <start-time>00:15:59,300</start-time>
                <end-time>00:16:02,300</end-time>
                <translation>-如果是西装就放心了　-包括放心这一点</translation>
