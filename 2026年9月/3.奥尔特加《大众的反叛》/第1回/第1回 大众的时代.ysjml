                <spell/>
            </t>
            <t id="" vertical="0" index="262" time="" hasRuby="0" torder="1">
                <start-time>00:15:01,340</start-time>
                <end-time>00:15:04,450</end-time>
                <translation>这种“感觉大家都一样”</translation>
                <original>このみんな同じだというふうに感じることが</original>
                <spell/>
            </t>
            <t id="" vertical="0" index="263" time="" hasRuby="0" torder="1">
                <start-time>00:15:04,450</start-time>
                <end-time>00:15:06,525</end-time>
                <translation>反而感觉良好</translation>
