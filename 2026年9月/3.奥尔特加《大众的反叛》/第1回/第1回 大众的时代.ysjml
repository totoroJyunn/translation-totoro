                <spell/>
            </t>
            <t id="" vertical="0" index="254" time="" hasRuby="0" torder="1">
                <start-time>00:14:37,650</start-time>
                <end-time>00:14:40,160</end-time>
                <translation>压抑卓越的个性</translation>
