                <spell/>
            </t>
            <t id="" torder="1" time="" index="271" vertical="0" hasRuby="0">
                <start-time>00:15:00,675</start-time>
                <end-time>00:15:03,875</end-time>
                <translation>为了追求自由而破坏自由
