            <t id="" torder="1" time="" index="259" vertical="0" hasRuby="0">
                <start-time>00:14:04,026</start-time>
                <end-time>00:14:07,000</end-time>
                <translation>会产生死者与生者之间的关系性之类的东西</translation>
