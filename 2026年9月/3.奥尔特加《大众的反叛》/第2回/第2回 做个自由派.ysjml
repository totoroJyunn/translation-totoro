                <spell/>
            </t>
            <t id="" torder="1" time="" index="258" vertical="0" hasRuby="0">
                <start-time>00:14:02,575</start-time>
                <end-time>00:14:04,026</end-time>
                <translation>在那个过程之中</translation>
