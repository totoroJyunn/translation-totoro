                <original/>
                <spell/>
            </t>
            <t id="" torder="1" time="" index="272" vertical="0" hasRuby="0">
                <start-time>00:15:03,875</start-time>
                <end-time>00:15:06,375</end-time>
                <translation>描绘出了大众的形象</translation>
                <original>大衆の姿を表しています</original>
                <spell/>
            </t>
            <t id="" torder="1" time="" index="273" vertical="0" hasRuby="0">
                <start-time>00:15:07,950</start-time>
                <end-time>00:15:10,675</end-time>
                <translation>破坏传统和习俗</translation>
                <original>伝統や慣習を破壊することは</original>
