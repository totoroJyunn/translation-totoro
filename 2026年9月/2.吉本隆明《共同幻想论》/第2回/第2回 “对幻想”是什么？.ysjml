            <t id="" vertical="0" hasRuby="0" index="75" time="" torder="1">
                <start-time>00:04:57,125</start-time>
                <end-time>00:05:02,100</end-time>
                <translation>此时人际关系中产生了阶级差异</translation>
                <original>ここで人間関係に階級差が生じるのです</original>
