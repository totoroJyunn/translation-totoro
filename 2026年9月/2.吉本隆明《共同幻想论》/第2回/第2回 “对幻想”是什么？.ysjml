            </t>
            <t id="" vertical="0" hasRuby="0" index="87" time="" torder="1">
                <start-time>00:05:53,150</start-time>
                <end-time>00:05:55,154</end-time>
                <translation>在我看来</translation>
                <original>私の考えでは</original>
