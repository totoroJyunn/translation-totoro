            </t>
            <t id="" vertical="0" hasRuby="0" index="97" time="" torder="1">
                <start-time>00:06:40,680</start-time>
                <end-time>00:06:42,869</end-time>
                <translation>在原始时代</translation>
                <original>原始の時代においては</original>
