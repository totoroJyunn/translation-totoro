            </t>
            <t id="" vertical="0" hasRuby="0" index="353" time="" torder="1">
                <start-time>00:22:05,850</start-time>
                <end-time>00:22:07,640</end-time>
                <translation>其中存在着这样的危险</translation>
                <original>そこにはこういう危うさがあって</original>
                <spell/>
            </t>
            <t id="" vertical="0" hasRuby="0" index="354" time="" torder="1">
                <start-time>00:22:07,640</start-time>
                <end-time>00:22:10,650</end-time>
