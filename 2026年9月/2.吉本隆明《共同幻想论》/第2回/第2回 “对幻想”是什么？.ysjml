            </t>
            <t id="" vertical="0" hasRuby="0" index="80" time="" torder="1">
                <start-time>00:05:18,170</start-time>
                <end-time>00:05:23,175</end-time>
                <translation>另一方面 吉本认为原始群婚等说法值得怀疑
一方吉本は原始集団婚など疑わしいと考え</translation>
                <original/>
                <spell/>
