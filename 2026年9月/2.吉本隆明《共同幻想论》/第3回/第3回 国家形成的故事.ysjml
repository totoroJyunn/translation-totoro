                <spell/>
            </t>
            <t index="107" torder="1" id="" hasRuby="0" time="" vertical="0">
                <start-time>00:07:29,250</start-time>
                <end-time>00:07:30,760</end-time>
                <translation>他这算不上什么罪过吧？</translation>
