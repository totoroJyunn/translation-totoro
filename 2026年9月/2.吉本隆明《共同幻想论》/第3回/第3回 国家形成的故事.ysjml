            </t>
            <t index="93" torder="1" id="" hasRuby="0" time="" vertical="0">
                <start-time>00:06:44,125</start-time>
                <end-time>00:06:48,275</end-time>
                <translation>父亲却命令他“去治理海洋”</translation>
