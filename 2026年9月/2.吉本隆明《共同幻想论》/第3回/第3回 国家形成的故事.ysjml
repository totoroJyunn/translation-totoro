            </t>
            <t index="100" torder="1" id="" hasRuby="0" time="" vertical="0">
                <start-time>00:07:06,280</start-time>
                <end-time>00:07:07,280</end-time>
                <translation>感到了困惑</translation>
                <original>困惑した</original>
