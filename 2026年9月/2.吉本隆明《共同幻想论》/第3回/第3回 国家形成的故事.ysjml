            </t>
            <t index="103" torder="1" id="" hasRuby="0" time="" vertical="0">
                <start-time>00:07:14,840</start-time>
                <end-time>00:07:18,325</end-time>
                <translation>心中便产生了内疚之情</translation>
                <original>心の中にやましさの感情が宿ってくると</original>
