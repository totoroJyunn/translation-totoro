            </t>
            <t index="108" torder="1" id="" hasRuby="0" time="" vertical="0">
                <start-time>00:07:30,760</start-time>
                <end-time>00:07:31,860</end-time>
                <translation>他说的这种话</translation>
                <original>これを言うことは</original>
