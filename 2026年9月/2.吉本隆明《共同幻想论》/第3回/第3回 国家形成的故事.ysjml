                <original/>
                <spell/>
            </t>
            <t index="79" torder="1" id="" hasRuby="0" time="" vertical="0">
                <start-time>00:05:54,050</start-time>
                <end-time>00:05:56,255</end-time>
                <translation>使统治变得牢固</translation>
                <original>支配を強固なものにしました</original>
                <spell/>
            </t>
            <t index="80" torder="1" id="" hasRuby="0" time="" vertical="0">
                <start-time>00:06:01,380</start-time>
                <end-time>00:06:03,180</end-time>
                <translation>首先在《古事记》中</translation>
                <original>まず古事記では</original>
                <spell/>
            </t>
            <t index="81" torder="1" id="" hasRuby="0" time="" vertical="0">
                <start-time>00:06:03,180</start-time>
                <end-time>00:06:06,900</end-time>
                <translation>须佐之男是作为原始农耕共同体的象征</translation>
                <original>スサノオは原始農耕共同体の象徴として</original>
