            <t index="98" torder="1" id="" hasRuby="0" time="" vertical="0">
                <start-time>00:06:59,300</start-time>
                <end-time>00:07:01,600</end-time>
                <translation>这样一来 须佐之男</translation>
                <original>そうするとスサノオはですね</original>
