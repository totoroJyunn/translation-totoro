            </t>
            <t index="125" torder="1" id="" hasRuby="0" time="" vertical="0">
                <start-time>00:08:18,860</start-time>
                <end-time>00:08:21,825</end-time>
                <translation>会抱有愧疚感、罪恶感 这很容易理解</translation>
