            <t index="84" torder="1" id="" hasRuby="0" time="" vertical="0">
                <start-time>00:06:14,750</start-time>
                <end-time>00:06:19,700</end-time>
                <translation>由大和朝廷逐步以殖民化和战争的方式统一</translation>
