                <original/>
                <spell/>
            </t>
            <t index="74" torder="1" id="" hasRuby="0" time="" vertical="0">
                <start-time>00:05:30,120</start-time>
                <end-time>00:05:33,100</end-time>
                <translation>那是破坏自然</translation>
                <original>それは自然を破壊し</original>
