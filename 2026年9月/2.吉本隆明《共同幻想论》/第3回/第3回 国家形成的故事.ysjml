            </t>
            <t index="117" torder="1" id="" hasRuby="0" time="" vertical="0">
                <start-time>00:07:54,975</start-time>
                <end-time>00:07:58,450</end-time>
                <translation>大概就须佐之男被命令做的事</translation>
