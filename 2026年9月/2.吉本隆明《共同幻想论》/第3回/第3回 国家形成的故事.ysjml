            </t>
            <t index="72" torder="1" id="" hasRuby="0" time="" vertical="0">
                <start-time>00:05:20,550</start-time>
                <end-time>00:05:25,475</end-time>
                <translation>另一方面 大和朝廷破坏了原始的生活
