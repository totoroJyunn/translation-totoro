            </t>
            <t index="76" torder="1" id="" hasRuby="0" time="" vertical="0">
                <start-time>00:05:41,660</start-time>
                <end-time>00:05:45,812</end-time>
                <translation>大和朝廷将本应由自己背负的原罪
