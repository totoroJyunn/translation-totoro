            </t>
            <t index="92" torder="1" id="" hasRuby="0" time="" vertical="0">
                <start-time>00:06:40,275</start-time>
                <end-time>00:06:44,125</end-time>
                <translation>尽管他想被定位在那里</translation>
                <original>でそこに位置づけたいのにも関わらずですね</original>
