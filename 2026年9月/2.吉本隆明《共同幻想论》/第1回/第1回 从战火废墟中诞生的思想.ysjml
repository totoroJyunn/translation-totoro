            <t id="" time="" torder="1" vertical="0" index="192" hasRuby="0">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:12:06,500</start-time>
                <end-time>00:12:11,750</end-time>
                <translation>嘲笑知识分子和文学家的豹变
知識人文学者の豹変ぶりを嗤うことは</translation>
                <original/>
                <spell/>
            </t>
            <t id="" time="" torder="1" vertical="0" index="193" hasRuby="0">
                <marks>
