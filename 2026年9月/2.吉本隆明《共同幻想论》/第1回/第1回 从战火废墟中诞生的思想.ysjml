                <spell/>
            </t>
            <t id="" time="" torder="1" vertical="0" index="211" hasRuby="0">
                <start-time>00:13:35,130</start-time>
                <end-time>00:13:37,220</end-time>
                <translation>我非常理解</translation>
                <original>すごくよく分かりますね</original>
