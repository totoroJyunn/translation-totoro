            <t id="" time="" torder="1" vertical="0" index="183" hasRuby="0">
                <start-time>00:11:23,625</start-time>
                <end-time>00:11:27,375</end-time>
                <translation>这些士兵们接到天皇的命令</translation>
                <original>この兵士たちは天皇の命令一下</original>
                <spell/>
