            <t id="" time="" torder="1" vertical="0" index="280" hasRuby="0">
                <start-time>00:17:44,850</start-time>
                <end-time>00:17:49,150</end-time>
                <translation>为何曾经赞美过自己所爱的战争的诗人们</translation>
