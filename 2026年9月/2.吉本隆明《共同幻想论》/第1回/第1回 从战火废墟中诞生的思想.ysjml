            </t>
            <t id="" time="" torder="1" vertical="0" index="289" hasRuby="0">
                <start-time>00:18:22,450</start-time>
                <end-time>00:18:26,038</end-time>
                <translation>会为战时被视为常识的东西服务呢</translation>
