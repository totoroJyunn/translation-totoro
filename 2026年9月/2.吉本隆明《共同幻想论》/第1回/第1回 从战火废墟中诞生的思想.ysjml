            <t id="" time="" torder="1" vertical="0" index="190" hasRuby="0">
                <start-time>00:11:53,250</start-time>
                <end-time>00:11:57,940</end-time>
                <translation>日本人究竟是怎样的人种啊</translation>
                <original>日本人というのは一体何という人種なんだろう</original>
