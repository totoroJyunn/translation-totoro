            <t id="" time="" torder="1" vertical="0" index="182" hasRuby="0">
                <start-time>00:11:18,700</start-time>
                <end-time>00:11:23,625</end-time>
                <translation>满载而归的复员士兵们的身影</translation>
                <original>復員してくる兵士たちの姿です</original>
