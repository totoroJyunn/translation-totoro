            <t id="" time="" torder="1" vertical="0" index="247" hasRuby="0">
                <start-time>00:15:21,900</start-time>
                <end-time>00:15:25,500</end-time>
                <translation>这样一来 总觉得好像有能对号入座的地方</translation>
