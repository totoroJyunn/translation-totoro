        <part updateMethod="0" lastModifyTime="0">
            <t torder="1" vertical="0" id="" hasRuby="0" index="1" time="">
                <start-time>00:00:03,000</start-time>
                <end-time>00:00:06,085</end-time>
                <translation>《叹异抄》中所写的亲鸾的教诲
歎異抄に書かれた親鸞の教え</translation>
                <original/>
                <spell/>
            </t>
            <t torder="1" vertical="0" id="" hasRuby="0" index="2" time="">
                <start-time>00:00:06,752</start-time>
                <end-time>00:00:10,289</end-time>
                <translation>现代的我们要顺利理解这一点</translation>
                <original>現代の私たちがこれをすんなりと理解するのは</original>
                <spell/>
            </t>
            <t torder="1" vertical="0" id="" hasRuby="0" index="3" time="">
                <start-time>00:00:10,289</start-time>
                <end-time>00:00:13,550</end-time>
                <translation>是相当困难的</translation>
                <original>なかなか難しいものがあります</original>
                <spell/>
            </t>
            <t torder="1" vertical="0" id="" hasRuby="0" index="4" time="">
                <start-time>00:00:13,550</start-time>
                <end-time>00:00:16,650</end-time>
                <translation>因为其中有“信心”这一概念</translation>
                <original>なぜならそこには信心</original>
                <spell/>
            </t>
            <t torder="1" vertical="0" id="" hasRuby="0" index="5" time="">
                <start-time>00:00:16,650</start-time>
                <end-time>00:00:18,730</end-time>
                <translation>即相信佛的心
仏を信じる心</translation>
                <original/>
                <spell/>
            </t>
            <t torder="1" vertical="0" id="" hasRuby="0" index="6" time="">
                <start-time>00:00:18,730</start-time>
                <end-time>00:00:20,740</end-time>
                <translation>这个问题横亘在前</translation>
                <original>という問題が立ちはだかるから</original>
                <spell/>
            </t>
            <t torder="1" vertical="0" id="" hasRuby="0" index="7" time="">
                <start-time>00:00:23,300</start-time>
                <end-time>00:00:27,706</end-time>
                <translation>据说即使在亲鸾的时代 围绕对阿弥陀佛的信心</translation>
                <original>親鸞の時代ですら阿弥陀仏への信心をめぐって</original>
                <spell/>
            </t>
            <t torder="1" vertical="0" id="" hasRuby="0" index="8" time="">
                <start-time>00:00:27,706</start-time>
                <end-time>00:00:30,325</end-time>
                <translation>也涌现出了各种各样的想法</translation>
                <original>さまざまな考えが噴出したといいます</original>
                <spell/>
            </t>
            <t torder="1" vertical="0" id="" hasRuby="0" index="9" time="">
                <start-time>00:00:32,650</start-time>
                <end-time>00:00:34,875</end-time>
                <translation>生活在现代的我们</translation>
                <original>現代を生きる私たちは</original>
                <spell/>
            </t>
            <t torder="1" vertical="0" id="" hasRuby="0" index="10" time="">
                <start-time>00:00:34,875</start-time>
                <end-time>00:00:39,340</end-time>
                <translation>应该如何接受这部宗教书呢</translation>
                <original>この宗教書をどのように受け止めることができるのでしょうか</original>
                <spell/>
            </t>
            <t torder="1" vertical="0" id="" hasRuby="0" index="11" time="">
                <start-time>00:00:42,115</start-time>
                <end-time>00:00:44,620</end-time>
                <translation>最后一集将从《叹异抄》出发</translation>
                <original>最終回は歎異抄から</original>
                <spell/>
            </t>
            <t torder="1" vertical="0" id="" hasRuby="0" index="12" time="">
                <start-time>00:00:44,620</start-time>
                <end-time>00:00:47,920</end-time>
                <translation>思考对人类而言宗教是什么</translation>
                <original>人間にとって宗教とは何かを考えます</original>
                <spell/>
            </t>
            <t torder="1" vertical="0" id="" hasRuby="0" index="13" time="">
                <start-time>00:01:11,550</start-time>
                <end-time>00:01:17,225</end-time>
