            <t id="" time="" torder="1" vertical="0" index="446" hasRuby="0">
                <start-time>00:23:33,961</start-time>
                <end-time>00:23:36,820</end-time>
                <translation>自以为好的事情总会变成什么</translation>
                <original>良かれと思ったことが何かなるんだから</original>
