            <t id="" time="" torder="1" vertical="0" index="303" hasRuby="0">
                <start-time>00:17:04,922</start-time>
                <end-time>00:17:08,300</end-time>
                <translation>带着烦恼前往</translation>
                <original>煩悩を抱えたまま行くんだっていうような</original>
