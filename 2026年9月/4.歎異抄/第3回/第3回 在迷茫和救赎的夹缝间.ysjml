            <t id="" time="" torder="1" vertical="0" index="290" hasRuby="0">
                <start-time>00:16:16,505</start-time>
                <end-time>00:16:20,727</end-time>
                <translation>将一切众生纳入光明之中</translation>
                <original>すべての衆生を光明の中に納めとって</original>
