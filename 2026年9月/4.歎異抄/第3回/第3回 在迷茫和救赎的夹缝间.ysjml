            </t>
            <t id="" time="" torder="1" vertical="0" index="301" hasRuby="0">
                <start-time>00:16:57,227</start-time>
                <end-time>00:17:01,647</end-time>
                <translation>真正的念佛是基于他力信心的念佛</translation>
