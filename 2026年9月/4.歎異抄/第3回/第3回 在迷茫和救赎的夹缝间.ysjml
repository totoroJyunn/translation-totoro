            <t id="" time="" torder="1" vertical="0" index="433" hasRuby="0">
                <start-time>00:23:07,634</start-time>
                <end-time>00:23:08,820</end-time>
                <translation>不 那个啊 现在呢</translation>
                <original>いやあれね今ね</original>
