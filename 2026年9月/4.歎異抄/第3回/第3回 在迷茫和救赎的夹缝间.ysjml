            </t>
            <t id="" time="" torder="1" vertical="0" index="298" hasRuby="0">
                <start-time>00:16:48,270</start-time>
                <end-time>00:16:50,716</end-time>
                <translation>不就是出于自己方便的念佛吗</translation>
                <original>自分の都合の念仏じゃないですか</original>
