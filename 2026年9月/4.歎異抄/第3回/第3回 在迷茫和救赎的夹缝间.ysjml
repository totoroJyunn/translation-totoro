            </t>
            <t id="" time="" torder="1" vertical="0" index="350" hasRuby="0">
                <start-time>00:19:39,557</start-time>
                <end-time>00:19:43,155</end-time>
                <translation>这才是它本来的样子</translation>
                <original>というのが本来の姿である</original>
