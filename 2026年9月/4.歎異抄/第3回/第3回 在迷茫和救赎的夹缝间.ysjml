            <t id="" time="" torder="1" vertical="0" index="445" hasRuby="0">
                <start-time>00:23:31,080</start-time>
                <end-time>00:23:33,961</end-time>
                <translation>不过那也是一种缘分啊</translation>
                <original>まあまあそれが縁ですもんね</original>
