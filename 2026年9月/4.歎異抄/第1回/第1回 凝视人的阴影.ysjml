            <t hasRuby="0" index="115" id="" time="" vertical="0" torder="1">
                <start-time>00:07:24,650</start-time>
                <end-time>00:07:28,575</end-time>
                <translation>南无阿弥陀佛 南无阿弥陀佛
南無阿弥陀仏南万弾何万弾</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" index="116" id="" time="" vertical="0" torder="1">
