            <t hasRuby="0" index="145" id="" time="" vertical="0" torder="1">
                <start-time>00:08:50,775</start-time>
                <end-time>00:08:54,080</end-time>
                <translation>把主角和配角对调了</translation>
                <original>主役と脇役を入れ替えちゃうんですね</original>
