            <t hasRuby="0" index="208" id="" time="" vertical="0" torder="1">
                <start-time>00:11:52,150</start-time>
                <end-time>00:11:57,250</end-time>
                <translation>阿弥陀佛便会立刻将我们纳入其高妙之中</translation>
