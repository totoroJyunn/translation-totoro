            <t hasRuby="0" index="139" id="" time="" vertical="0" torder="1">
                <start-time>00:08:34,350</start-time>
                <end-time>00:08:39,275</end-time>
                <translation>对于易行 在早期的佛教中也有所阐述</translation>
