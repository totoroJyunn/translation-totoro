            <t hasRuby="0" index="160" id="" time="" vertical="0" torder="1">
                <start-time>00:09:27,500</start-time>
                <end-time>00:09:29,240</end-time>
                <translation>其实相当多</translation>
                <original>ずいぶんあるんですよ</original>
                <spell/>
            </t>
            <t hasRuby="0" index="161" id="" time="" vertical="0" torder="1">
                <start-time>00:09:29,240</start-time>
                <end-time>00:09:32,675</end-time>
                <translation>不是有“谎言也是方便”这种说法吗</translation>
