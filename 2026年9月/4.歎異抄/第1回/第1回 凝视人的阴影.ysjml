            <t hasRuby="0" index="113" id="" time="" vertical="0" torder="1">
                <start-time>00:07:14,975</start-time>
                <end-time>00:07:17,525</end-time>
                <translation>请称念阿弥陀佛名号
阿弥陀仏の名を唱えなさい</translation>
