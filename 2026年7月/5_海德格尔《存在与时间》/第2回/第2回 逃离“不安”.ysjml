            <t torder="1" time="" id="" index="241" hasRuby="0" vertical="0">
                <start-time>00:11:37,906</start-time>
                <end-time>00:11:40,230</end-time>
                <translation>所以 即使有人说自己并非察言观色才这么做</translation>
