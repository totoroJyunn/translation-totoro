                </marks>
                <start-time>00:12:15,913</start-time>
                <end-time>00:12:19,816</end-time>
                <translation>“人”总是试图将世人作为例子</translation>
                <original>人はいつも世人を引き合いに出そうとするが</original>
                <spell/>
            </t>
            <t torder="1" time="" id="" index="253" hasRuby="0" vertical="0">
                <marks>
