                </marks>
                <start-time>00:11:52,840</start-time>
                <end-time>00:11:55,264</end-time>
                <translation>世人在任何地方</translation>
                <original>世人はどこにでもいる</original>
                <spell/>
            </t>
            <t torder="1" time="" id="" index="247" hasRuby="0" vertical="0">
                <marks>
