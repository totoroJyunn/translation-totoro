                <original>自分を規定しているということを意味しています</original>
                <spell/>
            </t>
            <t torder="1" time="" id="" index="38" hasRuby="0" vertical="0">
                <start-time>00:02:20,440</start-time>
                <end-time>00:02:23,520</end-time>
                <translation>对于这种会将非我们自身的事物</translation>
                <original>でこうしたですね 自分ではないものを</original>
                <spell/>
            </t>
            <t torder="1" time="" id="" index="39" hasRuby="0" vertical="0">
                <start-time>00:02:23,520</start-time>
                <end-time>00:02:25,468</end-time>
