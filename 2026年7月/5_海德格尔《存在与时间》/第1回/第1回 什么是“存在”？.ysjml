            </t>
            <t torder="1" time="" id="" index="8" hasRuby="0" vertical="0">
                <marks>
                    <mark top="默认标记">默认标记</mark>
                </marks>
                <start-time>00:00:28,340</start-time>
                <end-time>00:00:30,182</end-time>
                <translation>有必要换一种新的提问方式了</translation>
                <original>新たに設定する必要がある</original>
                <spell/>
            </t>
            <t torder="1" time="" id="" index="9" hasRuby="0" vertical="0">
                <start-time>00:00:30,182</start-time>
                <end-time>00:00:32,090</end-time>
