                <spell/>
            </t>
            <t torder="1" time="" id="" index="3" hasRuby="0" vertical="0">
                <start-time>00:00:10,695</start-time>
                <end-time>00:00:12,740</end-time>
                <translation>在20世纪的德国</translation>
                <original>二十世紀のドイツで</original>
