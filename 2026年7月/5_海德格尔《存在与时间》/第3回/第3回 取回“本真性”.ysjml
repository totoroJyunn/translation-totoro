                <original/>
                <spell/>
            </t>
            <t index="328" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:16:16,680</start-time>
                <end-time>00:16:18,120</end-time>
                <translation>这个先驱与决意性
この先駆と決意性</translation>
                <original/>
