            <t index="338" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:16:47,625</start-time>
                <end-time>00:16:49,175</end-time>
                <translation>这样一来 此在</translation>
                <original>こうして現存在は</original>
                <spell/>
            </t>
            <t index="339" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:16:49,175</start-time>
                <end-time>00:16:53,925</end-time>
