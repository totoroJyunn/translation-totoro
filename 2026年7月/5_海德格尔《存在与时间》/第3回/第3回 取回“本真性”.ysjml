            </t>
            <t index="235" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:11:39,008</start-time>
                <end-time>00:11:40,900</end-time>
                <translation>并不会用言语告诉我们什么 </translation>
                <original>語ってくれるわけではなくて</original>
                <spell/>
            </t>
            <t index="236" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:11:40,900</start-time>
                <end-time>00:11:44,025</end-time>
                <translation>仅仅是一种唤醒人的声音</translation>
