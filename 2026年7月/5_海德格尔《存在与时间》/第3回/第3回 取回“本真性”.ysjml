            <t index="330" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:16:20,320</start-time>
                <end-time>00:16:22,160</end-time>
                <translation>为什么必须要一体呢？</translation>
                <original>作用しなければならない理由を</original>
                <spell/>
            </t>
            <t index="331" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:16:22,160</start-time>
                <end-time>00:16:24,120</end-time>
                <translation>他将对此进行说明</translation>
