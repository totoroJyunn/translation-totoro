                <spell/>
            </t>
            <t index="346" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:17:19,250</start-time>
                <end-time>00:17:22,620</end-time>
                <translation>所谓本真的向死存在</translation>
                <original>本来的な死への思いというものは</original>
                <spell/>
            </t>
            <t index="347" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:17:22,620</start-time>
                <end-time>00:17:26,050</end-time>
                <translation>是生存上变得能够看透自身的</translation>
                <original>実存的に自らを見通すようになった</original>
