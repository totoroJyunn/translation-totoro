        <part lastModifyTime="0" updateMethod="0">
            <t index="1" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:00:01,325</start-time>
                <end-time>00:00:03,680</end-time>
                <translation>作为此在之终结的死亡</translation>
                <original>現存在の終わりとしての死は</original>
                <spell/>
            </t>
            <t index="2" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:00:03,680</start-time>
                <end-time>00:00:07,525</end-time>
                <translation>是一种无法被超越的可能性</translation>
                <original>追い越すことのできない可能性である</original>
                <spell/>
            </t>
            <t index="3" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:00:07,525</start-time>
                <end-time>00:00:12,075</end-time>
                <translation>察言观色 与周围人保持一致地生活</translation>
                <original>空気を読み 周囲と同調して生きているため</original>
                <spell/>
            </t>
            <t index="4" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:00:12,075</start-time>
                <end-time>00:00:17,400</end-time>
                <translation>人便变得可以轻易相互替换</translation>
                <original>誰もが交換可能になってしまいがちな人間</original>
                <spell/>
            </t>
            <t index="5" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:00:17,400</start-time>
                <end-time>00:00:21,525</end-time>
                <translation>但唯有一件事是无法替换的</translation>
                <original>しかし一つだけ交換ができないものがあります</original>
                <spell/>
            </t>
            <t index="6" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:00:21,525</start-time>
                <end-time>00:00:24,275</end-time>
                <translation>那就是自己的死亡</translation>
                <original>それは自分の死</original>
                <spell/>
            </t>
            <t index="7" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:00:24,275</start-time>
                <end-time>00:00:26,703</end-time>
                <translation>对于自己迄今为止的人生</translation>
                <original>これまでの自分の人生に対しても</original>
                <spell/>
            </t>
            <t index="8" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:00:26,703</start-time>
                <end-time>00:00:28,400</end-time>
                <translation>一旦开始承担起责任</translation>
                <original>責任を引き受けるようになると</original>
                <spell/>
            </t>
            <t index="9" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:00:28,400</start-time>
                <end-time>00:00:32,300</end-time>
                <translation>我本以为这会聊成个多么沉重的话题啊</translation>
                <original>どんなどんよりとした話になるんだろうと思ったんですけど</original>
                <spell/>
            </t>
            <t index="10" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:00:32,300</start-time>
                <end-time>00:00:35,025</end-time>
                <translation>但听了却有些豁然开朗</translation>
                <original>ちょっと晴れやかな気持ちになっているし</original>
                <spell/>
            </t>
            <t index="11" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:00:35,025</start-time>
                <end-time>00:00:39,850</end-time>
                <translation>第3回将以海德格尔所阐释的死亡概念为入口</translation>
                <original>第3回はハイデガーの解いた死の概念を入り口に</original>
                <spell/>
            </t>
            <t index="12" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:00:39,850</start-time>
                <end-time>00:00:43,900</end-time>
                <translation>思考活出自我需要什么</translation>
                <original>自分らしく生きるには何が必要なのか考えます</original>
                <spell/>
            </t>
            <t index="13" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:01:05,876</start-time>
                <end-time>00:01:11,275</end-time>
                <translation>第3回 取回“本真性”
第3回　「本来性」を取り戻す</translation>
                <original/>
                <spell/>
            </t>
            <t index="14" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:01:12,370</start-time>
                <end-time>00:01:15,050</end-time>
                <translation>《100分de名著》主持人安部美智子
100分で名著司会の安部みちこです</translation>
                <original/>
                <spell/>
            </t>
            <t index="15" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:01:15,050</start-time>
                <end-time>00:01:16,280</end-time>
                <translation>伊集院光
伊集院光です</translation>
                <original/>
                <spell/>
            </t>
            <t index="16" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:01:16,280</start-time>
                <end-time>00:01:18,950</end-time>
                <translation>本月正在阅读海德格尔的《存在与时间》</translation>
                <original>ハイデガーの存在と時間を読んでいます</original>
                <spell/>
            </t>
            <t index="17" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:01:18,950</start-time>
                <end-time>00:01:21,291</end-time>
                <translation>上回我们学习了为了逃避不安</translation>
                <original>前回は不安から逃れるために</original>
                <spell/>
            </t>
            <t index="18" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:01:21,291</start-time>
                <end-time>00:01:25,150</end-time>
                <translation>而持续与他人保持一致的人 这种存在</translation>
                <original>みんなと同調し続ける人間という存在について学びました</original>
                <spell/>
            </t>
            <t index="19" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:01:25,150</start-time>
                <end-time>00:01:26,675</end-time>
                <translation>-是叫“世人（世人）”吧 -对的 世人</translation>
                <original>-世人でしたっけ　-ええ世人</original>
                <spell/>
            </t>
            <t index="20" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:01:26,675</start-time>
                <end-time>00:01:29,550</end-time>
                <translation>简单来说就是察言观色
空気を読む簡単に言うと</translation>
                <original/>
                <spell/>
            </t>
            <t index="21" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:01:29,550</start-time>
                <end-time>00:01:33,525</end-time>
                <translation>在意周围人的看法 不负责任地随波逐流</translation>
                <original>周りはどう思うのみたいに無責任についていっちゃう</original>
                <spell/>
            </t>
            <t index="22" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:01:33,525</start-time>
                <end-time>00:01:35,450</end-time>
                <translation>大概学到了这里呢</translation>
                <original>ここぐらいまでは来ましたね</original>
                <spell/>
            </t>
            <t index="23" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:01:35,450</start-time>
                <end-time>00:01:36,975</end-time>
                <translation>请让我介绍一下我们的导读</translation>
                <original>指南役ご紹介しましょう</original>
                <spell/>
            </t>
            <t index="24" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:01:36,975</start-time>
                <end-time>00:01:38,675</end-time>
                <translation>哲学家户谷洋志先生
哲学者の戸谷洋志さんです</translation>
                <original/>
                <spell/>
            </t>
            <t index="25" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:01:38,675</start-time>
                <end-time>00:01:40,975</end-time>
                <translation>请多关照</translation>
                <original>よろしくお願いします</original>
                <spell/>
            </t>
            <t index="26" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:01:40,975</start-time>
                <end-time>00:01:45,275</end-time>
                <translation>人无论如何都容易被“世人” 也就是所谓的“氛围”所吞噬</translation>
                <original>どうしても人間は世人といういわゆる空気に飲み込まれて</original>
                <spell/>
            </t>
            <t index="27" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:01:45,275</start-time>
                <end-time>00:01:46,750</end-time>
                <translation>容易变得不负责任</translation>
                <original>無責任になりがちだという</original>
                <spell/>
            </t>
            <t index="28" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:01:46,750</start-time>
                <end-time>00:01:48,450</end-time>
                <translation>我们学到了这部分</translation>
                <original>ところまで学んだんですけれども</original>
                <spell/>
            </t>
            <t index="29" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:01:48,450</start-time>
                <end-time>00:01:51,355</end-time>
                <translation>那么 所谓负责任地活下去</translation>
                <original>じゃあ責任を取って生きていくというのは</original>
                <spell/>
            </t>
            <t index="30" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:01:51,355</start-time>
                <end-time>00:01:53,120</end-time>
                <translation>那要怎样才能做到呢？</translation>
                <original>どうしたらできると考えているんでしょうか</original>
                <spell/>
            </t>
            <t index="31" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:01:53,120</start-time>
                <end-time>00:01:56,500</end-time>
                <translation>海德格尔给出了两个关键词</translation>
                <original>ハイデガーは2つのキーワードを示しています</original>
                <spell/>
            </t>
            <t index="32" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:01:56,500</start-time>
                <end-time>00:01:57,728</end-time>
                <translation>首先是第一个</translation>
                <original>まず1つ目は</original>
                <spell/>
            </t>
            <t index="33" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:01:57,728</start-time>
                <end-time>00:02:01,225</end-time>
                <translation>就是上次最后预告过的“死亡”</translation>
                <original>前回最後に予告した死というものですね</original>
                <spell/>
            </t>
            <t index="34" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:02:01,225</start-time>
                <end-time>00:02:03,600</end-time>
                <translation>真是个冲击性的预告啊
衝撃的な予告編ですよ</translation>
                <original/>
                <spell/>
            </t>
            <t index="35" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:02:03,600</start-time>
                <end-time>00:02:06,050</end-time>
                <translation>“诶 要讲死亡吗？”</translation>
                <original>ええ死なのっていう</original>
                <spell/>
            </t>
            <t index="36" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:02:06,050</start-time>
                <end-time>00:02:08,350</end-time>
                <translation>海德格尔这样写道</translation>
                <original>ハイデガーはこう書いています</original>
                <spell/>
            </t>
            <t index="37" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:02:08,350</start-time>
                <end-time>00:02:10,040</end-time>
                <translation>任何人都无法从他人那里
誰も他人から</translation>
                <original/>
                <spell/>
            </t>
            <t index="38" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:02:10,040</start-time>
                <end-time>00:02:14,125</end-time>
                <translation>替他把他的死亡承担下来</translation>
                <original>その人が死ぬことを引き受けてやることはできない</original>
                <spell/>
            </t>
            <t index="39" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:02:14,125</start-time>
                <end-time>00:02:16,360</end-time>
                <translation>被“世人”所支配的“此在”
世人に支配されている現存在</translation>
                <original/>
                <spell/>
            </t>
            <t index="40" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:02:16,360</start-time>
                <end-time>00:02:19,580</end-time>
                <translation>也就是说 人总是察言观色地活着</translation>
                <original>つまり人間は誰もが空気を読んで生きているので</original>
                <spell/>
            </t>
            <t index="41" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:02:19,580</start-time>
                <end-time>00:02:22,052</end-time>
                <translation>做着那些谁来做都无所谓的事情</translation>
                <original>誰がやっても構わないようなことをして</original>
                <spell/>
            </t>
            <t index="42" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:02:22,052</start-time>
                <end-time>00:02:23,575</end-time>
                <translation>就这样活着</translation>
                <original>生きているわけなんですが</original>
                <spell/>
            </t>
            <t index="43" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:02:23,575</start-time>
                <end-time>00:02:26,023</end-time>
                <translation>但这种可替代性
そうした交換可能性を</translation>
                <original/>
                <spell/>
            </t>
            <t index="44" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:02:26,023</start-time>
                <end-time>00:02:28,475</end-time>
                <translation>在死亡这件事上 是无法实现的</translation>
                <original>死に関しては行うことができないのであると</original>
                <spell/>
            </t>
            <t index="45" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:02:28,475</start-time>
                <end-time>00:02:30,700</end-time>
                <translation>因此 正是死亡</translation>
                <original>したがって死こそがですね</original>
                <spell/>
            </t>
            <t index="46" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:02:30,700</start-time>
                <end-time>00:02:35,775</end-time>
                <translation>海德格尔认为 是“此在”最本己的可能性</translation>
                <original>現存在にとって最も固有な可能性であるとハイデガーは考えました</original>
                <spell/>
            </t>
            <t index="47" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:02:35,775</start-time>
                <end-time>00:02:39,925</end-time>
                <translation>而能承担起自己独有的责任的生活方式</translation>
                <original>ここから自分独自の責任を引き受ける生き方は</original>
                <spell/>
            </t>
            <t index="48" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:02:39,925</start-time>
                <end-time>00:02:43,800</end-time>
                <translation>只有通过死亡才能找到 便是他的主张</translation>
                <original>死を通じてこそ見つけられると彼は訴えたわけです</original>
                <spell/>
            </t>
            <t index="49" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:02:43,800</start-time>
                <end-time>00:02:46,950</end-time>
                <translation>确实 我的死亡只属于我自己</translation>
                <original>確かに僕の死はもう僕のもんですよね</original>
                <spell/>
            </t>
            <t index="50" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:02:46,950</start-time>
                <end-time>00:02:49,475</end-time>
                <translation>除了我 没人能体验</translation>
                <original>僕以外に経験できないし</original>
                <spell/>
            </t>
            <t index="51" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:02:49,475</start-time>
                <end-time>00:02:51,020</end-time>
                <translation>要想到这种程度么？</translation>
