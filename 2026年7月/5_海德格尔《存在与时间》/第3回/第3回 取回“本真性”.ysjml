            </t>
            <t index="237" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:11:44,025</start-time>
                <end-time>00:11:45,381</end-time>
                <translation>“当初这么做就好了哦”</translation>
                <original>こうすればよかったんだよ</original>
