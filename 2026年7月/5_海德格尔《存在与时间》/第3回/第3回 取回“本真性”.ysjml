                <spell/>
            </t>
            <t index="332" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:16:26,645</start-time>
                <end-time>00:16:28,300</end-time>
                <translation>死亡的无规定性
死の無規定性は</translation>
