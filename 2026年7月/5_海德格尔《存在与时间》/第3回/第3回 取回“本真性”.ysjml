            </t>
            <t index="234" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:11:36,775</start-time>
                <end-time>00:11:39,008</end-time>
                <translation>它并不会告诉我们什么具体的线索</translation>
