            <t index="307" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:15:24,825</start-time>
                <end-time>00:15:27,150</end-time>
                <translation>我们将其称为决意性</translation>
                <original>それを決意性と呼ぼうと</original>
