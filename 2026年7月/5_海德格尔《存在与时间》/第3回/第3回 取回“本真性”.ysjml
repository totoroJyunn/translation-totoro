                <original/>
                <spell/>
            </t>
            <t index="361" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:18:09,625</start-time>
                <end-time>00:18:12,902</end-time>
                <translation>而这 据说是为了探寻活出自我的生活方式</translation>
                <original>でこれが自分らしい生き方を探るための</original>
                <spell/>
            </t>
            <t index="362" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:18:12,902</start-time>
                <end-time>00:18:14,775</end-time>
                <translation>人类应有的存在方式</translation>
                <original>人間のあり方だというのですが</original>
                <spell/>
            </t>
            <t index="363" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:18:14,775</start-time>
                <end-time>00:18:17,780</end-time>
                <translation>那么 海德格尔所说的活出自我的生活方式</translation>
