            </t>
            <t index="239" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:11:46,900</start-time>
                <end-time>00:11:48,980</end-time>
                <translation>怎么说呢 那种心里一紧的感觉吗</translation>
                <original>何だろうざわって感じなのかな</original>
                <spell/>
            </t>
            <t index="240" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:11:48,980</start-time>
                <end-time>00:11:51,755</end-time>
                <translation>是现在这样假装没看见</translation>
