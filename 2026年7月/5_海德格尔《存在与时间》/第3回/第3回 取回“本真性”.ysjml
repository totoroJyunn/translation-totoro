            </t>
            <t index="329" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:16:18,120</start-time>
                <end-time>00:16:20,320</end-time>
                <translation>为何两者必须始终一体地发挥作用</translation>
