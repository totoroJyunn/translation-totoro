            </t>
            <t index="229" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:11:23,140</start-time>
                <end-time>00:11:25,700</end-time>
                <translation>就是良心的呼唤</translation>
                <original>良心の呼び声であるということです</original>
