                <original/>
                <spell/>
            </t>
            <t index="360" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:18:07,375</start-time>
                <end-time>00:18:09,625</end-time>
                <translation>称为先驱式的决意性
