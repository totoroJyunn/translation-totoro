                <end-time>00:18:14,800</end-time>
                <translation>那他们发现了这类情景</translation>
                <original>こういうものを見つけちゃったり</original>
                <spell/>
            </t>
            <t index="302" time="" vertical="0" id="" hasRuby="0" torder="1">
