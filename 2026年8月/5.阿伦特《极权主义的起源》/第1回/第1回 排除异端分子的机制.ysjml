        <part updateMethod="0" lastModifyTime="0">
            <t index="1" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:00:01,150</start-time>
                <end-time>00:00:04,660</end-time>
                <translation>2017年1月 在美国</translation>
                <original>2017年1月アメリカで</original>
                <spell/>
            </t>
            <t index="2" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:00:04,720</start-time>
                <end-time>00:00:07,820</end-time>
                <translation>一本写于60多年前的书</translation>
                <original>今から60年以上も前に書かれた本が</original>
                <spell/>
            </t>
            <t index="3" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:00:07,870</start-time>
                <end-time>00:00:09,480</end-time>
                <translation>成了畅销书</translation>
                <original>ベストセラーとなりました</original>
                <spell/>
            </t>
            <t index="4" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:00:11,640</start-time>
                <end-time>00:00:15,030</end-time>
                <translation>这是政治哲学家汉娜·阿伦特所著</translation>
                <original>政治哲学者ハンナアーレントが著した</original>
                <spell/>
            </t>
            <t index="5" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:00:15,380</start-time>
                <end-time>00:00:17,410</end-time>
                <translation>《极权主义的起源》
全体主義の起源です</translation>
                <original/>
                <spell/>
            </t>
            <t index="6" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:00:19,650</start-time>
                <end-time>00:00:21,460</end-time>
                <translation>为逃避纳粹迫害</translation>
                <original>ナチスの迫害を逃れ</original>
                <spell/>
            </t>
            <t index="7" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:00:21,560</start-time>
                <end-time>00:00:25,260</end-time>
                <translation>流亡美国的犹太裔德国人阿伦特</translation>
                <original>アメリカに亡命したユダヤ系ドイツ人アーレントは</original>
                <spell/>
            </t>
            <t index="8" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:00:25,660</start-time>
                <end-time>00:00:29,480</end-time>
                <translation>试图探究极权主义是如何诞生的</translation>
                <original>全体主義がどのように生まれたのかを探ろうとしました</original>
                <spell/>
            </t>
            <t index="9" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:00:32,120</start-time>
                <end-time>00:00:36,590</end-time>
                <translation>“追求简单易懂政治的大众催生了极权主义”</translation>
                <original>分かり易い政治を求める大衆が全体主義をもたらす</original>
                <spell/>
            </t>
            <t index="10" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:00:37,450</start-time>
                <end-time>00:00:41,410</end-time>
                <translation>阿伦特的这一主张如今再次受到关注</translation>
                <original>アーレントの主張は今再び注目を浴びています</original>
                <spell/>
            </t>
            <t index="11" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:00:43,730</start-time>
                <end-time>00:00:45,000</end-time>
                <translation>本期100分de名著</translation>
                <original>100分de名著</original>
                <spell/>
            </t>
            <t index="12" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:00:45,660</start-time>
                <end-time>00:00:50,200</end-time>
                <translation>将逼近潜藏于现代社会中的极权主义危机</translation>
                <original>現代社会にも潜む全体主義の危機に迫っていきます</original>
                <spell/>
            </t>
            <t index="13" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:01:11,660</start-time>
                <end-time>00:01:16,940</end-time>
                <translation>第1回 排除异己的机制</translation>
                <original>第1回　異分子排除のメカニズム</original>
                <spell/>
            </t>
            <t index="14" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:01:18,240</start-time>
                <end-time>00:01:20,600</end-time>
                <translation>《100分de名著》 主持人岛津有理子
100分で名著司会の島津有理子ですです</translation>
                <original/>
                <spell/>
            </t>
            <t index="15" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:01:20,600</start-time>
                <end-time>00:01:22,230</end-time>
                <translation>伊集院光</translation>
                <original>伊集院光です</original>
                <spell/>
            </t>
            <t index="16" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:01:22,230</start-time>
                <end-time>00:01:24,620</end-time>
                <translation>本次介绍的名著是这本
今回紹介する名著はこちら</translation>
                <original/>
                <spell/>
            </t>
            <t index="17" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:01:24,910</start-time>
                <end-time>00:01:28,220</end-time>
                <translation>汉娜·阿伦特的《极权主义的起源》</translation>
                <original>ハンナアレントの全体主義の起源です</original>
                <spell/>
            </t>
            <t index="18" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:01:28,350</start-time>
                <end-time>00:01:30,960</end-time>
                <translation>“极权主义”这个词本身
全体主義っていう言葉自体は</translation>
                <original/>
                <spell/>
            </t>
            <t index="19" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:01:30,970</start-time>
                <end-time>00:01:34,020</end-time>
                <translation>真是自打特朗普当选总统前后</translation>
                <original>それこそ トランプ、大統領誕生あたり</original>
                <spell/>
            </t>
            <t index="20" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:01:34,020</start-time>
                <end-time>00:01:35,400</end-time>
                <translation>开始被频繁提及</translation>
                <original>から聞かれるようになったんですけど、この</original>
                <spell/>
            </t>
            <t index="21" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:01:35,400</start-time>
                <end-time>00:01:38,720</end-time>
                <translation>但对这本书本身我倒没什么了解</translation>
                <original>本自体はちょっと知識がないですね</original>
                <spell/>
            </t>
            <t index="22" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:01:38,790</start-time>
                <end-time>00:01:40,200</end-time>
                <translation>我之前也不知道</translation>
                <original>私も知りませんでした</original>
                <spell/>
            </t>
            <t index="23" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:01:40,390</start-time>
                <end-time>00:01:42,450</end-time>
                <translation>这本书写于二战刚结束后</translation>
                <original>これ第2次大戦直後に描かれまして</original>
                <spell/>
            </t>
            <t index="24" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:01:42,450</start-time>
                <end-time>00:01:46,880</end-time>
                <translation>是使阿伦特闻名世界的一部政治哲学著作</translation>
                <original>アーレントの名を世界的に知らしめることになった政治哲学書なんですが</original>
                <spell/>
            </t>
            <t index="25" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:01:46,880</start-time>
                <end-time>00:01:50,620</end-time>
                <translation>如今再次受到关注了呢</translation>
                <original>今また注目を集めているということなんですよね</original>
                <spell/>
            </t>
            <t index="26" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:01:51,010</start-time>
                <end-time>00:01:54,800</end-time>
                <translation>我听说在美国 今年年初似乎卖得相当好</translation>
                <original>アメリカでは年の初めに相当売れたみたいな話</original>
                <spell/>
            </t>
            <t index="27" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:01:54,810</start-time>
                <end-time>00:01:55,520</end-time>
                <translation>有所耳闻</translation>
                <original>は聞きました</original>
                <spell/>
            </t>
            <t index="28" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:01:55,530</start-time>
                <end-time>00:01:57,060</end-time>
                <translation>好的 那么</translation>
                <original>はい、それでは</original>
                <spell/>
            </t>
            <t index="29" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:01:57,300</start-time>
                <end-time>00:01:59,000</end-time>
                <translation>让我们来介绍一下主讲老师</translation>
                <original>指南役の老师をご紹介しましょう</original>
                <spell/>
            </t>
            <t index="30" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:01:59,030</start-time>
                <end-time>00:02:02,060</end-time>
                <translation>金泽大学教授仲正昌树老师
金沢大学教授の仲正昌樹さんです</translation>
                <original/>
                <spell/>
            </t>
            <t index="31" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:02:02,980</start-time>
                <end-time>00:02:05,770</end-time>
                <translation>老师好 请多关照</translation>
                <original>こんにちはよろしくお願いいたします</original>
                <spell/>
            </t>
            <t index="32" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:02:08,370</start-time>
                <end-time>00:02:10,580</end-time>
                <translation>哲学家仲正昌树老师
哲学者の仲間昌樹さん</translation>
                <original/>
                <spell/>
            </t>
            <t index="33" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:02:11,990</start-time>
                <end-time>00:02:15,500</end-time>
                <translation>他在研究政治思想史和社会哲学的过程中
政治思想史、社会哲学を研究する中</translation>
                <original/>
                <spell/>
            </t>
            <t index="34" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:02:15,500</start-time>
                <end-time>00:02:18,860</end-time>
                <translation>关注阿伦特的思想</translation>
                <original>アーレントの思想に注目</original>
                <spell/>
            </t>
            <t index="35" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:02:18,860</start-time>
                <end-time>00:02:22,510</end-time>
                <translation>认为正因为是难以预见未来的不安的现代</translation>
                <original>未来が見通せない不安な現代であるからこそ</original>
                <spell/>
            </t>
            <t index="36" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:02:22,510</start-time>
                <end-time>00:02:25,960</end-time>
                <translation>当下才更有必要重读它</translation>
                <original>今その読み直しが必要なのだと、いいます</original>
                <spell/>
            </t>
            <t index="37" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:02:28,320</start-time>
                <end-time>00:02:31,650</end-time>
                <translation>首先来看看《极权主义的起源》的基本信息吧
まずは全体主義の起源の基本情報を見て行きましょう</translation>
                <original/>
                <spell/>
            </t>
            <t index="38" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:02:31,800</start-time>
                <end-time>00:02:36,030</end-time>
                <translation>《极权主义的起源》出版于1951年
全体主義の起源は1951年に出版されました</translation>
                <original/>
                <spell/>
            </t>
            <t index="39" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:02:36,200</start-time>
                <end-time>00:02:39,140</end-time>
                <translation>作者是德国出身的政治哲学家
著者はドイツ出身の政治哲学者</translation>
                <original/>
                <spell/>
            </t>
            <t index="40" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:02:39,170</start-time>
                <end-time>00:02:41,640</end-time>
                <translation>思想家汉娜·阿伦特</translation>
                <original>思想家のハンナアーレントです</original>
                <spell/>
            </t>
            <t index="41" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:02:41,640</start-time>
                <end-time>00:02:43,480</end-time>
                <translation>她在考察历史的同时
歴史的考察を加えながら</translation>
                <original/>
                <spell/>
            </t>
            <t index="42" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:02:43,480</start-time>
                <end-time>00:02:46,070</end-time>
                <translation>提出了“极权主义是什么？”这一问题</translation>
                <original>全体主義とは何かという問題を提起し</original>
                <spell/>
            </t>
            <t index="43" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:02:46,070</start-time>
                <end-time>00:02:49,650</end-time>
                <translation>作为政治哲学家闻名世界</translation>
                <original>政治哲学者として世界に名前を知られるようになりました</original>
                <spell/>
            </t>
            <t index="44" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:02:50,370</start-time>
                <end-time>00:02:54,450</end-time>
                <translation>仲正老师 是阿伦特推广了“极权主义”这个词</translation>
                <original>仲間さん、このアーレントが全体主義という言葉を広めた</original>
                <spell/>
            </t>
            <t index="45" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:02:54,480</start-time>
                <end-time>00:02:56,180</end-time>
                <translation>可以这样认为吗？</translation>
                <original>と思って良いんでしょうかね</original>
                <spell/>
            </t>
            <t index="46" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:02:56,190</start-time>
                <end-time>00:02:59,320</end-time>
                <translation>嗯…最早开始使用极权主义这个词的</translation>
                <original>あの全体主義という言葉を最初に使い始めたのは、おそらくイタリアの</original>
                <spell/>
            </t>
            <t index="47" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:02:59,320</start-time>
                <end-time>00:03:02,100</end-time>
                <translation>大概是意大利的法西斯政权 以及</translation>
                <original>ファシズム政権だとか</original>
                <spell/>
            </t>
            <t index="48" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:03:02,170</start-time>
                <end-time>00:03:05,150</end-time>
                <translation>德国纳粹相关的知识分子们</translation>
                <original>ドイツのナチス関係の知識人たち</original>
                <spell/>
            </t>
            <t index="49" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:03:05,180</start-time>
                <end-time>00:03:07,820</end-time>
                <translation>所以这个词早先 反而是他们自己的</translation>
                <original>で、どちらかというと、自分たちのポジション</original>
                <spell/>
            </t>
            <t index="50" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:03:07,880</start-time>
                <end-time>00:03:10,900</end-time>
                <translation>用于积极地表达自己的立场和体制的词语</translation>
                <original>体制のことをポジティブに表現する言葉だったんですけど、それを</original>
                <spell/>
            </t>
            <t index="51" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:03:10,840</start-time>
                <end-time>00:03:13,850</end-time>
                <translation>而位于德意的西侧人们则将其反过来</translation>
                <original>西側の人たちはむしろあの彼らの</original>
                <spell/>
            </t>
            <t index="52" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:03:13,860</start-time>
                <end-time>00:03:17,810</end-time>
                <translation>作为表达他们体制异常的词语来使用了</translation>
                <original>体制の異様さを表す言葉として使用するようになって</original>
                <spell/>
            </t>
            <t index="53" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:03:17,840</start-time>
                <end-time>00:03:20,150</end-time>
                <translation>那么到底哪里不同呢</translation>
                <original>じゃあどこがどう違っていて</original>
                <spell/>
            </t>
            <t index="54" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:03:20,180</start-time>
                <end-time>00:03:22,240</end-time>
                <translation>他们德国和意大利人原本也应该是欧洲人</translation>
                <original>彼らも、もともとヨーロッパ人のはずなのに</original>
                <spell/>
            </t>
            <t index="55" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:03:22,240</start-time>
                <end-time>00:03:25,020</end-time>
                <translation>却不知从何时开始有了不同的部分</translation>
                <original>どこでこう違ったもんできちゃったんだろうと</original>
                <spell/>
            </t>
            <t index="56" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:03:25,020</start-time>
                <end-time>00:03:27,180</end-time>
                <translation>我想当时很多人都有这样的疑问</translation>
                <original>そういう疑問を持ってた人多かったと思うんですね</original>
                <spell/>
            </t>
            <t index="57" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:03:27,180</start-time>
                <end-time>00:03:28,760</end-time>
                <translation>在这样的状况中她分析了</translation>
                <original>そういう状況の中で</original>
                <spell/>
            </t>
            <t index="58" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:03:28,760</start-time>
                <end-time>00:03:32,950</end-time>
                <translation>极权主义是如何开花结果的？</translation>
                <original>この全体主義っていうのがどうやってこう結実していたかと</original>
                <spell/>
            </t>
            <t index="59" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:03:32,950</start-time>
                <end-time>00:03:34,420</end-time>
                <translation>主张这不是外在原因导致</translation>
                <original>人ごとではなくて</original>
                <spell/>
            </t>
            <t index="60" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:03:34,420</start-time>
                <end-time>00:03:37,130</end-time>
                <translation>而是内在于他们自己文化中的问题</translation>
                <original>自分たちの文化の中に内在している問題だという</original>
                <spell/>
            </t>
            <t index="61" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:03:37,130</start-time>
                <end-time>00:03:40,230</end-time>
                <translation>她广泛地让人意识到了这一点</translation>
                <original>事を、あの広く意識させたと</original>
                <spell/>
            </t>
            <t index="62" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:03:40,230</start-time>
                <end-time>00:03:43,540</end-time>
                <translation>可能真的是我太无知了 非常抱歉</translation>
                <original>なんかもう無知も無知な話で 大変申し訳ないんですけど</original>
                <spell/>
            </t>
            <t index="63" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:03:43,540</start-time>
                <end-time>00:03:46,590</end-time>
                <translation>其实我最近才知道这个词</translation>
                <original>それこそ僕がこの言葉を知ったのは最近で</original>
                <spell/>
            </t>
            <t index="64" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:03:46,600</start-time>
                <end-time>00:03:49,360</end-time>
                <translation>觉得就是说以特朗普总统为首</translation>
                <original>それこそトランプ、大統領をはじめとして</original>
                <spell/>
            </t>
            <t index="65" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:03:49,360</start-time>
                <end-time>00:03:52,080</end-time>
                <translation>给人有点极权主义氛围</translation>
                <original>ちょっと全体主義的な空気が流れてる</original>
                <spell/>
            </t>
            <t index="66" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:03:52,080</start-time>
                <end-time>00:03:54,140</end-time>
                <translation>我是通过这个现实状况了解到这个词的</translation>
                <original>みたいな比喩で聞いたんですが</original>
                <spell/>
            </t>
            <t index="67" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:03:54,140</start-time>
                <end-time>00:03:56,800</end-time>
                <translation>当时我呢 听到“极权主义”时</translation>
                <original>その時に全体主義</original>
                <spell/>
            </t>
            <t index="68" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:03:56,800</start-time>
                <end-time>00:03:59,580</end-time>
                <translation>在完全不了解前因后果的情况下听到这个词
っていう言葉だけ全く無知な状態で聞くと</translation>
                <original/>
                <spell/>
            </t>
            <t index="69" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:03:59,610</start-time>
                <end-time>00:04:01,620</end-time>
                <translation>的确会觉得比起个人主义之类的 </translation>
                <original>個人主義みたいなことより</original>
                <spell/>
            </t>
            <t index="70" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:04:01,620</start-time>
                <end-time>00:04:03,580</end-time>
                <translation>这多少听起来像是个好词</translation>
                <original>良い言葉になんとなく聞こえたんです</original>
                <spell/>
            </t>
            <t index="71" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:04:03,580</start-time>
                <end-time>00:04:06,240</end-time>
                <translation>但是现在听了老师所说的</translation>
                <original>でも老师今がおっしゃるのを聞いて</original>
                <spell/>
            </t>
            <t index="72" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:04:06,240</start-time>
                <end-time>00:04:09,840</end-time>
                <translation>虽然它最初并不是什么坏方向的词
最初は別に悪い方向性の言葉でもなく</translation>
                <original/>
                <spell/>
            </t>
            <t index="73" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:04:09,840</start-time>
                <end-time>00:04:11,220</end-time>
                <translation>确实是有这样的初衷</translation>
                <original>発生はしてるわけですよ</original>
                <spell/>
            </t>
            <t index="74" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:04:11,220</start-time>
                <end-time>00:04:14,060</end-time>
                <translation>是的 想要与国家融为一体的欲望</translation>
                <original>そうです国家と一体化したいという欲求が</original>
                <spell/>
            </t>
            <t index="75" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:04:14,060</start-time>
                <end-time>00:04:17,460</end-time>
                <translation>其实呢 这就像地下水脉一样</translation>
                <original>実はこの地下水脈のように</original>
                <spell/>
            </t>
            <t index="76" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:04:17,460</start-time>
                <end-time>00:04:19,810</end-time>
                <translation>自然地逐渐增强</translation>
                <original>こうだんだんだんだんと強まっていって</original>
                <spell/>
            </t>
            <t index="77" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:04:19,810</start-time>
                <end-time>00:04:25,760</end-time>
                <translation>这种被大众的愿望所推动的政治运动 </translation>
                <original>そういう大衆の願望があの動かして行ったようなあの政治運動</original>
                <spell/>
            </t>
            <t index="78" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:04:25,760</start-time>
                <end-time>00:04:28,720</end-time>
                <translation>或者说因此形成的体制 便是“极权主义”的含义</translation>
                <original>あるいは体制として全体主義をとらえている</original>
                <spell/>
            </t>
            <t index="79" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:04:28,720</start-time>
                <end-time>00:04:31,560</end-time>
                <translation>我小时候就会觉得</translation>
                <original>なんか子供の頃をね</original>
                <spell/>
            </t>
            <t index="80" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:04:31,560</start-time>
                <end-time>00:04:34,100</end-time>
                <translation>就是我对希特勒的直接印象呢</translation>
                <original>それこそヒットラーみたいなイメージっていうのは</original>
                <spell/>
            </t>
            <t index="81" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:04:34,180</start-time>
                <end-time>00:04:36,340</end-time>
                <translation>他是拥有非常特殊思想的人</translation>
                <original>すごく特殊な思想を持った人が</original>
                <spell/>
            </t>
            <t index="82" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:04:36,340</start-time>
                <end-time>00:04:39,240</end-time>
                <translation>会强行把所有人卷进来 本来是这种印象</translation>
                <original>みんなを強制的に巻き込んでいくってイメージで</original>
                <spell/>
            </t>
            <t index="83" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:04:39,240</start-time>
                <end-time>00:04:42,520</end-time>
                <translation>但当我知道了 他是通过选举选出来的时候</translation>
                <original>ある時に選挙で選ばれた人だって気づいて</original>
                <spell/>
            </t>
            <t index="84" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:04:42,630</start-time>
                <end-time>00:04:47,280</end-time>
                <translation>-真的大吃一惊 -他其实是大众所期望的</translation>
                <original>-ビックリするんですけど -大衆の方が望んでる</original>
                <spell/>
            </t>
            <t index="85" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:04:47,280</start-time>
                <end-time>00:04:50,770</end-time>
                <translation>现在的 无论是日本还是世界</translation>
                <original>今のまあ、日本でも世界でも</original>
                <spell/>
            </t>
            <t index="86" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:04:50,810</start-time>
                <end-time>00:04:55,280</end-time>
                <translation>从几年前开始就经常听到“闭塞感”这个词了 </translation>
                <original>それ何年前からあの閉塞感という言葉よく聞くようになりました</original>
                <spell/>
            </t>
            <t index="87" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:04:55,310</start-time>
                <end-time>00:05:00,900</end-time>
                <translation>为了打破闭塞感 会想要造成某种刺激</translation>
                <original>閉塞感をあの打ち破るために、何かこう刺激を与えて欲しいと</original>
                <spell/>
            </t>
            <t index="88" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:05:00,960</start-time>
                <end-time>00:05:05,880</end-time>
                <translation>那么渐渐的 渐渐的希望打破这种闭塞感的</translation>
                <original>だんだんだんだんとこの閉塞感とそれ を打ち破ってくれる</original>
                <spell/>
            </t>
            <t index="89" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:05:06,150</start-time>
                <end-time>00:05:08,240</end-time>
                <translation>追求更强大具有超凡魅力的领袖的</translation>
                <original>あのより強いカリスマを求めるような</original>
                <spell/>
            </t>
            <t index="90" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:05:08,240</start-time>
                <end-time>00:05:11,880</end-time>
                <translation>这种心态在不断高涨</translation>
                <original>このメンタリティーがこうどんどんどんどん高まっていくと</original>
                <spell/>
            </t>
            <t index="91" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:05:11,880</start-time>
                <end-time>00:05:14,620</end-time>
                <translation>那时的那种状况再重新出现</translation>
                <original>そういうようなあの状況が</original>
                <spell/>
            </t>
            <t index="92" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:05:14,620</start-time>
                <end-time>00:05:18,730</end-time>
                <translation>不仅是在当下的日本 美国也是</translation>
                <original>あの今日本だけじゃなくて、まあアメリカもそうだし</original>
                <spell/>
            </t>
            <t index="93" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:05:18,730</start-time>
                <end-time>00:05:23,390</end-time>
                <translation>欧洲各国 在很多国家 我觉得都在弥漫着</translation>
                <original>あのヨーロッパの国、いろんな国でも 漂ってんじゃないかと思うんですね</original>
                <spell/>
            </t>
            <t index="94" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:05:23,390</start-time>
                <end-time>00:05:26,660</end-time>
                <translation>能感受到开头有点令人毛骨悚然啊</translation>
                <original>ちょっとゾッとする入り口が見えてきたところで</original>
                <spell/>
            </t>
            <t index="95" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:05:26,660</start-time>
                <end-time>00:05:28,120</end-time>
                <translation>-稍微放慢下脚步吧呢 -嗯 是呢</translation>
                <original>-ちょっとゆっくりと -はい　そうですね</original>
                <spell/>
            </t>
            <t index="96" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:05:28,120</start-time>
                <end-time>00:05:31,850</end-time>
                <translation>那么首先来看看撰写《极权主义的起源》的阿伦特</translation>
                <original>では、全体主義の起源を執筆したアーレント</original>
                <spell/>
            </t>
            <t index="97" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:05:31,860</start-time>
                <end-time>00:05:34,760</end-time>
                <translation>究竟是怎样一个人物吧</translation>
                <original>とはどんな人物なのかをまず見てみましょう</original>
                <spell/>
            </t>
            <t index="98" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:05:37,650</start-time>
                <end-time>00:05:40,550</end-time>
                <translation>汉娜·阿伦特于1906年</translation>
                <original>ハンナアーレントは、1906年</original>
                <spell/>
            </t>
            <t index="99" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:05:40,750</start-time>
                <end-time>00:05:44,000</end-time>
                <translation>出生在德国一个富裕的犹太人家庭</translation>
                <original>ドイツの裕福なユダヤ人家庭に生まれました</original>
                <spell/>
            </t>
            <t index="100" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:05:46,760</start-time>
                <end-time>00:05:50,510</end-time>
                <translation>持有自由主义思想的阿伦特一家</translation>
                <original>自由主義的な考えを持っていたアーレントの一家は</original>
                <spell/>
            </t>
            <t index="101" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:05:50,910</start-time>
                <end-time>00:05:53,660</end-time>
                <translation>对宗教不是特别关心
特に宗教に関心を持たず</translation>
                <original/>
                <spell/>
            </t>
            <t index="102" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:05:53,660</start-time>
                <end-time>00:05:55,560</end-time>
                <translation>阿伦特在家中时</translation>
                <original>家でユダヤ人</original>
                <spell/>
            </t>
            <t index="103" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:05:55,560</start-time>
                <end-time>00:05:58,020</end-time>
                <translation>甚至没听大人特意提及过“犹太人”这个词</translation>
                <original>という言葉を聞くこともなく育ちました</original>
                <spell/>
            </t>
            <t index="104" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:06:00,420</start-time>
                <end-time>00:06:01,960</end-time>
                <translation>对青年阿伦特来说</translation>
                <original>アーレントにとって</original>
                <spell/>
            </t>
            <t index="105" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:06:01,960</start-time>
                <end-time>00:06:05,770</end-time>
                <translation>身为犹太人仅仅是一个事实 </translation>
                <original>ユダヤ人であることは、ただの事実に過ぎず</original>
                <spell/>
            </t>
            <t index="106" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:06:05,770</start-time>
                <end-time>00:06:09,300</end-time>
                <translation>未感到与社会之间存在摩擦</translation>
                <original>社会との軋轢を感じることはありませんでした</original>
                <spell/>
            </t>
            <t index="107" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:06:12,360</start-time>
                <end-time>00:06:16,110</end-time>
                <translation>阿伦特加深对犹太人问题的关注</translation>
                <original>アーレントがユダヤ人問題への関心を深めたのは</original>
                <spell/>
            </t>
            <t index="108" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:06:16,590</start-time>
                <end-time>00:06:18,610</end-time>
                <translation>是因为她在学习哲学的过程中
哲学を勉強する過程で</translation>
                <original/>
                <spell/>
            </t>
            <t index="109" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:06:18,950</start-time>
                <end-time>00:06:21,270</end-time>
                <translation>开始与以建设犹太国家为目标的
ユダヤ国家の建設を目指す</translation>
                <original/>
                <spell/>
            </t>
            <t index="110" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:06:21,300</start-time>
                <end-time>00:06:24,810</end-time>
                <translation>犹太复国主义者们产生交流后的事</translation>
                <original>シオニストたちと交流を持つようになったからでした</original>
                <spell/>
            </t>
            <t index="111" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:06:26,980</start-time>
                <end-time>00:06:31,840</end-time>
                <translation>在此期间 1933年希特勒内阁成立</translation>
                <original>そんな中、1933年ヒトラー内閣が成立</original>
                <spell/>
            </t>
            <t index="112" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:06:32,810</start-time>
                <end-time>00:06:35,760</end-time>
                <translation>崛起的纳粹敌视犹太人</translation>
                <original>台頭したナチスはユダヤ人を敵視</original>
                <spell/>
            </t>
            <t index="113" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:06:36,690</start-time>
                <end-time>00:06:39,300</end-time>
                <translation>局势逐渐恶化
状況は次第に悪化して行きます</translation>
                <original/>
                <spell/>
            </t>
            <t index="114" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:06:42,550</start-time>
                <end-time>00:06:44,310</end-time>
                <translation>阿伦特在柏林</translation>
                <original>アーレントはベルリンで</original>
                <spell/>
            </t>
            <t index="115" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:06:44,380</start-time>
                <end-time>00:06:48,890</end-time>
                <translation>因协助犹太复国主义者的非法活动而被捕</translation>
                <original>シオニストの非合法活動に協力したとして逮捕されますが</original>
                <spell/>
            </t>
            <t index="116" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:06:48,890</start-time>
                <end-time>00:06:51,500</end-time>
                <translation>8天后获释
8日後に釈放</translation>
                <original/>
                <spell/>
            </t>
            <t index="117" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:06:51,500</start-time>
                <end-time>00:06:54,710</end-time>
                <translation>她随即逃离德国 逃往法国</translation>
                <original>すぐにドイツを脱出し、フランスに逃れます</original>
                <spell/>
            </t>
            <t index="118" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:06:59,420</start-time>
                <end-time>00:07:03,050</end-time>
                <translation>此后 纳粹德国依据《纽伦堡法案》</translation>
                <original>その後、ナチスドイツはニュルンベルク法に、より</original>
                <spell/>
            </t>
            <t index="119" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:07:03,050</start-time>
                <end-time>00:07:05,520</end-time>
                <translation>剥夺了犹太人的公民权
ユダヤ人の公民権を剥奪</translation>
                <original/>
                <spell/>
            </t>
            <t index="120" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:07:06,430</start-time>
                <end-time>00:07:09,560</end-time>
                <translation>进一步地 在被称为“水晶之夜”的事件中</translation>
                <original>さらに水晶の夜と呼ばれた事件では</original>
                <spell/>
            </t>
            <t index="121" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:07:09,910</start-time>
                <end-time>00:07:10,940</end-time>
                <translation>在德国各地</translation>
                <original>ドイツ各地で</original>
                <spell/>
            </t>
            <t index="122" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:07:11,260</start-time>
                <end-time>00:07:15,520</end-time>
                <translation>犹太人的住宅和犹太教的会堂被烧毁</translation>
                <original>ユダヤ人の住宅ユダヤ教のシナゴーグが焼かれました</original>
                <spell/>
            </t>
            <t index="123" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:07:21,020</start-time>
                <end-time>00:07:24,340</end-time>
                <translation>翌年 随着纳粹入侵波兰</translation>
                <original>翌年、ナチスのポーランド侵攻により</original>
                <spell/>
            </t>
            <t index="124" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:07:24,340</start-time>
                <end-time>00:07:26,570</end-time>
                <translation>第二次世界大战爆发</translation>
                <original>第2次世界大戦がはじまると</original>
                <spell/>
            </t>
            <t index="125" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:07:27,200</start-time>
                <end-time>00:07:31,570</end-time>
                <translation>对阿伦特来说 法国也不再是安居之地</translation>
                <original>アーレントにとってはフランスも安住の地ではなくなりました</original>
                <spell/>
            </t>
            <t index="126" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:07:33,630</start-time>
                <end-time>00:07:36,260</end-time>
                <translation>德国出身的犹太人被视为敌国公民</translation>
                <original>ドイツ出身者は敵国人として</original>
                <spell/>
            </t>
            <t index="127" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:07:36,500</start-time>
                <end-time>00:07:39,480</end-time>
                <translation>被送往法国南部的收容所</translation>
                <original>フランス南部の収容所に送られたのです</original>
                <spell/>
            </t>
            <t index="128" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:07:41,640</start-time>
                <end-time>00:07:44,870</end-time>
                <translation>1940年巴黎被占领后</translation>
                <original>1940年パリが占領されると</original>
                <spell/>
            </t>
            <t index="129" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:07:45,270</start-time>
                <end-time>00:07:50,010</end-time>
                <translation>阿伦特趁混乱与丈夫一同流亡美国</translation>
                <original>アーレントは混乱に乗じて夫とともにアメリカに亡命</original>
                <spell/>
            </t>
            <t index="130" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:07:50,880</start-time>
                <end-time>00:07:55,910</end-time>
                <translation>在纽约开始了抵抗反犹主义的写作活动
ニューヨーク反ユダヤ主義に抵抗する文筆活動を始めます</translation>
                <original/>
                <spell/>
            </t>
            <t index="131" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:07:59,340</start-time>
                <end-time>00:08:00,230</end-time>
                <translation>在那里</translation>
                <original>そこで</original>
                <spell/>
            </t>
            <t index="132" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:08:00,260</start-time>
                <end-time>00:08:03,440</end-time>
                <translation>阿伦特听到了令人震惊的消息</translation>
                <original>アーレントは驚くべきニュースを耳にします</original>
                <spell/>
            </t>
            <t index="133" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:08:04,460</start-time>
                <end-time>00:08:06,090</end-time>
                <translation>在犹太人收容所
ユダヤ人収容所で</translation>
                <original/>
                <spell/>
            </t>
            <t index="134" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:08:06,120</start-time>
                <end-time>00:08:10,310</end-time>
                <translation>据说发生了数百万人规模的大屠杀</translation>
                <original>何100万人もの、大量虐殺が行われたというのです</original>
                <spell/>
            </t>
            <t index="135" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:08:12,580</start-time>
                <end-time>00:08:16,300</end-time>
                <translation>超乎想象的犹太人灭绝计划（大屠杀）
想像を超えたユダヤ人への絶滅計画（ホロコースト）</translation>
                <original/>
                <spell/>
            </t>
            <t index="136" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:08:17,410</start-time>
                <end-time>00:08:20,060</end-time>
                <translation>阿伦特得知那是事实后</translation>
                <original>アーレントはそれが真実と知ると</original>
                <spell/>
            </t>
            <t index="137" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:08:20,190</start-time>
                <end-time>00:08:22,280</end-time>
                <translation>受到了巨大的冲击
大変な衝撃を受けます</translation>
                <original/>
                <spell/>
            </t>
            <t index="138" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:08:25,840</start-time>
                <end-time>00:08:28,970</end-time>
                <translation>绝不该发生的事情发生了</translation>
                <original>決して起こってはならないことが起こった</original>
                <spell/>
            </t>
            <t index="139" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:08:30,510</start-time>
                <end-time>00:08:34,480</end-time>
                <translation>阿伦特试图理解这摆在眼前的事实</translation>
                <original>アーレントは突きつけられた事実を理解しようと試みます</original>
                <spell/>
            </t>
            <t index="140" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:08:36,640</start-time>
                <end-time>00:08:38,670</end-time>
                <translation>然后在战争结束后
そして大戦終結後</translation>
                <original/>
                <spell/>
            </t>
            <t index="141" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:08:39,090</start-time>
                <end-time>00:08:43,440</end-time>
                <translation>她彻查了留在德国的希特勒政权的庞大资料</translation>
                <original>ドイツに残されたヒトラー政権の膨大な資料を調べ上げ</original>
                <spell/>
            </t>
            <t index="142" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:08:43,960</start-time>
                <end-time>00:08:48,010</end-time>
                <translation>写下了巨著《极权主义的起源》
大著全体主義の起源を書き上げたのです</translation>
                <original/>
                <spell/>
            </t>
            <t index="143" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:08:49,710</start-time>
                <end-time>00:08:51,880</end-time>
                <translation>仲正老师 阿伦特小时候</translation>
                <original>なかませさんアーレントが子供の頃は</original>
                <spell/>
            </t>
            <t index="144" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:08:51,910</start-time>
                <end-time>00:08:55,650</end-time>
                <translation>似乎能够在不特别意识到自己是犹太人的情况下生活</translation>
                <original>ユダヤ人であることを特に意識せずに暮らすことができたようですね</original>
                <spell/>
            </t>
            <t index="145" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:08:55,680</start-time>
                <end-time>00:09:00,200</end-time>
                <translation>嗯 欧洲的市民 尤其是法国 德国等</translation>
                <original>あのまあ、ヨーロッパの市民、特にあのフランスとか ドイツとか</original>
                <spell/>
            </t>
            <t index="146" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:09:01,060</start-time>
                <end-time>00:09:06,520</end-time>
                <translation>在犹太人相当程度上融入了普通人之中的社会环境中</translation>
                <original>あのユダヤ人があのかなりこう、普通の人たちの中に溶け込んでいった</original>
                <spell/>
            </t>
            <t index="147" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:09:06,620</start-time>
                <end-time>00:09:10,630</end-time>
                <translation>犹太人自身以及周围的人</translation>
                <original>社会の中ではユダヤ人自身もそれからあのまあ、周りの人たちも</original>
                <spell/>
            </t>
            <t index="148" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:09:10,640</start-time>
                <end-time>00:09:12,940</end-time>
                <translation>对于自己在歧视犹太人</translation>
                <original>自分達がユダヤ人を差別しているとか</original>
                <spell/>
            </t>
            <t index="149" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:09:12,940</start-time>
                <end-time>00:09:16,180</end-time>
                <translation>或者自己作为犹太人受到了歧视 对此没有强烈意识</translation>
                <original>差別されてるっていう意識はそんな強く持ってなかった</original>
                <spell/>
            </t>
            <t index="150" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:09:16,180</start-time>
                <end-time>00:09:17,580</end-time>
                <translation>有这一点原因</translation>
                <original>フシもあるんですけれど</original>
                <spell/>
            </t>
            <t index="151" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:09:17,580</start-time>
                <end-time>00:09:19,760</end-time>
                <translation>大屠杀的特殊之处在于</translation>
                <original>ホロコーストってやっぱり特殊なのは</original>
                <spell/>
            </t>
            <t index="152" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:09:19,760</start-time>
                <end-time>00:09:24,020</end-time>
                <translation>特意将数十万人集中到收容所 并杀害</translation>
                <original>収容所にわざわざ何10万人も集めて、まあ殺しているわけ</original>
                <spell/>
            </t>
            <t index="153" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:09:24,020</start-time>
                <end-time>00:09:27,190</end-time>
                <translation>为什么非要特意做那样的事</translation>
                <original>なんでわざわざそんなことをしないといけないのかと</original>
                <spell/>
            </t>
            <t index="154" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:09:27,860</start-time>
                <end-time>00:09:30,050</end-time>
                <translation>-不合道理 -没有逻辑</translation>
                <original>-理にかなってない -理にかなってない</original>
                <spell/>
            </t>
            <t index="155" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:09:30,080</start-time>
                <end-time>00:09:34,160</end-time>
                <translation>我想她大概就是不明白这一点</translation>
                <original>あのそれがやっぱりわかんなかったんだと思うんですよね</original>
                <spell/>
            </t>
            <t index="156" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:09:34,420</start-time>
                <end-time>00:09:38,060</end-time>
                <translation>关于极权主义的起源</translation>
                <original>この全体主義の起源については</original>
                <spell/>
            </t>
            <t index="157" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:09:38,060</start-time>
                <end-time>00:09:43,010</end-time>
                <translation>她认为并不只有一个原因</translation>
                <original>なんかこうたった1つの起原があるというふうには考えてないんですよね</original>
                <spell/>
            </t>
            <t index="158" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:09:43,010</start-time>
                <end-time>00:09:44,680</end-time>
                <translation>有各种因素</translation>
                <original>いろんな要素があって</original>
                <spell/>
            </t>
            <t index="159" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:09:44,680</start-time>
                <end-time>00:09:47,800</end-time>
                <translation>使当时欧洲人的这种不安不断加剧 </translation>
                <original>ヨーロッパ人のこの不安を高めていったと</original>
                <spell/>
            </t>
            <t index="160" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:09:47,800</start-time>
                <end-time>00:09:50,140</end-time>
                <translation>矛盾且奇妙的</translation>
                <original>矛盾なりに</original>
                <spell/>
            </t>
            <t index="161" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:09:50,140</start-time>
                <end-time>00:09:52,100</end-time>
                <translation>最初是较轻的歧视</translation>
                <original>最初はこういう事だったのが</original>
                <spell/>
            </t>
            <t index="162" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:09:52,100</start-time>
                <end-time>00:09:55,130</end-time>
                <translation>接下来又升级到了下一阶段</translation>
                <original>次はこういう段階にエスカレート していたと</original>
                <spell/>
            </t>
            <t index="163" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:09:55,130</start-time>
                <end-time>00:09:58,240</end-time>
                <translation>而它为什么会以这么不断升级</translation>
                <original>でそれがなぜこういう風にエスカレートしていったのか</original>
                <spell/>
            </t>
            <t index="164" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:09:58,240</start-time>
                <end-time>00:10:00,880</end-time>
                <translation>她对此进行了细致的分析的同时</translation>
                <original>っていうのをその細かく分析して行きながら</original>
                <spell/>
            </t>
            <t index="165" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:10:01,110</start-time>
                <end-time>00:10:04,340</end-time>
                <translation>也大概希望读到的人能够思考</translation>
                <original>まあ多分おそらく読んで人に</original>
                <spell/>
            </t>
            <t index="166" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:10:04,370</start-time>
                <end-time>00:10:10,040</end-time>
                <translation>那要怎样才能避免它这样升级呢</translation>
                <original>じゃあここをこうエスカレートさせないようにするにはどうするのかってでも考えて</original>
                <spell/>
            </t>
            <t index="167" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:10:10,040</start-time>
                <end-time>00:10:12,660</end-time>
                <translation>我想她是出于这样的动机才写下这本书的吧</translation>
                <original>ほしいという動機で書いたんじゃないかと思うんですよね</original>
                <spell/>
            </t>
            <t index="168" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:10:12,660</start-time>
                <end-time>00:10:14,610</end-time>
                <translation>这样一想的话</translation>
                <original>まあなんかそうやって考えると</original>
                <spell/>
            </t>
            <t index="169" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:10:14,610</start-time>
                <end-time>00:10:16,070</end-time>
                <translation>自己的国家
自分の国今</translation>
                <original/>
                <spell/>
            </t>
            <t index="170" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:10:16,100</start-time>
                <end-time>00:10:18,800</end-time>
                <translation>现在的日本处于哪个阶段呢</translation>
                <original>今の日本はどの段階にあるんだろー</original>
                <spell/>
            </t>
            <t index="171" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:10:18,800</start-time>
                <end-time>00:10:20,440</end-time>
                <translation>像这样的事情也让人不禁会去思考</translation>
                <original>みたいなこともちょっと考えちゃうから</original>
                <spell/>
            </t>
            <t index="172" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:10:20,440</start-time>
                <end-time>00:10:22,630</end-time>
                <translation>是啊 虽然我们能够平静回顾历史</translation>
                <original>そうなんですね後から振り返ることができても</original>
                <spell/>
            </t>
            <t index="173" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:10:22,640</start-time>
                <end-time>00:10:24,060</end-time>
                <translation>但更重要的是要理解当下</translation>
                <original>今を理解する</original>
                <spell/>
            </t>
            <t index="174" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:10:24,060</start-time>
                <end-time>00:10:27,140</end-time>
                <translation>从这个角度上说 这是这本书的存在意义</translation>
                <original>で持ってある意味、そのための本でおそらく</original>
                <spell/>
            </t>
            <t index="175" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:10:27,140</start-time>
                <end-time>00:10:30,570</end-time>
                <translation>我们本月选择这本书 大概也是出于这样的原因吧</translation>
                <original>今月これを取り上げているのは、おそらくそういうことなんだろうと 思います</original>
                <spell/>
            </t>
            <t index="176" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:10:31,460</start-time>
                <end-time>00:10:34,880</end-time>
                <translation>那么 那我们本回就来看看《极权主义的起源》第一卷</translation>
                <original>さあ、それでは全体主義の起源の第1巻</original>
                <spell/>
            </t>
            <t index="177" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:10:34,880</start-time>
                <end-time>00:10:37,310</end-time>
                <translation>看看“反犹主义”的实质吧</translation>
                <original>反ユダヤ主義の中身を見て行きましょう</original>
                <spell/>
            </t>
            <t index="178" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:10:37,340</start-time>
                <end-time>00:10:39,770</end-time>
                <translation>朗读由田中美里女士担任
朗読は田中美里さんです</translation>
                <original/>
                <spell/>
            </t>
            <t index="179" time="" vertical="0" id="" hasRuby="0" torder="1">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:10:42,990</start-time>
                <end-time>00:10:48,240</end-time>
                <translation>反犹主义与对犹太人的憎恨不一样</translation>
                <original>反ユダヤ主義とユダヤ人憎悪は同じものではない</original>
                <spell/>
            </t>
            <t index="180" time="" vertical="0" id="" hasRuby="0" torder="1">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:10:48,240</start-time>
                <end-time>00:10:50,610</end-time>
                <translation>对犹太人的憎恨</translation>
                <original>ユダヤ人憎悪というものは</original>
                <spell/>
            </t>
            <t index="181" time="" vertical="0" id="" hasRuby="0" torder="1">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:10:50,610</start-time>
                <end-time>00:10:52,890</end-time>
                <translation>自古以来就一直存在</translation>
                <original>昔からずっと存在したが</original>
                <spell/>
            </t>
            <t index="182" time="" vertical="0" id="" hasRuby="0" torder="1">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:10:52,890</start-time>
                <end-time>00:10:54,470</end-time>
                <translation>然而 反犹主义</translation>
                <original>はい、ユダヤ主義は</original>
                <spell/>
            </t>
            <t index="183" time="" vertical="0" id="" hasRuby="0" torder="1">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:10:54,470</start-time>
                <end-time>00:10:59,190</end-time>
                <translation>在其政治的及意识形态的意义上</translation>
                <original>その政治的およびイデオロギー的意味において</original>
                <spell/>
            </t>
            <t index="184" time="" vertical="0" id="" hasRuby="0" torder="1">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:10:59,190</start-time>
                <end-time>00:11:01,180</end-time>
                <translation>是19世纪的现象
19世紀の現象である</translation>
                <original/>
                <spell/>
            </t>
            <t index="185" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:11:05,450</start-time>
                <end-time>00:11:09,550</end-time>
                <translation>阿伦特认为 诞生于19世纪的反犹主义</translation>
                <original>アーレントは19世紀に生まれた反ユダヤ主義が</original>
                <spell/>
            </t>
            <t index="186" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:11:09,930</start-time>
                <end-time>00:11:12,790</end-time>
                <translation>与以往对犹太人的反感</translation>
                <original>それまでのユダヤ人に対する反感とは</original>
                <spell/>
            </t>
            <t index="187" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:11:12,990</start-time>
                <end-time>00:11:15,770</end-time>
                <translation>有着根本性的不同</translation>
                <original>根本的に違うものだと考えました</original>
                <spell/>
            </t>
            <t index="188" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:11:18,900</start-time>
                <end-time>00:11:21,160</end-time>
                <translation>以往的犹太人形象</translation>
                <original>従来のユダヤ人のイメージは</original>
                <spell/>
            </t>
            <t index="189" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:11:21,760</start-time>
                <end-time>00:11:28,100</end-time>
                <translation>是圣经中将耶稣钉上十字架的罪孽深重之民</translation>
                <original>聖書でイエスを10字架にかけた罪深き民</original>
                <spell/>
            </t>
            <t index="190" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:11:28,110</start-time>
                <end-time>00:11:33,040</end-time>
                <translation>是以基督教所禁止的利息放贷的形式</translation>
                <original>キリスト教が禁じた利子をとって金を貸す</original>
                <spell/>
            </t>
            <t index="191" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:11:33,090</start-time>
                <end-time>00:11:34,400</end-time>
                <translation>是靠金融业赚钱的少数群体</translation>
                <original>金融業で儲けるマイノリティでした</original>
                <spell/>
            </t>
            <t index="192" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:11:36,660</start-time>
                <end-time>00:11:38,600</end-time>
                <translation>在17、18世纪
17、１8世紀には</translation>
                <original/>
                <spell/>
            </t>
            <t index="193" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:11:38,890</start-time>
                <end-time>00:11:42,820</end-time>
                <translation>向各地王室放贷的一些宫廷中的犹太人</translation>
                <original>各地の王家に金を貸す宮廷ユダヤ人として</original>
                <spell/>
            </t>
            <t index="194" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:11:43,000</start-time>
                <end-time>00:11:45,280</end-time>
                <translation>获得很高的地位</translation>
                <original>高い地位を得る者も現れます</original>
                <spell/>
            </t>
            <t index="195" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:11:46,910</start-time>
                <end-time>00:11:49,340</end-time>
                <translation>但更多的欧洲犹太人所拥有的财富</translation>
                <original>しかし、多くのユダヤ人の富は</original>
                <spell/>
            </t>
            <t index="196" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:11:49,560</start-time>
                <end-time>00:11:54,040</end-time>
                <translation>却成为被憎恶和蔑视的对象 遭受着歧视</translation>
                <original>象をと蔑みの対象となり、差別を受けていたのです</original>
                <spell/>
            </t>
            <t index="197" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:11:56,800</start-time>
                <end-time>00:12:00,470</end-time>
                <translation>使这种处境发生巨大改变的是19世纪</translation>
                <original>そうした立場を、大きく変えたのが19世紀</original>
                <spell/>
            </t>
            <t index="198" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:12:01,120</start-time>
                <end-time>00:12:05,110</end-time>
                <translation>拿破仑战争后诞生的国民国家（To：又称民族国家）</translation>
                <original>ナポレオン戦争後に生まれていった国民国家でした</original>
                <spell/>
            </t>
            <t index="199" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:12:07,300</start-time>
                <end-time>00:12:08,530</end-time>
                <translation>所谓国民国家是指
国民国家とは</translation>
                <original/>
                <spell/>
            </t>
            <t index="200" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:12:08,740</start-time>
                <end-time>00:12:14,300</end-time>
                <translation>由拥有同样的语言、历史、文化的人们所构成的国家</translation>
                <original>言語、歴史、文化を共有する人々によって構成された国家のこと</original>
                <spell/>
            </t>
            <t index="201" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:12:16,690</start-time>
                <end-time>00:12:18,360</end-time>
                <translation>随着在拿破仑战争中战败</translation>
                <original>ナポレオン戦争で敗れ</original>
                <spell/>
            </t>
            <t index="202" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:12:18,560</start-time>
                <end-time>00:12:24,280</end-time>
                <translation>被法国人统治的各国人民的民族意识的觉醒</translation>
                <original>フランス人に支配された各国の人々が 国民意識に目覚めていくことで</original>
                <spell/>
            </t>
            <t index="203" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:12:24,600</start-time>
                <end-time>00:12:26,800</end-time>
                <translation>国民国家由此诞生</translation>
                <original>国民国家が生まれたのです</original>
                <spell/>
            </t>
            <t index="204" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:12:29,360</start-time>
                <end-time>00:12:31,160</end-time>
                <translation>在这样的大环境下</translation>
                <original>そうした状況の中で</original>
                <spell/>
            </t>
            <t index="205" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:12:31,160</start-time>
                <end-time>00:12:33,500</end-time>
                <translation>犹太人本身的处境也发生了变化</translation>
                <original>ユダヤ人の立場も変化します</original>
                <spell/>
            </t>
            <t index="206" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:12:34,570</start-time>
                <end-time>00:12:38,860</end-time>
                <translation>以罗斯柴尔德家族为代表的犹太银行家崛起</translation>
                <original>ロスチャイルド系に代表されるユダヤ人銀行家が台頭</original>
                <spell/>
            </t>
            <t index="207" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:12:39,600</start-time>
                <end-time>00:12:43,040</end-time>
                <translation>建立了遍布整个欧洲的网络</translation>
                <original>ヨーロッパ全土にわたるネットワークを築きあげます</original>
                <spell/>
            </t>
            <t index="208" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:12:44,170</start-time>
                <end-time>00:12:48,460</end-time>
                <translation>而此前一直遭受歧视的犹太国民</translation>
                <original>そしてそれまで差別を受けていたユダヤ人の国民にも</original>
                <spell/>
            </t>
            <t index="209" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:12:48,750</start-time>
                <end-time>00:12:51,220</end-time>
                <translation>也被赋予了法律上的人权</translation>
                <original>法律上の人権が与えられました</original>
                <spell/>
            </t>
            <t index="210" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:12:55,650</start-time>
                <end-time>00:12:57,340</end-time>
                <translation>然而 正是这一点</translation>
                <original>しかしそれこそが</original>
                <spell/>
            </t>
            <t index="211" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:12:57,650</start-time>
                <end-time>00:13:01,870</end-time>
                <translation>成为了催生新的“反犹主义”的契机</translation>
                <original>新たな反ユダヤ主義を生み出すきっかけとなったのです</original>
                <spell/>
            </t>
            <t index="212" time="" vertical="0" id="" hasRuby="0" torder="1">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:13:05,240</start-time>
                <end-time>00:13:10,610</end-time>
                <translation>正是在国民国家发展的顶点</translation>
                <original>まさに国民国家がその発展の頂点において</original>
                <spell/>
            </t>
            <t index="213" time="" vertical="0" id="" hasRuby="0" torder="1">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:13:10,610</start-time>
                <end-time>00:13:15,750</end-time>
                <translation>在赋予犹太人法律上平等权利这一事实之中</translation>
                <original>ユダヤ人に法律上の同権を与えたという事実の中には</original>
                <spell/>
            </t>
            <t index="214" time="" vertical="0" id="" hasRuby="0" torder="1">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:13:15,750</start-time>
                <end-time>00:13:20,550</end-time>
                <translation>已经潜藏着奇妙的矛盾</translation>
                <original>すでに奇妙な矛盾が潜んでいたのである</original>
                <spell/>
            </t>
            <t index="215" time="" vertical="0" id="" hasRuby="0" torder="1">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:13:20,550</start-time>
                <end-time>00:13:23,020</end-time>
                <translation>在同质化的居民内部
同質的な住民の内部では</translation>
                <original/>
                <spell/>
            </t>
            <t index="216" time="" vertical="0" id="" hasRuby="0" torder="1">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:13:23,020</start-time>
                <end-time>00:13:26,400</end-time>
                <translation>犹太人无疑是异类</translation>
                <original>ユダヤ人は疑いもなく異分子であり</original>
                <spell/>
            </t>
            <t index="217" time="" vertical="0" id="" hasRuby="0" torder="1">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:13:26,400</start-time>
                <end-time>00:13:30,460</end-time>
                <translation>因此 如果要承认他们的平等权利</translation>
                <original>そのため同権を認めてやろうとするのであれば</original>
                <spell/>
            </t>
            <t index="218" time="" vertical="0" id="" hasRuby="0" torder="1">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:13:30,460</start-time>
                <end-time>00:13:33,700</end-time>
                <translation>必须立即将其同化 如果可能的话</translation>
                <original>直ちに同化させできることなら</original>
                <spell/>
            </t>
            <t index="219" time="" vertical="0" id="" hasRuby="0" torder="1">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:13:33,700</start-time>
                <end-time>00:13:36,630</end-time>
                <translation>就必须将其消灭</translation>
                <original>消滅させてしまわねばならなかったのである</original>
                <spell/>
            </t>
            <t index="220" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:13:39,850</start-time>
                <end-time>00:13:44,520</end-time>
                <translation>反犹主义是随着国民国家的建立而产生的</translation>
                <original>アーレントは、反ユダヤ人が国民国家の成立によって生まれたと</original>
                <spell/>
            </t>
            <t index="221" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:13:44,520</start-time>
                <end-time>00:13:45,980</end-time>
                <translation>这是阿伦特认为的观点呢</translation>
                <original>言ってるわけですよね</original>
                <spell/>
            </t>
            <t index="222" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:13:46,250</start-time>
                <end-time>00:13:47,600</end-time>
                <translation>国民国家
国民国家は</translation>
                <original/>
                <spell/>
            </t>
            <t index="223" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:13:47,670</start-time>
                <end-time>00:13:50,060</end-time>
                <translation>用英语来说就是“nation state” </translation>
                <original>あの英語で言うとネーションステート</original>
                <spell/>
            </t>
            <t index="224" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:13:50,060</start-time>
                <end-time>00:13:51,840</end-time>
                <translation>“nation”个词原本</translation>
                <original>っていうのは元々</original>
                <spell/>
            </t>
            <t index="225" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:13:51,840</start-time>
                <end-time>00:13:55,820</end-time>
                <translation>来源于拉丁语中表示“出生（natio）”的词</translation>
                <original>あの生まれっていう意味のラテン語からきている言葉で</original>
                <spell/>
            </t>
            <t index="226" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:13:55,850</start-time>
                <end-time>00:13:59,670</end-time>
                <translation>共享文化的 对此有明确自觉的</translation>
                <original>文化を共有していると、そういうことを明確に自覚して</original>
                <spell/>
            </t>
            <t index="227" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:13:59,680</start-time>
                <end-time>00:14:02,540</end-time>
                <translation>这样一些人的集合体</translation>
                <original>いる人たちのあの集合体ですよね</original>
                <spell/>
            </t>
            <t index="228" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:14:02,540</start-time>
                <end-time>00:14:04,740</end-time>
                <translation>与此相对 所谓国家</translation>
                <original>それに、対してまあ</original>
                <spell/>
            </t>
            <t index="229" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:14:04,740</start-time>
                <end-time>00:14:07,200</end-time>
                <translation>则是指官僚组织、警察、军队等</translation>
                <original>国家というのは官僚組織とか警察とか軍隊とか</original>
                <spell/>
            </t>
            <t index="230" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:14:07,200</start-time>
                <end-time>00:14:08,940</end-time>
                <translation>这类组织</translation>
                <original>そういう組織のことをさします</original>
                <spell/>
            </t>
            <t index="231" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:14:09,040</start-time>
                <end-time>00:14:12,240</end-time>
                <translation>所谓“nation state” 就是试图将民族</translation>
                <original>そのネーションステートっていうのはネーションと</original>
                <spell/>
            </t>
            <t index="232" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:14:12,660</start-time>
                <end-time>00:14:15,740</end-time>
                <translation>与国家作为单位统一起来</translation>
                <original>国家というのを単位として一致させようと</original>
                <spell/>
            </t>
            <t index="233" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:14:15,770</start-time>
                <end-time>00:14:18,080</end-time>
                <translation>那么 为什么这会成为问题呢</translation>
                <original>じゃあ、なぜそれが問題になるかというと</original>
                <spell/>
            </t>
            <t index="234" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:14:18,200</start-time>
                <end-time>00:14:24,090</end-time>
                <translation>欧洲 特别是呢 英国之外的大陆部分</translation>
                <original>ヨーロッパ、特にあのまあイギリス除いた、大陸の部分っていうのは</original>
                <spell/>
            </t>
            <t index="235" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:14:24,090</start-time>
                <end-time>00:14:27,290</end-time>
                <translation>那里没有天然国界</translation>
                <original>これ、あの自然な国境ってないですから</original>
                <spell/>
            </t>
            <t index="236" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:14:27,320</start-time>
                <end-time>00:14:29,270</end-time>
                <translation>存在着各种民族</translation>
                <original>あのいろんなそのnation</original>
                <spell/>
            </t>
            <t index="237" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:14:29,300</start-time>
                <end-time>00:14:32,090</end-time>
                <translation>各种意识的人们混居在一起</translation>
                <original>意識を持った人たちが、あの混住してる</original>
                <spell/>
            </t>
            <t index="238" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:14:32,220</start-time>
                <end-time>00:14:33,730</end-time>
                <translation>在很多地方都是这样</translation>
                <original>ところが多いわけですね</original>
                <spell/>
            </t>
            <t index="239" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:14:33,880</start-time>
                <end-time>00:14:37,410</end-time>
                <translation>民族与国家未必真正一致</translation>
                <original>必ずしも本当にネイションとステートが一致はしてないかったっていう</original>
                <spell/>
            </t>
            <t index="240" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:14:37,440</start-time>
                <end-time>00:14:38,750</end-time>
                <translation>当地人虽然以此为目标</translation>
                <original>目指すんだけれども</original>
                <spell/>
            </t>
            <t index="241" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:14:38,780</start-time>
                <end-time>00:14:42,270</end-time>
                <translation>但在现实中却很难实现</translation>
                <original>なかなか現実的にはできないものだっていうことなんですね</original>
                <spell/>
            </t>
            <t index="242" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:14:43,950</start-time>
                <end-time>00:14:46,800</end-time>
                <translation>国民国家是如何形成的呢</translation>
                <original>国民国家がどのように出来ていったのか</original>
                <spell/>
            </t>
            <t index="243" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:14:47,340</start-time>
                <end-time>00:14:49,180</end-time>
                <translation>让我们以德国为例来看一看</translation>
                <original>ドイツを例に見てみましょう</original>
                <spell/>
            </t>
            <t index="244" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:14:51,140</start-time>
                <end-time>00:14:54,750</end-time>
                <translation>在德国的源头神圣罗马帝国内部</translation>
                <original>ドイツのルーツである神聖ローマ帝国のなかには</original>
                <spell/>
            </t>
            <t index="245" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:14:54,950</start-time>
                <end-time>00:14:57,150</end-time>
                <translation>居住着各种文化背景的人们</translation>
                <original>さまざまな文化の人々が住み</original>
                <spell/>
            </t>
            <t index="246" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:14:57,780</start-time>
                <end-time>00:15:03,030</end-time>
                <translation>不久 大量出现由各自的领主统治的小国</translation>
                <original>やがて、それぞれの両親が治める、小さな国が 数多くできました</original>
                <spell/>
            </t>
            <t index="247" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:15:04,540</start-time>
                <end-time>00:15:06,910</end-time>
                <translation>在19世纪的拿破仑战争中</translation>
                <original>19世紀のナポレオン戦争で</original>
                <spell/>
            </t>
            <t index="248" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:15:07,000</start-time>
                <end-time>00:15:09,430</end-time>
                <translation>神圣罗马帝国灭亡
神聖ローマ帝国は消滅</translation>
                <original/>
                <spell/>
            </t>
            <t index="249" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:15:10,260</start-time>
                <end-time>00:15:13,490</end-time>
                <translation>由具有“德意志人”意识的地区组成的集合体</translation>
                <original>ドイツ人という意識を持つ地域の集まり</original>
                <spell/>
            </t>
            <t index="250" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:15:13,880</start-time>
                <end-time>00:15:15,590</end-time>
                <translation>德意志邦联成立
ドイツ連邦が結成</translation>
                <original/>
                <spell/>
            </t>
            <t index="251" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:15:17,170</start-time>
                <end-time>00:15:19,880</end-time>
                <translation>1871年德意志统一</translation>
                <original>1871年にはドイツ統一</original>
                <spell/>
            </t>
            <t index="252" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:15:21,210</start-time>
                <end-time>00:15:22,860</end-time>
                <translation>然而 其中有着</translation>
                <original>しかし、その中に</original>
                <spell/>
            </t>
            <t index="253" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:15:23,040</start-time>
                <end-time>00:15:26,080</end-time>
                <translation>被视为与德意志人不同的人</translation>
                <original>ドイツ人とは異質とみなされた人々</original>
                <spell/>
            </t>
            <t index="254" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:15:26,360</start-time>
                <end-time>00:15:28,140</end-time>
                <translation>即犹太人</translation>
                <original>ユダヤ人がいたのです</original>
                <spell/>
            </t>
            <t index="255" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:15:32,160</start-time>
                <end-time>00:15:34,330</end-time>
                <translation>那么犹太人到底是什么呢</translation>
                <original>じゃユダヤ人っていうのは何なんだと</original>
                <spell/>
            </t>
            <t index="256" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:15:34,360</start-time>
                <end-time>00:15:37,720</end-time>
                <translation>总之 犹太人 对这个群体的感受</translation>
                <original>で要するにユダヤ人の人たちっていうのはね</original>
                <spell/>
            </t>
            <t index="257" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:15:37,720</start-time>
                <end-time>00:15:43,520</end-time>
                <translation>是德意志人为了确认彼此确实是一体的</translation>
                <original>あのドイツ人同士が自分たちはやっぱり一緒だってことをあの確認するために</original>
                <spell/>
            </t>
            <t index="258" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:15:43,550</start-time>
                <end-time>00:15:46,560</end-time>
                <translation>逐渐地被视为异类分子</translation>
                <original>だんだんとこう異分子がなんかこう入り込んで</original>
                <spell/>
            </t>
            <t index="259" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:15:46,560</start-time>
                <end-time>00:15:48,100</end-time>
                <translation>感到他们混在自己人之中</translation>
                <original>きてるっていう意識にどうもこう</original>
                <spell/>
            </t>
            <t index="260" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:15:48,100</start-time>
                <end-time>00:15:52,790</end-time>
                <translation>这种感觉在国民国家的建立过程中不断加剧</translation>
                <original>と思うんです進んでいったような、そういう感じがあるんだ</original>
                <spell/>
            </t>
            <t index="261" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:15:53,370</start-time>
                <end-time>00:15:56,310</end-time>
                <translation>圈在一起成国家后 里面就全都是德意志人</translation>
                <original>囲ったせいで全部ドイツ人です</original>
                <spell/>
            </t>
            <t index="262" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:15:56,340</start-time>
                <end-time>00:15:59,450</end-time>
                <translation>表面上就变成了这样</translation>
                <original>で一応表向きになるわけですよね</original>
                <spell/>
            </t>
            <t index="263" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:15:59,480</start-time>
                <end-time>00:16:01,830</end-time>
                <translation>但大家内心都会觉得不全是</translation>
                <original>でも、みんな内心でも違うじゃん</original>
                <spell/>
            </t>
            <t index="264" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:16:02,300</start-time>
                <end-time>00:16:05,170</end-time>
                <translation>这种情况在越来越严重 是这个意思么？</translation>
                <original>みたいな方がちょっと深刻になっていくっていう事ですか</original>
                <spell/>
            </t>
            <t index="265" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:16:05,260</start-time>
                <end-time>00:16:06,510</end-time>
                <translation>就是这么回事呢</translation>
                <original>そういう事はですね</original>
                <spell/>
            </t>
            <t index="266" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:16:06,540</start-time>
                <end-time>00:16:10,480</end-time>
                <translation>犹太式的习俗已经全部被禁止</translation>
                <original>ユダヤ的なその慣習というのは、もう一切</original>
                <spell/>
            </t>
            <t index="267" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:16:10,480</start-time>
                <end-time>00:16:13,440</end-time>
                <translation>犹太人之间的交往之类的</translation>
                <original>もうやめてもらうと、ユダヤ人同士の付き合いみたいなものも</original>
                <spell/>
            </t>
            <t index="268" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:16:13,450</start-time>
                <end-time>00:16:15,190</end-time>
                <translation>这些也全部停止</translation>
                <original>まあ、これも一切やめて</original>
                <spell/>
            </t>
            <t index="269" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:16:15,200</start-time>
                <end-time>00:16:17,630</end-time>
                <translation>犹太人必须变得像普通德意志人一样才行</translation>
                <original>まあ、普通のドイツ人みたいになってくれなきゃ困ると</original>
                <spell/>
            </t>
            <t index="270" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:16:17,660</start-time>
                <end-time>00:16:21,910</end-time>
                <translation>如果不这样 你们光嘴上说 我们是无法安心的</translation>
                <original>まあそうじゃないとあなた達が言ってもらうと、もう安心できないと</original>
                <spell/>
            </t>
            <t index="271" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:16:22,170</start-time>
                <end-time>00:16:25,310</end-time>
                <translation>而这类要求被不断强加在犹太人身上</translation>
                <original>で、そういうことをやっぱりこう押し付け</original>
                <spell/>
            </t>
            <t index="272" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:16:25,560</start-time>
                <end-time>00:16:28,270</end-time>
                <translation>我想当时就是这样的情况呢</translation>
                <original>ようなことになってたんだと思うんですね</original>
                <spell/>
            </t>
            <t index="273" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:16:28,480</start-time>
                <end-time>00:16:32,060</end-time>
                <translation>但是这时的犹太人受到压力</translation>
                <original>でもただ、これそう圧力を受けて</original>
                <spell/>
            </t>
            <t index="274" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:16:32,090</start-time>
                <end-time>00:16:36,590</end-time>
                <translation>那也没办法 那就成为普通德意志人吧</translation>
                <original>あのまあしょうがないかじゃあまあ、あの普通のドイツ人になるかって</original>
                <spell/>
            </t>
            <t index="275" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:16:36,590</start-time>
                <end-time>00:16:38,720</end-time>
                <translation>有犹太人这么主张了</translation>
                <original>いうよー人たちも言うとすれば</original>
                <spell/>
            </t>
            <t index="276" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:16:38,720</start-time>
                <end-time>00:16:42,340</end-time>
                <translation>就也会有相反的 有人犹太意识的觉醒之类的</translation>
                <original>逆にこう自分のユダヤ意識みたいなものを持つ人とか</original>
                <spell/>
            </t>
            <t index="277" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:16:43,860</start-time>
                <end-time>00:16:48,260</end-time>
                <translation>感受到了前方命运泥沼的强烈气息呢</translation>
                <original>何かちょっと泥沼への入り口の臭いはものすごくしますね</original>
                <spell/>
            </t>
            <t index="278" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:16:48,270</start-time>
                <end-time>00:16:52,530</end-time>
                <translation>阿伦特对反犹主义是这样说的</translation>
                <original>このアーレントは反ユダヤ主義についてこんなふうに言っているんです</original>
                <spell/>
            </t>
            <t index="279" time="" vertical="0" id="" hasRuby="0" torder="1">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:16:54,190</start-time>
                <end-time>00:16:57,280</end-time>
                <translation>作为国际性的商业种姓</translation>
                <original>国際的な商業カーストとして</original>
                <spell/>
            </t>
            <t index="280" time="" vertical="0" id="" hasRuby="0" torder="1">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:16:57,280</start-time>
                <end-time>00:17:03,360</end-time>
                <translation>作为在各地作为利益一致的家族式康采恩Konzern的犹太人</translation>
                <original>いたるところで 利害を等しくする家族的コンツェルンとしてのユダヤ人</original>
                <spell/>
            </t>
            <t index="281" time="" vertical="0" id="" hasRuby="0" torder="1">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:17:03,360</start-time>
                <end-time>00:17:05,980</end-time>
                <translation>这种形象反复出现</translation>
                <original>というイメージが繰り返し現れ</original>
                <spell/>
            </t>
            <t index="282" time="" vertical="0" id="" hasRuby="0" torder="1">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:17:05,980</start-time>
                <end-time>00:17:08,410</end-time>
                <translation>最终这种形象</translation>
                <original>やがてこうしたイメージは</original>
                <spell/>
            </t>
            <t index="283" time="" vertical="0" id="" hasRuby="0" torder="1">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:17:08,410</start-time>
                <end-time>00:17:13,070</end-time>
                <translation>成了隐藏在王座阴影中的秘密世界势力
王座の影に隠れた隠密の世界勢力</translation>
                <original/>
                <spell/>
            </t>
            <t index="284" time="" vertical="0" id="" hasRuby="0" torder="1">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:17:13,070</start-time>
                <end-time>00:17:18,340</end-time>
                <translation>或是在背后操纵世界上一切事件的</translation>
                <original>あるいは 世界のあらゆる出来事の裏で糸を引いている</original>
                <spell/>
            </t>
            <t index="285" time="" vertical="0" id="" hasRuby="0" torder="1">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:17:18,340</start-time>
                <end-time>00:17:23,670</end-time>
                <translation>全能的秘密结社之类的幻想
全能の秘密結社といった幻想へと変容した</translation>
                <original/>
                <spell/>
            </t>
            <t index="286" time="" vertical="0" id="" hasRuby="0" torder="1">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:17:23,670</start-time>
                <end-time>00:17:25,990</end-time>
                <translation>而他们是否会利用那所谓的权力</translation>
                <original>その権力とされるものを</original>
                <spell/>
            </t>
            <t index="287" time="" vertical="0" id="" hasRuby="0" torder="1">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:17:25,990</start-time>
                <end-time>00:17:31,050</end-time>
                <translation>来破坏一切社会秩序呢？</translation>
                <original>一切の社会的秩序の破壊のために利用するのではないかと</original>
                <spell/>
            </t>
            <t index="288" time="" vertical="0" id="" hasRuby="0" torder="1">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:17:31,050</start-time>
                <end-time>00:17:33,910</end-time>
                <translation>人们会不由自主地怀疑这点</translation>
                <original>否応なしに疑われたのである</original>
