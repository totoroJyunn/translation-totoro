                <start-time>00:18:08,360</start-time>
                <end-time>00:18:12,550</end-time>
                <translation/>
                <original>ドイツ人なのにうまくいかないとしたら一杯いるわけで、その時に</original>
                <spell/>
            </t>
            <t index="300" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:18:12,620</start-time>
                <end-time>00:18:14,150</end-time>
                <translation/>
                <original>こういうもの</original>
                <spell/>
            </t>
            <t index="301" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:18:14,160</start-time>
                <end-time>00:18:17,210</end-time>
                <translation/>
                <original>を見つけちゃったりまして、ここは煽られたりとかすると、それは</original>
