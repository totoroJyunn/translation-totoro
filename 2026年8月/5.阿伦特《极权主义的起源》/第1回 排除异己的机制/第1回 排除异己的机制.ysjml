            <t index="319" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:19:17,340</start-time>
                <end-time>00:19:21,590</end-time>
                <translation/>
                <original>ユダヤ人は国家を裏切る陰謀を巡らせていると主張</original>
