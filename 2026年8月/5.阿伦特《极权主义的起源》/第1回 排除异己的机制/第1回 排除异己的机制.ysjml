                <end-time>00:18:57,760</end-time>
                <translation/>
                <original>のです</original>
                <spell/>
            </t>
            <t index="314" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:19:00,120</start-time>
                <end-time>00:19:02,190</end-time>
                <translation/>
                <original>ドレフュスは無罪を主張</original>
                <spell/>
