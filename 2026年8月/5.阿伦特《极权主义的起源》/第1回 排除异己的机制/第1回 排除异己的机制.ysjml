            <t index="330" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:19:57,530</start-time>
                <end-time>00:20:00,310</end-time>
                <translation/>
                <original>不幸なドレフュス大尉の事件は</original>
                <spell/>
            </t>
            <t index="331" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:20:01,040</start-time>
                <end-time>00:20:02,270</end-time>
                <translation/>
                <original>人権などなく</original>
                <spell/>
            </t>
            <t index="332" time="" vertical="0" id="" hasRuby="0" torder="1">
