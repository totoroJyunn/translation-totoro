            <t index="272" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:16:37,310</start-time>
                <end-time>00:16:40,550</end-time>
                <translation/>
                <original>人たちも言うとすれば、逆にこう自分のユダヤ意識</original>
