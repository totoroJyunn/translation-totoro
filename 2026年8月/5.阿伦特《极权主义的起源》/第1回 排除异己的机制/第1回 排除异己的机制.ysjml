            <t index="307" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:18:27,940</start-time>
                <end-time>00:18:31,890</end-time>
                <translation/>
                <original>反ユダヤ主義を象徴するような事件が起こります</original>
