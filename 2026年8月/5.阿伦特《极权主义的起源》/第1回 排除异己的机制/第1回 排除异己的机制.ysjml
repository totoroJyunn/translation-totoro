            <t index="132" time="" vertical="0" id="" hasRuby="0" torder="1">
                <start-time>00:08:20,190</start-time>
                <end-time>00:08:22,280</end-time>
                <translation/>
                <original>大変な衝撃を受けます</original>
                <spell/>
