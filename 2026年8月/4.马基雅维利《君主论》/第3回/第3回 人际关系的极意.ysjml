            <t torder="1" id="" time="" hasRuby="0" vertical="0" index="43">
                <start-time>00:02:52,250</start-time>
                <end-time>00:02:56,175</end-time>
                <translation>抓住人心</translation>
                <original>人の心をつかむ</original>
                <spell/>
