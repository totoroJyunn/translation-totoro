            <t id="" hasRuby="0" time="" vertical="0" torder="1" index="126">
                <start-time>00:07:14,920</start-time>
                <end-time>00:07:18,254</end-time>
                <translation>请先出兵打赢战争</translation>
                <original>まずは兵を出し戦争に勝ってください</original>
                <spell/>
