            <t id="" hasRuby="0" time="" vertical="0" torder="1" index="37">
                <start-time>00:02:28,600</start-time>
                <end-time>00:02:31,125</end-time>
                <translation>请多关照 请多关照</translation>
                <original>よろしくお願いしますよろしくお願いいたします</original>
