            <t id="" hasRuby="0" time="" vertical="0" torder="1" index="39">
                <start-time>00:02:34,837</start-time>
                <end-time>00:02:38,100</end-time>
                <translation>您有什么感受呢？</translation>
                <original>いうことなんですねどんなふうに感じられましたか?</original>
                <spell/>
            </t>
            <t id="" hasRuby="0" time="" vertical="0" torder="1" index="40">
                <start-time>00:02:38,100</start-time>
                <end-time>00:02:40,610</end-time>
                <translation>是啊 他写的报告</translation>
                <original>そうですね彼の書いた報告書というのは</original>
                <spell/>
            </t>
