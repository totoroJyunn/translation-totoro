            <t id="" hasRuby="0" time="" vertical="0" torder="1" index="343">
                <start-time>00:19:47,169</start-time>
                <end-time>00:19:50,825</end-time>
                <translation>还是感受到自由意志？他们是怎么看待的呢？</translation>
