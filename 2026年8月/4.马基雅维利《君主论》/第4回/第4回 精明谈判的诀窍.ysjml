            </t>
            <t id="" hasRuby="0" time="" vertical="0" torder="1" index="141">
                <start-time>00:08:14,777</start-time>
                <end-time>00:08:18,300</end-time>
                <translation>佛罗伦萨政府也迟迟不给明确答复</translation>
