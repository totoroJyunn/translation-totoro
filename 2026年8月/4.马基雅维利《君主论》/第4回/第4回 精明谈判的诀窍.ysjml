            </t>
            <t id="" hasRuby="0" time="" vertical="0" torder="1" index="125">
                <start-time>00:07:08,044</start-time>
                <end-time>00:07:10,580</end-time>
                <translation>问题在于佛罗伦萨的资金不足</translation>
