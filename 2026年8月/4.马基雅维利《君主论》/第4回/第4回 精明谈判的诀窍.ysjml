            </t>
            <t id="" hasRuby="0" time="" vertical="0" torder="1" index="38">
                <start-time>00:02:31,125</start-time>
                <end-time>00:02:34,837</end-time>
                <translation>听说老师翻译了马基雅维利的报告</translation>
