                <original>それじゃダメだということを言うわけですよね</original>
                <spell/>
            </t>
            <t id="" hasRuby="0" time="" vertical="0" torder="1" index="164">
                <start-time>00:09:29,450</start-time>
                <end-time>00:09:31,400</end-time>
