            </t>
            <t id="" vertical="0" index="342" time="" torder="1" hasRuby="0">
                <start-time>00:19:00,983</start-time>
                <end-time>00:19:03,500</end-time>
                <translation>民众希望他展现的是结果</translation>
                <original>結果を見せるんだと言っていますね</original>
                <spell/>
