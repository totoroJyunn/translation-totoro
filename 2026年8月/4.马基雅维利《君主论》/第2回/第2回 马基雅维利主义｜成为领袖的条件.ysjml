            </t>
            <t id="" vertical="0" index="131" time="" torder="1" hasRuby="0">
                <start-time>00:07:41,620</start-time>
                <end-time>00:07:44,809</end-time>
                <translation>也抓住了他们的心</translation>
                <original>その心をつかんだのです</original>
