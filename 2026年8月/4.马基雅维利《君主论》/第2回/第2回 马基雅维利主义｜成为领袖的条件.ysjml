                <spell/>
            </t>
            <t id="" vertical="0" index="346" time="" torder="1" hasRuby="0">
                <start-time>00:19:16,118</start-time>
                <end-time>00:19:20,512</end-time>
                <translation>需要具备随机应变的心态
変幻自在の心構えを持つ必要がある</translation>
                <original/>
                <spell/>
