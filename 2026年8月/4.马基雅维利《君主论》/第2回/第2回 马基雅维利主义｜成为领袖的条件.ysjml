            <t id="" vertical="0" index="263" time="" torder="1" hasRuby="0">
                <start-time>00:14:22,956</start-time>
                <end-time>00:14:25,927</end-time>
                <translation>马基雅维利是这么说的</translation>
                <original>マキャベリーは言ってるんですよね</original>
