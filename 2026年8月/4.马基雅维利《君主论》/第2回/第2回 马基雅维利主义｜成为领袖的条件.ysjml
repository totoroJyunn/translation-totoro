            <t id="" vertical="0" index="125" time="" torder="1" hasRuby="0">
                <start-time>00:07:14,299</start-time>
                <end-time>00:07:20,429</end-time>
                <translation>此时切萨雷所做的</translation>
                <original>そこでチェーザレがしたことは</original>
