            <t id="" vertical="0" index="358" time="" torder="1" hasRuby="0">
                <start-time>00:19:58,655</start-time>
                <end-time>00:20:03,252</end-time>
                <translation>君主身上有野兽的部分和人的部分</translation>
                <original>君主には野獣の部分と人間の部分がいるんだと</original>
                <spell/>
            </t>
