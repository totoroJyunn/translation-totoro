            <t id="" vertical="0" index="319" time="" torder="1" hasRuby="0">
                <start-time>00:17:43,045</start-time>
                <end-time>00:17:46,180</end-time>
                <translation>大多都是小气的</translation>
                <original>大抵はケチだったっていうふうに言っているんですよね</original>
                <spell/>
            </t>
            <t id="" vertical="0" index="320" time="" torder="1" hasRuby="0">
                <start-time>00:17:46,180</start-time>
                <end-time>00:17:47,590</end-time>
