            </t>
            <t id="" vertical="0" index="258" time="" torder="1" hasRuby="0">
                <start-time>00:14:09,765</start-time>
                <end-time>00:14:12,239</end-time>
                <translation>最终战死了</translation>
                <original>結局は戦死してしまうんですが</original>
                <spell/>
