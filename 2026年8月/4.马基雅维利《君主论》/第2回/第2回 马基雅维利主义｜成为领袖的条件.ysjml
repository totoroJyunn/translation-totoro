                <start-time>00:20:09,448</start-time>
                <end-time>00:20:10,960</end-time>
                <translation>是说野兽之中有两种吗</translation>
                <original>野獣の中に2つあるってことですか</original>
                <spell/>
            </t>
            <t id="" vertical="0" index="362" time="" torder="1" hasRuby="0">
