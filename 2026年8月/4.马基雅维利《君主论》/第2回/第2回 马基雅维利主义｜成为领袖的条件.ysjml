            </t>
            <t id="" vertical="0" index="119" time="" torder="1" hasRuby="0">
                <start-time>00:06:47,637</start-time>
                <end-time>00:06:49,930</end-time>
                <translation>切萨雷为了维持秩序</translation>
                <original>チェーザレは秩序を保つため</original>
                <spell/>
            </t>
            <t id="" vertical="0" index="120" time="" torder="1" hasRuby="0">
                <start-time>00:06:49,930</start-time>
                <end-time>00:06:53,900</end-time>
                <translation>任命家臣之一的奥尔科为该地的行政官</translation>
                <original>家臣の一人オルコをこの地の行政官に任命します</original>
                <spell/>
