            </t>
            <t id="" vertical="0" index="337" time="" torder="1" hasRuby="0">
                <start-time>00:18:44,603</start-time>
                <end-time>00:18:48,793</end-time>
                <translation>注视着君主的民众实际上是在远处</translation>
