            <t id="" vertical="0" index="126" time="" torder="1" hasRuby="0">
                <start-time>00:07:20,429</start-time>
                <end-time>00:07:23,629</end-time>
                <translation>却是处死奥尔科</translation>
                <original>オルコの処刑でした</original>
