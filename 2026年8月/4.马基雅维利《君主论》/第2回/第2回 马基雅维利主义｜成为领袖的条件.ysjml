                <spell/>
            </t>
            <t id="" vertical="0" index="156" time="" torder="1" hasRuby="0">
                <start-time>00:08:59,900</start-time>
                <end-time>00:09:02,010</end-time>
                <translation>是的 他说这不可能</translation>
                <original>そうです無理だと言っているんですね</original>
                <spell/>
            </t>
            <t id="" vertical="0" index="157" time="" torder="1" hasRuby="0">
                <start-time>00:09:02,010</start-time>
                <end-time>00:09:04,320</end-time>
                <translation>让我们来看看他的原话</translation>
