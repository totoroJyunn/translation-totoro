            <t id="" vertical="0" index="145" time="" torder="1" hasRuby="0">
                <start-time>00:08:28,549</start-time>
                <end-time>00:08:31,587</end-time>
                <translation>冷酷与仁慈</translation>
                <original>冷酷さと憐れみ深さ</original>
