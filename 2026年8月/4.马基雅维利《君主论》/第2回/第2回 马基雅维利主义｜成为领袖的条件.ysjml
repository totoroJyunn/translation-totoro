            </t>
            <t id="" vertical="0" index="253" time="" torder="1" hasRuby="0">
                <start-time>00:13:56,790</start-time>
                <end-time>00:13:57,760</end-time>
                <translation>后来怎么样了？</translation>
                <original>その後どうなんですか</original>
