            <t id="" vertical="0" index="121" time="" torder="1" hasRuby="0">
                <start-time>00:06:57,175</start-time>
                <end-time>00:07:00,215</end-time>
                <translation>冷酷无情的奥尔科加强了管制</translation>
                <original>冷徹なオルコは取り締まりを強化し</original>
                <spell/>
            </t>
            <t id="" vertical="0" index="122" time="" torder="1" hasRuby="0">
                <start-time>00:07:00,215</start-time>
                <end-time>00:07:05,014</end-time>
                <translation>在短时间内恢复了秩序
短期間で秩序を取り戻します</translation>
                <original/>
                <spell/>
            </t>
            <t id="" vertical="0" index="123" time="" torder="1" hasRuby="0">
                <start-time>00:07:05,014</start-time>
                <end-time>00:07:07,620</end-time>
                <translation>然而由于其过于严苛</translation>
