            </t>
            <t id="" vertical="0" index="332" time="" torder="1" hasRuby="0">
                <start-time>00:18:29,140</start-time>
                <end-time>00:18:32,058</end-time>
                <translation>君主相当需要一些不好的部分呢</translation>
