            <t id="" vertical="0" index="315" time="" torder="1" hasRuby="0">
                <start-time>00:17:29,600</start-time>
                <end-time>00:17:33,395</end-time>
                <translation>就是大方与小气</translation>
                <original>気前の良さとケチっていうことですよね</original>
                <spell/>
            </t>
            <t id="" vertical="0" index="316" time="" torder="1" hasRuby="0">
                <start-time>00:17:33,395</start-time>
                <end-time>00:17:35,325</end-time>
                <translation>虽说是小气</translation>
                <original>ケチと言いましても</original>
