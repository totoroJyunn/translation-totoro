            <t id="" vertical="0" index="146" time="" torder="1" hasRuby="0">
                <start-time>00:08:31,587</start-time>
                <end-time>00:08:35,240</end-time>
                <translation>令人畏惧与受人爱戴 究竟哪个更好</translation>
