            <t hasRuby="0" vertical="0" id="" time="" index="266" torder="1">
                <start-time>00:13:51,993</start-time>
                <end-time>00:13:54,397</end-time>
                <translation>而行动的行为</translation>
                <original>働いた行為でなければならぬ</original>
