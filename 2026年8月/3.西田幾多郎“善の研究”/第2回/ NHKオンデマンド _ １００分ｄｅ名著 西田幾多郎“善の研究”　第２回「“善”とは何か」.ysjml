            <t hasRuby="0" vertical="0" id="" time="" index="55" torder="1">
                <start-time>00:03:31,075</start-time>
                <end-time>00:03:34,025</end-time>
                <translation>首先 就刚刚开头部分提到的宗教而言</translation>
