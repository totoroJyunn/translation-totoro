            <t hasRuby="0" vertical="0" id="" time="" index="58" torder="1">
                <start-time>00:03:38,250</start-time>
                <end-time>00:03:40,825</end-time>
                <translation>嗯 现代人一提到宗教</translation>
                <original>あのうやっぱり現代人は宗教というと</original>
                <spell/>
