            </t>
            <t hasRuby="0" vertical="0" id="" time="" index="60" torder="1">
                <start-time>00:03:43,700</start-time>
                <end-time>00:03:44,875</end-time>
                <translation>其实并非如此</translation>
                <original>そうではなくて</original>
