            <t hasRuby="0" vertical="0" id="" time="" index="273" torder="1">
                <start-time>00:14:08,556</start-time>
                <end-time>00:14:09,740</end-time>
                <translation>能够做些什么的时候</translation>
                <original>何かできたとき</original>
