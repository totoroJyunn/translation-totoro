            <t hasRuby="0" vertical="0" id="" time="" index="61" torder="1">
                <start-time>00:03:44,875</start-time>
                <end-time>00:03:48,225</end-time>
                <translation>所谓“宗” 给人的印象是伟大的存在</translation>
