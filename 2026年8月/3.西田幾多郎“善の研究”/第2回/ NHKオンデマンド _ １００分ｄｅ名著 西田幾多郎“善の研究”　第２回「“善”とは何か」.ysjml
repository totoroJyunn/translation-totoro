            <t hasRuby="0" vertical="0" id="" time="" index="272" torder="1">
                <start-time>00:14:06,852</start-time>
                <end-time>00:14:08,556</end-time>
                <translation>真正为了大家</translation>
                <original>本当にみんなのために</original>
