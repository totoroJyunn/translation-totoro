                </marks>
                <start-time>00:06:45,750</start-time>
                <end-time>00:06:49,500</end-time>
                <translation>在讨论我们应当做什么、</translation>
                <original>我々は何を成すべきか</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="119" vertical="0" torder="1" time="">
                <marks>
