            <t hasRuby="0" id="" index="437" vertical="0" torder="1" time="">
                <start-time>00:23:35,160</start-time>
                <end-time>00:23:38,253</end-time>
                <translation>或许就有些浪费这本书了</translation>
                <original>少しもったいないことをしてしまうかもしれません</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="438" vertical="0" torder="1" time="">
                <start-time>00:23:38,253</start-time>
                <end-time>00:23:39,800</end-time>
                <translation>之后的内容也令人期待呢</translation>
