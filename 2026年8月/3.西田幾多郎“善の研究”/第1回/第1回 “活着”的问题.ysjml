                <start-time>00:07:03,750</start-time>
                <end-time>00:07:06,160</end-time>
                <translation>我们先必须阐明它</translation>
                <original>明らかにせねばならぬ</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="123" vertical="0" torder="1" time="">
                <start-time>00:07:08,480</start-time>
                <end-time>00:07:10,779</end-time>
