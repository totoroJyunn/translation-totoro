        <part updateMethod="0" lastModifyTime="0">
            <t hasRuby="0" id="" index="1" vertical="0" torder="1" time="">
                <start-time>00:00:02,275</start-time>
                <end-time>00:00:05,700</end-time>
                <translation>被誉为日本首部哲学著作的
日本最初の哲学書と言われる</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="2" vertical="0" torder="1" time="">
                <start-time>00:00:05,700</start-time>
                <end-time>00:00:08,800</end-time>
                <translation>西田几多郎的《善的研究》</translation>
                <original>西田幾多郎の善の研究</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="3" vertical="0" torder="1" time="">
                <start-time>00:00:11,150</start-time>
                <end-time>00:00:15,281</end-time>
                <translation>西田在明治末期 对“活着是什么”</translation>
                <original>西田は明治の終わりに生きるとは何か</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="4" vertical="0" torder="1" time="">
                <start-time>00:00:15,281</start-time>
                <end-time>00:00:19,100</end-time>
                <translation>这一人生的根本问题进行了格斗
という人生の根本的な問題と格闘し</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="5" vertical="0" torder="1" time="">
                <start-time>00:00:19,100</start-time>
                <end-time>00:00:22,175</end-time>
                <translation>由此诞生了日本独特的哲学
日本独自の哲学を誕生させました</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="6" vertical="0" torder="1" time="">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:00:24,680</start-time>
                <end-time>00:00:28,300</end-time>
                <translation>学问终究是为了life</translation>
                <original>学問は畢竟ライフのためなり</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="7" vertical="0" torder="1" time="">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:00:28,300</start-time>
                <end-time>00:00:30,900</end-time>
                <translation>life是第一等重要之事</translation>
                <original>ライフが第一等のことなり</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="8" vertical="0" torder="1" time="">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:00:30,900</start-time>
                <end-time>00:00:34,050</end-time>
                <translation>没有life的学问是无用的</translation>
                <original>ライフなき学問は無用なり</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="9" vertical="0" torder="1" time="">
                <start-time>00:00:35,600</start-time>
                <end-time>00:00:38,338</end-time>
                <translation>为了超越人生的悲哀</translation>
                <original>人生の悲哀を乗り越えるため</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="10" vertical="0" torder="1" time="">
                <start-time>00:00:38,338</start-time>
                <end-time>00:00:41,350</end-time>
                <translation>西田所追求的哲学是什么
西田が追い求めた哲学とは</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="11" vertical="0" torder="1" time="">
                <start-time>00:00:41,350</start-time>
                <end-time>00:00:43,520</end-time>
                <translation>我们将解读其真髓</translation>
                <original>その真髄を読み解いていきます</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="12" vertical="0" torder="1" time="">
                <start-time>00:01:02,500</start-time>
                <end-time>00:01:08,475</end-time>
                <translation>第1回 “活着”的问题</translation>
                <original>第1回　生きることの「問い」</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="13" vertical="0" torder="1" time="">
                <start-time>00:01:09,305</start-time>
                <end-time>00:01:11,680</end-time>
                <translation>《100分de名著》主持人　安部美智子
100分で名著司会の安部みちこです</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="14" vertical="0" torder="1" time="">
                <start-time>00:01:11,680</start-time>
                <end-time>00:01:12,975</end-time>
                <translation>伊集院光
伊集院光です</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="15" vertical="0" torder="1" time="">
                <start-time>00:01:12,975</start-time>
                <end-time>00:01:15,200</end-time>
                <translation>本月的名著是这本</translation>
                <original>今月の名著はこちらです</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="16" vertical="0" torder="1" time="">
                <start-time>00:01:15,200</start-time>
                <end-time>00:01:17,610</end-time>
                <translation>大约在100年前出版</translation>
                <original>およそ100年前に発表された</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="17" vertical="0" torder="1" time="">
                <start-time>00:01:17,610</start-time>
                <end-time>00:01:21,550</end-time>
                <translation>被誉为日本首部哲学著作的《善的研究》
日本で最初の哲学書と言われている善の研究です</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="18" vertical="0" torder="1" time="">
                <start-time>00:01:21,550</start-time>
                <end-time>00:01:22,460</end-time>
                <translation>有了解嘛？</translation>
                <original>ご存知でしたか</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="19" vertical="0" torder="1" time="">
                <start-time>00:01:22,460</start-time>
                <end-time>00:01:24,850</end-time>
                <translation>哎呀 我不太懂 就是讲善、讲好的书呗</translation>
                <original>いやーわからないです善グッドってことですね</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="20" vertical="0" torder="1" time="">
                <start-time>00:01:24,850</start-time>
                <end-time>00:01:29,500</end-time>
                <translation>我也是 甚至是对西田几多郎这个名字之前也不知道</translation>
                <original>私も西田幾多郎さんというお名前も存じ上げなかったんですけれども</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="21" vertical="0" torder="1" time="">
                <start-time>00:01:29,500</start-time>
                <end-time>00:01:30,925</end-time>
                <translation>俺也是（Me too）</translation>
                <original>ミートゥーでございます</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="22" vertical="0" torder="1" time="">
                <start-time>00:01:30,925</start-time>
                <end-time>00:01:33,593</end-time>
                <translation>但这本书即使是文库本也卖出了超过100万部</translation>
                <original>ただこれが文庫本でも100万部を超える</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="23" vertical="0" torder="1" time="">
                <start-time>00:01:33,593</start-time>
                <end-time>00:01:36,000</end-time>
                <translation>是一部超越时代的畅销书呢</translation>
                <original>という時代を超えたベストセラーなんですね</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="24" vertical="0" torder="1" time="">
                <start-time>00:01:36,000</start-time>
                <end-time>00:01:39,200</end-time>
                <translation>哇 既然能被这么多人阅读</translation>
                <original>うわーまあまあそれだけ読まれるっていうことは</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="25" vertical="0" torder="1" time="">
                <start-time>00:01:39,200</start-time>
                <end-time>00:01:41,650</end-time>
                <translation>而且还能成为这里的题材</translation>
                <original>まあまあそしてここの題材に上がるっていうことは</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="26" vertical="0" torder="1" time="">
                <start-time>00:01:41,650</start-time>
                <end-time>00:01:43,760</end-time>
                <translation>想必有很多值得学习的地方</translation>
                <original>学ぶべきことがいっぱいあるんでしょうから</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="27" vertical="0" torder="1" time="">
                <start-time>00:01:43,760</start-time>
                <end-time>00:01:45,850</end-time>
                <translation>我会努力的</translation>
                <original>頑張りますよ</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="28" vertical="0" torder="1" time="">
                <start-time>00:01:45,850</start-time>
                <end-time>00:01:48,300</end-time>
                <translation>那么 有请为我们讲解的老师</translation>
                <original>では教えてくださるをお呼びいたしましょう</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="29" vertical="0" torder="1" time="">
                <start-time>00:01:48,300</start-time>
                <end-time>00:01:50,450</end-time>
                <translation>评论家若松英辅
批評家の若松英輔さんです</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="30" vertical="0" torder="1" time="">
                <start-time>00:01:50,450</start-time>
                <end-time>00:01:52,580</end-time>
                <translation>请多关照</translation>
                <original>よろしくお願いいたします</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="31" vertical="0" torder="1" time="">
                <start-time>00:01:55,225</start-time>
                <end-time>00:01:58,950</end-time>
                <translation>批评家若松英辅老师
批評家の若松英輔さん</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="32" vertical="0" torder="1" time="">
                <start-time>00:01:58,950</start-time>
                <end-time>00:02:01,821</end-time>
                <translation>高中时代遇到了《善的研究》
高校時代に出会った善の研究を</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="33" vertical="0" torder="1" time="">
                <start-time>00:02:01,821</start-time>
                <end-time>00:02:05,275</end-time>
                <translation>在东日本大地震后又重读它
東日本大震災の後に読み直し</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="34" vertical="0" torder="1" time="">
                <start-time>00:02:05,275</start-time>
                <end-time>00:02:09,940</end-time>
                <translation>老师认为在众多悲伤中诞生的西田的哲学</translation>
                <original>多くの悲しみの中で生み出された西田の哲学は</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="35" vertical="0" torder="1" time="">
                <start-time>00:02:09,940</start-time>
                <end-time>00:02:12,675</end-time>
                <translation>在当代才更为必要</translation>
                <original>現代にこそ必要だと考えています</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="36" vertical="0" torder="1" time="">
                <start-time>00:02:14,800</start-time>
                <end-time>00:02:18,338</end-time>
                <translation>若松老师 这部作品大概相当难懂</translation>
                <original>若松さんこの作品はかなり難しいと思うんですが</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="37" vertical="0" torder="1" time="">
                <start-time>00:02:18,338</start-time>
                <end-time>00:02:20,500</end-time>
                <translation>为什么你想现在来解读它呢？</translation>
                <original>なぜ今取り上げようと思われたんですか</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="38" vertical="0" torder="1" time="">
                <start-time>00:02:20,500</start-time>
                <end-time>00:02:22,360</end-time>
                <translation>是啊 是啊其中一个原因是关于我们</translation>
                <original>そうですねそうですね一つは私たちの</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="39" vertical="0" torder="1" time="">
                <start-time>00:02:22,360</start-time>
                <end-time>00:02:25,020</end-time>
                <translation>要先拥有的“思考”的力量</translation>
                <original>まず考えるっていう力ですよね</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="40" vertical="0" torder="1" time="">
                <start-time>00:02:25,020</start-time>
                <end-time>00:02:27,125</end-time>
                <translation>这种“思考”的力量</translation>
                <original>あの考えるって力が</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="41" vertical="0" torder="1" time="">
                <start-time>00:02:27,125</start-time>
                <end-time>00:02:29,516</end-time>
                <translation>出乎意料的 我们是不是不太常用到呢</translation>
                <original>意外と使われてないんじゃないかっていうのが</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="42" vertical="0" torder="1" time="">
                <start-time>00:02:29,516</start-time>
                <end-time>00:02:31,375</end-time>
                <translation>这是值得我们重新思考的点</translation>
                <original>思い直すところがあるんです</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="43" vertical="0" torder="1" time="">
                <start-time>00:02:31,375</start-time>
                <end-time>00:02:35,955</end-time>
                <translation>另外还有一点 现在这里展示了一张照片</translation>
                <original>あとはもう一つあの今こちらにあの写真が出ていますけども</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="44" vertical="0" torder="1" time="">
                <start-time>00:02:35,955</start-time>
                <end-time>00:02:38,675</end-time>
                <translation>这是战后昭和22年（1947年）的事</translation>
                <original>あのこれ戦後昭和22年ですね</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="45" vertical="0" torder="1" time="">
                <start-time>00:02:38,675</start-time>
                <end-time>00:02:41,520</end-time>
                <translation>在《西田几多郎全集》发行时</translation>
                <original>あの西田幾多郎全集が刊行されたときに</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="46" vertical="0" torder="1" time="">
                <start-time>00:02:41,520</start-time>
                <end-time>00:02:44,575</end-time>
                <translation>人们彻夜排队购买</translation>
                <original>人々が徹夜して買ってるんです</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="47" vertical="0" torder="1" time="">
                <start-time>00:02:44,575</start-time>
                <end-time>00:02:46,799</end-time>
                <translation>哇 太厉害了</translation>
                <original>うわすごいな</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="48" vertical="0" torder="1" time="">
                <start-time>00:02:46,799</start-time>
                <end-time>00:02:49,169</end-time>
                <translation>而且说到昭和22年</translation>
                <original>でしかも昭和22年って言ったら</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="49" vertical="0" torder="1" time="">
                <start-time>00:02:49,169</start-time>
                <end-time>00:02:52,160</end-time>
                <translation>那并不是大家因为钱多而买书的时代吧</translation>
                <original>みんなお金が余ってるから本買おうって時じゃないですよね</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="50" vertical="0" torder="1" time="">
                <start-time>00:02:52,160</start-time>
                <end-time>00:02:53,125</end-time>
                <translation>确实如此</translation>
                <original>そうなんですよね</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="51" vertical="0" torder="1" time="">
                <start-time>00:02:53,125</start-time>
                <end-time>00:02:54,100</end-time>
                <translation>人们翘首以盼啊</translation>
                <original>待ちわびてたんですね</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="52" vertical="0" torder="1" time="">
                <start-time>00:02:54,100</start-time>
                <end-time>00:02:59,125</end-time>
                <translation>是啊 真的感觉是在寻求精神食粮</translation>
                <original>そうなんですね本当にこう心の糧を求める感じなんだと思うんですね</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="53" vertical="0" torder="1" time="">
                <start-time>00:02:59,125</start-time>
                <end-time>00:03:02,982</end-time>
                <translation>自己当时所匮乏的不仅仅是食物</translation>
                <original>自分たちが飢えてたのはいわゆるこう食べ物だけではなくて</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="54" vertical="0" torder="1" time="">
                <start-time>00:03:02,982</start-time>
                <end-time>00:03:05,285</end-time>
                <translation>精神食粮、心灵的食物
心の糧心の食べ物も</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="55" vertical="0" torder="1" time="">
                <start-time>00:03:05,285</start-time>
                <end-time>00:03:06,980</end-time>
                <translation>是不是也处于匮乏状态呢</translation>
                <original>飢えてたんじゃないだろうかってことに</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="56" vertical="0" torder="1" time="">
                <start-time>00:03:06,980</start-time>
                <end-time>00:03:10,050</end-time>
                <translation>人们开始意识到这点</translation>
                <original>人々が気がつき始めてる感じだと思うんですね</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="57" vertical="0" torder="1" time="">
                <start-time>00:03:10,050</start-time>
                <end-time>00:03:13,693</end-time>
                <translation>而现在 我们虽然食物充足</translation>
                <original>で今私たちも食べ物はたくさんあるわけですけども</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="58" vertical="0" torder="1" time="">
                <start-time>00:03:13,693</start-time>
                <end-time>00:03:17,875</end-time>
                <translation>但或许精神食粮方面反而有些不足</translation>
                <original>もしかしたら少し心の糧の方が足りないかもしれない</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="59" vertical="0" torder="1" time="">
                <start-time>00:03:17,875</start-time>
                <end-time>00:03:21,701</end-time>
                <translation>而这会不会就是哲学能给予我们的某种东西呢</translation>
                <original>でそれは哲学っていうのが私たちに与えてくれる何かなんじゃないか</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="60" vertical="0" torder="1" time="">
                <start-time>00:03:21,701</start-time>
                <end-time>00:03:24,600</end-time>
                <translation>今天想和大家一起思考一下这个问题</translation>
                <original>ってちょっと皆さんと今日考えてみたいと思っています</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="61" vertical="0" torder="1" time="">
                <start-time>00:03:24,600</start-time>
                <end-time>00:03:27,050</end-time>
                <translation>好的 那么我们先从基本信息看起</translation>
                <original>はいでは基本情報から見ていきましょう</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="62" vertical="0" torder="1" time="">
                <start-time>00:03:28,575</start-time>
                <end-time>00:03:32,312</end-time>
                <translation>首先 这是一本于明治44年（1911年）出版的哲学书
まず明治44年に出版された哲学書で</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="63" vertical="0" torder="1" time="">
                <start-time>00:03:32,312</start-time>
                <end-time>00:03:35,325</end-time>
                <translation>作者是哲学家西田几多郎
作者は哲学者の西田幾多郎です</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="64" vertical="0" torder="1" time="">
                <start-time>00:03:35,325</start-time>
                <end-time>00:03:40,325</end-time>
                <translation>这本书基于西田在高等学校的讲义录和发表在杂志上的论文
西田の高等学校での講義録や雑誌に発表した論文が元になっています</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="65" vertical="0" torder="1" time="">
                <start-time>00:03:40,325</start-time>
                <end-time>00:03:43,675</end-time>
                <translation>不过 当时没过多久就绝版了</translation>
                <original>ただその時はほどなくして絶版になりました</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="66" vertical="0" torder="1" time="">
                <start-time>00:03:43,675</start-time>
                <end-time>00:03:48,027</end-time>
                <translation>后来 大正时代的流行作家仓田百三
その後大正時代の流行作家である倉田百三が</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="67" vertical="0" torder="1" time="">
                <start-time>00:03:48,027</start-time>
                <end-time>00:03:49,680</end-time>
                <translation>在自己的著作中提及后</translation>
                <original>著作で言及してからは</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="68" vertical="0" torder="1" time="">
                <start-time>00:03:49,680</start-time>
                <end-time>00:03:51,965</end-time>
                <translation>读者要求再版的呼声蜂拥而至</translation>
                <original>再版を求める声が殺到し</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="69" vertical="0" torder="1" time="">
                <start-time>00:03:51,965</start-time>
                <end-time>00:03:53,325</end-time>
                <translation>便再版了</translation>
                <original>再版されたんですね</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="70" vertical="0" torder="1" time="">
                <start-time>00:03:53,325</start-time>
                <end-time>00:03:56,803</end-time>
                <translation>这是本诞生在西洋哲学研究为主流的时代的
で西洋哲学の研究が主だった時代に誕生した</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="71" vertical="0" torder="1" time="">
                <start-time>00:03:56,803</start-time>
                <end-time>00:04:00,075</end-time>
                <translation>被认为是日本第一本哲学书</translation>
                <original>これが日本で最初の哲学書とされています</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="72" vertical="0" torder="1" time="">
                <start-time>00:04:00,075</start-time>
                <end-time>00:04:03,400</end-time>
                <translation>在这本书问世之前 日本是没有哲学的</translation>
                <original>この本が出るまで日本に哲学がないんです</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="73" vertical="0" torder="1" time="">
                <start-time>00:04:04,450</start-time>
                <end-time>00:04:05,475</end-time>
                <translation>没有的啊</translation>
                <original>なかったんですね</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="74" vertical="0" torder="1" time="">
                <start-time>00:04:05,475</start-time>
                <end-time>00:04:10,050</end-time>
                <translation>也就是说 没有我们今天所认为的那种哲学</translation>
                <original>いわゆる私たちが今日考えるような哲学はないんですね</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="75" vertical="0" torder="1" time="">
                <start-time>00:04:10,050</start-time>
                <end-time>00:04:13,620</end-time>
                <translation>就是通过西田的这本《善的研究》</translation>
                <original>ですので西田さんのこの善の研究と本によって</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="76" vertical="0" torder="1" time="">
                <start-time>00:04:13,620</start-time>
                <end-time>00:04:16,425</end-time>
                <translation>打开了道路 这一点非常重要</translation>
                <original>道が開かれていったっていうのが大変重要な</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="77" vertical="0" torder="1" time="">
                <start-time>00:04:16,425</start-time>
                <end-time>00:04:19,359</end-time>
                <translation>说起来 在这个节目里也</translation>
                <original>なんか割とこの番組でも</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="78" vertical="0" torder="1" time="">
                <start-time>00:04:19,359</start-time>
                <end-time>00:04:23,100</end-time>
                <translation>出现过相当古老的哲学书</translation>
                <original>かなり古い哲学書みたいなの出てきますけど</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="79" vertical="0" torder="1" time="">
                <start-time>00:04:23,100</start-time>
                <end-time>00:04:24,980</end-time>
                <translation>的确是啊 那些都是国外的啊</translation>
                <original>そうかあれは海外のものなのか</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="80" vertical="0" torder="1" time="">
                <start-time>00:04:24,980</start-time>
                <end-time>00:04:25,460</end-time>
                <translation>是啊</translation>
                <original>そうなんです</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="81" vertical="0" torder="1" time="">
                <start-time>00:04:25,460</start-time>
                <end-time>00:04:26,425</end-time>
                <translation>这么回事啊</translation>
                <original>そういうことですね</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="82" vertical="0" torder="1" time="">
                <start-time>00:04:26,425</start-time>
                <end-time>00:04:26,940</end-time>
                <translation>是的</translation>
                <original>そうなんです</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="83" vertical="0" torder="1" time="">
                <start-time>00:04:26,940</start-time>
                <end-time>00:04:28,400</end-time>
                <translation>果然还要母语啊</translation>
                <original>やはり母語ですね</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="84" vertical="0" torder="1" time="">
                <start-time>00:04:28,400</start-time>
                <end-time>00:04:29,800</end-time>
                <translation>我们的母语 
私たちの母語</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="85" vertical="0" torder="1" time="">
                <start-time>00:04:29,800</start-time>
                <end-time>00:04:33,320</end-time>
                <translation>用母语来进行哲学思考</translation>
                <original>それによって哲学をするっていう</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="86" vertical="0" torder="1" time="">
                <start-time>00:04:33,320</start-time>
                <end-time>00:04:35,250</end-time>
                <translation>这样的一种尝试呢</translation>
                <original>そういう試みですね</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="87" vertical="0" torder="1" time="">
                <start-time>00:04:35,250</start-time>
                <end-time>00:04:38,775</end-time>
                <translation>我会觉得这意义很重大吧</translation>
                <original>僕それは大きいような気がします</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="88" vertical="0" torder="1" time="">
                <start-time>00:04:38,775</start-time>
                <end-time>00:04:42,048</end-time>
                <translation>读外国人写的书时</translation>
                <original>海外の方の書かれた本に</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="89" vertical="0" torder="1" time="">
                <start-time>00:04:42,048</start-time>
                <end-time>00:04:45,875</end-time>
                <translation>有时会有些地方总觉得不太对劲</translation>
                <original>ちょっとだけこうなんかしっくり入らないものがあったりする</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="90" vertical="0" torder="1" time="">
                <start-time>00:04:45,875</start-time>
                <end-time>00:04:48,180</end-time>
                <translation>从这个意义上说</translation>
                <original>そういうことで言うと</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="91" vertical="0" torder="1" time="">
                <start-time>00:04:48,180</start-time>
                <end-time>00:04:51,120</end-time>
                <translation>用母语、本国语言来书写</translation>
                <original>その母語母国語で書かれる</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="92" vertical="0" torder="1" time="">
                <start-time>00:04:51,120</start-time>
                <end-time>00:04:53,026</end-time>
                <translation>而且还是对人的本质发问</translation>
                <original>ましてその人とはとか</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="93" vertical="0" torder="1" time="">
                <start-time>00:04:53,026</start-time>
                <end-time>00:04:55,895</end-time>
                <translation>写出那样的内容</translation>
                <original>そういうことを書いてもらうのは</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="94" vertical="0" torder="1" time="">
                <start-time>00:04:55,895</start-time>
                <end-time>00:04:57,320</end-time>
                <translation>大概是非常重要的吧</translation>
                <original>すごく重要なことかしら</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="95" vertical="0" torder="1" time="">
                <start-time>00:04:57,320</start-time>
                <end-time>00:04:58,450</end-time>
                <translation>是呢</translation>
                <original>そうですね</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="96" vertical="0" torder="1" time="">
                <start-time>00:04:58,450</start-time>
                <end-time>00:05:03,150</end-time>
                <translation>那么 接下来我们就来看看《善的研究》是如何诞生的吧</translation>
                <original>さあそれでは善の研究がどのようにして生まれたのかから見ていきましょう</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="97" vertical="0" torder="1" time="">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:05:04,975</start-time>
                <end-time>00:05:09,850</end-time>
                <translation>本书之所以特意命名为《善的研究》</translation>
                <original>この書を特に善の研究と名付けたわけは</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="98" vertical="0" torder="1" time="">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:05:09,850</start-time>
                <end-time>00:05:15,075</end-time>
                <translation>是因为尽管哲学研究占据了前半部分</translation>
                <original>哲学的研究がその前半を占め居るにもかかわらず</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="99" vertical="0" torder="1" time="">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:05:15,075</start-time>
                <end-time>00:05:18,175</end-time>
                <translation>但人生问题才是其中心 
人生の問題が中心であり</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="100" vertical="0" torder="1" time="">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:05:18,175</start-time>
                <end-time>00:05:21,300</end-time>
                <translation>也是其终结</translation>
                <original>終結であると考えたゆえである</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="101" vertical="0" torder="1" time="">
                <start-time>00:05:24,125</start-time>
                <end-time>00:05:28,650</end-time>
                <translation>在明治末期 日本正奔驰于文明开化之路</translation>
                <original>文明開化の道を駆け上がっていた明治の終わり</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="102" vertical="0" torder="1" time="">
                <start-time>00:05:28,650</start-time>
                <end-time>00:05:33,800</end-time>
                <translation>哲学仍满足于启蒙西洋思想的时代 
まだ哲学が西洋思想の啓蒙に甘んじていた時代に</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="103" vertical="0" torder="1" time="">
                <start-time>00:05:33,800</start-time>
                <end-time>00:05:36,369</end-time>
                <translation>西田几多郎却将哲学的动机彻底地
哲学の動機を徹底して</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="104" vertical="0" torder="1" time="">
                <start-time>00:05:36,369</start-time>
                <end-time>00:05:41,950</end-time>
                <translation>视为人生问题
人生の問題だと考えた西田幾多郎</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="105" vertical="0" torder="1" time="">
                <start-time>00:05:41,950</start-time>
                <end-time>00:05:44,350</end-time>
                <translation>在撰写《善的研究》期间 
善の研究の執筆中</translation>
                <original/>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="106" vertical="0" torder="1" time="">
                <start-time>00:05:44,350</start-time>
                <end-time>00:05:48,995</end-time>
                <translation>他接连失去两个女儿 当时的心境如此写道：</translation>
                <original>二人の娘を相次いで亡くした時の思いをこう書いています</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="107" vertical="0" torder="1" time="">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:05:50,820</start-time>
                <end-time>00:05:56,575</end-time>
                <translation>“倘若人生仅此而已</translation>
                <original>もし人生はこれまでのものであるというならば</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="108" vertical="0" torder="1" time="">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:05:56,575</start-time>
                <end-time>00:06:00,050</end-time>
                <translation>那再没有比人生更无聊的东西了</translation>
                <original>人生ほどつまらぬものはない</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="109" vertical="0" torder="1" time="">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:06:00,050</start-time>
                <end-time>00:06:03,545</end-time>
                <translation>这其中必定蕴含着深刻的意义”</translation>
                <original>ここには深き意味がなくてはならぬ</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="110" vertical="0" torder="1" time="">
                <start-time>00:06:06,545</start-time>
                <end-time>00:06:11,880</end-time>
                <translation>对西田而言 追求真理与人生问题</translation>
                <original>西田にとって真理を求めることと人生の問題は</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="111" vertical="0" torder="1" time="">
                <start-time>00:06:11,880</start-time>
                <end-time>00:06:14,100</end-time>
                <translation>是密不可分的</translation>
                <original>分かちがたいものとしてありました</original>
                <spell/>
            </t>
            <t hasRuby="0" id="" index="112" vertical="0" torder="1" time="">
                <marks>
