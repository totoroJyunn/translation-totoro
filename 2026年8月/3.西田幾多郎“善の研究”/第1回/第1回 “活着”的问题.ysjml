            <t hasRuby="0" id="" index="153" vertical="0" torder="1" time="">
                <start-time>00:08:58,609</start-time>
                <end-time>00:09:00,140</end-time>
                <translation>这是在说什么呢？</translation>
                <original>これはどういうことを言っているんでしょうか</original>
                <spell/>
