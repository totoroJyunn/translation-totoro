            </t>
            <t vertical="0" index="355" torder="1" hasRuby="0" id="" time="">
                <start-time>00:20:56,121</start-time>
                <end-time>00:20:58,725</end-time>
                <translation>似乎存在着一个更宏大的“我”</translation>
