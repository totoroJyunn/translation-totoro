            <t vertical="0" index="91" torder="1" hasRuby="0" id="" time="">
                <start-time>00:05:54,750</start-time>
                <end-time>00:05:57,375</end-time>
                <translation>这种个人的悲伤</translation>
                <original>そういう個人の悲しみが</original>
