            <t vertical="0" index="103" torder="1" hasRuby="0" id="" time="">
                <start-time>00:06:31,224</start-time>
                <end-time>00:06:33,975</end-time>
                <translation>是一个非常有名的表述</translation>
                <original>言われているほど有名な表現なんですけれども</original>
