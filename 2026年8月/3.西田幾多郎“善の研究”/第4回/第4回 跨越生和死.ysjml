            </t>
            <t vertical="0" index="297" torder="1" hasRuby="0" id="" time="">
                <start-time>00:17:09,125</start-time>
                <end-time>00:17:11,000</end-time>
                <translation>就能变成那样</translation>
                <original>そういうふうにできちゃうんですよね</original>
                <spell/>
            </t>
            <t vertical="0" index="298" torder="1" hasRuby="0" id="" time="">
                <start-time>00:17:11,000</start-time>
                <end-time>00:17:11,864</end-time>
                <translation>是能变成那样的</translation>
                <original>できちゃうんです</original>
                <spell/>
