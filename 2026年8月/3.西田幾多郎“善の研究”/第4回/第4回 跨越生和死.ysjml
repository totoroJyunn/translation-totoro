        <part updateMethod="0" lastModifyTime="0">
            <t vertical="0" index="1" torder="1" hasRuby="0" id="" time="">
                <start-time>00:00:03,725</start-time>
                <end-time>00:00:07,625</end-time>
                <translation>在《善的研究》完成之后
善の研究の完工後も</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" index="2" torder="1" hasRuby="0" id="" time="">
                <start-time>00:00:07,625</start-time>
                <end-time>00:00:10,485</end-time>
                <translation>西田进一步发展了自己的哲学</translation>
                <original>西田はさらに自らの哲学を発展させていきます</original>
                <spell/>
            </t>
            <t vertical="0" index="3" torder="1" hasRuby="0" id="" time="">
                <start-time>00:00:12,460</start-time>
                <end-time>00:00:19,505</end-time>
                <translation>最终他抵达了自身思想的终点 人是矛盾的存在</translation>
                <original>そしてたどり着いたのが人間は矛盾的存在であるという考え方でした</original>
                <spell/>
            </t>
            <t vertical="0" index="4" torder="1" hasRuby="0" id="" time="">
                <start-time>00:00:21,355</start-time>
                <end-time>00:00:23,590</end-time>
                <translation>由此 生与死</translation>
                <original>そこから生と死</original>
                <spell/>
            </t>
            <t vertical="0" index="5" torder="1" hasRuby="0" id="" time="">
                <start-time>00:00:23,590</start-time>
                <end-time>00:00:26,159</end-time>
                <translation>善与恶等相互矛盾
善と悪など矛盾し</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" index="6" torder="1" hasRuby="0" id="" time="">
                <start-time>00:00:26,159</start-time>
                <end-time>00:00:28,440</end-time>
                <translation>能超越对立事物的
対立するものを乗り越える</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" index="7" torder="1" hasRuby="0" id="" time="">
                <start-time>00:00:28,440</start-time>
                <end-time>00:00:33,140</end-time>
                <translation>“绝对矛盾的自我同一”思想便诞生了
絶対矛盾的自己同一という思想が生まれます</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" index="8" torder="1" hasRuby="0" id="" time="">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:00:35,250</start-time>
                <end-time>00:00:39,800</end-time>
                <translation>人是人 我是我 各行其是</translation>
                <original>人は人、吾は吾也とにかくに</original>
                <spell/>
            </t>
            <t vertical="0" index="9" torder="1" hasRuby="0" id="" time="">
                <marks>
                    <mark top="">默认标记</mark>
                </marks>
                <start-time>00:00:39,800</start-time>
                <end-time>00:00:43,625</end-time>
                <translation>我自行我道</translation>
                <original>吾ゆく道吾はゆくなり</original>
                <spell/>
            </t>
            <t vertical="0" index="10" torder="1" hasRuby="0" id="" time="">
                <start-time>00:00:44,390</start-time>
                <end-time>00:00:46,746</end-time>
                <translation>我们将解读在艰苦卓绝的探索之后
悪戦苦闘の施策の末に</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" index="11" torder="1" hasRuby="0" id="" time="">
                <start-time>00:00:46,746</start-time>
                <end-time>00:00:50,280</end-time>
                <translation>西田最终达到的境界</translation>
                <original>西田が到達した境地を読み解いていきます</original>
                <spell/>
            </t>
            <t vertical="0" index="12" torder="1" hasRuby="0" id="" time="">
                <start-time>00:01:11,075</start-time>
                <end-time>00:01:16,900</end-time>
                <translation>第4回 超越“生”与“死”
第4回　「生」と「死」を超えて</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" index="13" torder="1" hasRuby="0" id="" time="">
                <start-time>00:01:17,480</start-time>
                <end-time>00:01:19,800</end-time>
                <translation>100分de名著的主持人安部美智子
100分で名著司会の安部みちこです</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" index="14" torder="1" hasRuby="0" id="" time="">
                <start-time>00:01:19,825</start-time>
                <end-time>00:01:20,850</end-time>
                <translation>伊集院光
伊集院光です</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" index="15" torder="1" hasRuby="0" id="" time="">
                <start-time>00:01:20,872</start-time>
                <end-time>00:01:22,348</end-time>
                <translation>我们从后面开始读起的</translation>
                <original>後ろから読んできました</original>
                <spell/>
            </t>
            <t vertical="0" index="16" torder="1" hasRuby="0" id="" time="">
                <start-time>00:01:22,348</start-time>
                <end-time>00:01:24,818</end-time>
                <translation>《善的研究》在上一回就结束了</translation>
                <original>善の研究も前回で終わりましたが</original>
                <spell/>
            </t>
            <t vertical="0" index="17" torder="1" hasRuby="0" id="" time="">
                <start-time>00:01:24,818</start-time>
                <end-time>00:01:25,675</end-time>
                <translation>感觉如何？</translation>
                <original>いかがでしたか</original>
                <spell/>
            </t>
            <t vertical="0" index="18" torder="1" hasRuby="0" id="" time="">
                <start-time>00:01:25,675</start-time>
                <end-time>00:01:28,260</end-time>
                <translation>这无疑是一本晦涩难懂的书</translation>
                <original>難解な本だったのは間違いないんですけども</original>
                <spell/>
            </t>
            <t vertical="0" index="19" torder="1" hasRuby="0" id="" time="">
                <start-time>00:01:28,260</start-time>
                <end-time>00:01:31,100</end-time>
                <translation>其中也有一些内容触动了我</translation>
                <original>でも自分の中に刺さったことがいくつあって</original>
                <spell/>
            </t>
            <t vertical="0" index="20" torder="1" hasRuby="0" id="" time="">
                <start-time>00:01:31,100</start-time>
                <end-time>00:01:35,900</end-time>
                <translation>我开始思考 对于现在这种纯粹的经验</translation>
                <original>自分は今この純粋な経験みたいなこと</original>
                <spell/>
            </t>
            <t vertical="0" index="21" torder="1" hasRuby="0" id="" time="">
                <start-time>00:01:35,900</start-time>
                <end-time>00:01:38,698</end-time>
                <translation>自己是否给予了足够的尊重</translation>
                <original>に対してきちんと敬意を払えているかどうかぐらいのことは</original>
                <spell/>
            </t>
            <t vertical="0" index="22" torder="1" hasRuby="0" id="" time="">
                <start-time>00:01:38,698</start-time>
                <end-time>00:01:40,200</end-time>
                <translation>至少会开始思考这类问题了</translation>
                <original>考えるようになりました</original>
                <spell/>
            </t>
            <t vertical="0" index="23" torder="1" hasRuby="0" id="" time="">
                <start-time>00:01:40,200</start-time>
                <end-time>00:01:42,900</end-time>
                <translation>是啊 对日常怀有敬意</translation>
                <original>そうですね日常に敬意を</original>
                <spell/>
            </t>
            <t vertical="0" index="24" torder="1" hasRuby="0" id="" time="">
                <start-time>00:01:42,900</start-time>
                <end-time>00:01:44,780</end-time>
                <translation>下面介绍我们的指南老师
指南役の先生をご紹介します</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" index="25" torder="1" hasRuby="0" id="" time="">
                <start-time>00:01:44,780</start-time>
                <end-time>00:01:46,740</end-time>
                <translation>评论家若松英辅先生
批評家の若松英輔さんです</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" index="26" torder="1" hasRuby="0" id="" time="">
                <start-time>00:01:46,740</start-time>
                <end-time>00:01:49,050</end-time>
                <translation>有请</translation>
                <original>お願いいたします</original>
                <spell/>
            </t>
            <t vertical="0" index="27" torder="1" hasRuby="0" id="" time="">
                <start-time>00:01:49,050</start-time>
                <end-time>00:01:51,700</end-time>
                <translation>这次您要教我们些什么呢？</translation>
                <original>今回は何を教えていただけるんでしょうか</original>
                <spell/>
            </t>
            <t vertical="0" index="28" torder="1" hasRuby="0" id="" time="">
                <start-time>00:01:51,700</start-time>
                <end-time>00:01:54,280</end-time>
                <translation>今天我们来谈谈他的生平
今日は彼の生涯ですえ</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" index="29" torder="1" hasRuby="0" id="" time="">
                <start-time>00:01:54,280</start-time>
                <end-time>00:01:55,760</end-time>
                <translation>在他的生涯中</translation>
                <original>彼の生涯の中で</original>
                <spell/>
            </t>
            <t vertical="0" index="30" torder="1" hasRuby="0" id="" time="">
                <start-time>00:01:55,760</start-time>
                <end-time>00:01:57,951</end-time>
                <translation>哲学是如何不断深化的</translation>
                <original>哲学がどう深まっていったのか</original>
                <spell/>
            </t>
            <t vertical="0" index="31" torder="1" hasRuby="0" id="" time="">
                <start-time>00:01:57,951</start-time>
                <end-time>00:02:01,950</end-time>
                <translation>这就是我今天想和大家一起思考一下的</translation>
                <original>ということをちょっと皆さんと考えてみたいなというふうに思っております</original>
                <spell/>
            </t>
            <t vertical="0" index="32" torder="1" hasRuby="0" id="" time="">
                <start-time>00:02:01,950</start-time>
                <end-time>00:02:04,995</end-time>
                <translation>好的 那么首先请看这边</translation>
                <original>はいではまずこちらをご覧ください</original>
                <spell/>
            </t>
            <t vertical="0" index="33" torder="1" hasRuby="0" id="" time="">
                <start-time>00:02:09,070</start-time>
                <end-time>00:02:12,225</end-time>
                <translation>《善的研究》发表两年后
善の研究の発表から2年</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" index="34" torder="1" hasRuby="0" id="" time="">
                <start-time>00:02:12,225</start-time>
                <end-time>00:02:15,000</end-time>
                <translation>大正民主时代到来了</translation>
                <original>大正デモクラシーの時代が到来しました</original>
                <spell/>
            </t>
            <t vertical="0" index="35" torder="1" hasRuby="0" id="" time="">
                <start-time>00:02:18,100</start-time>
                <end-time>00:02:22,000</end-time>
                <translation>西田赴任京都帝国大学
西田は京都帝国大学に赴任</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" index="36" torder="1" hasRuby="0" id="" time="">
                <start-time>00:02:22,000</start-time>
                <end-time>00:02:24,444</end-time>
                <translation>此后长达18年</translation>
                <original>その後18年にわたって</original>
                <spell/>
            </t>
            <t vertical="0" index="37" torder="1" hasRuby="0" id="" time="">
                <start-time>00:02:24,444</start-time>
                <end-time>00:02:28,625</end-time>
                <translation>培养了三木清等众多哲学家</translation>
                <original>三木清など多くの哲学者を育てていきます</original>
                <spell/>
            </t>
            <t vertical="0" index="38" torder="1" hasRuby="0" id="" time="">
                <start-time>00:02:30,450</start-time>
                <end-time>00:02:35,000</end-time>
                <translation>不久 他的哲学不再以自我为主体</translation>
                <original>やがてその哲学は自己を主体としてではなく</original>
                <spell/>
            </t>
            <t vertical="0" index="39" torder="1" hasRuby="0" id="" time="">
                <start-time>00:02:35,000</start-time>
                <end-time>00:02:39,155</end-time>
                <translation>而是发展为捕捉“场所”的独特哲学</translation>
                <original>場所と捉える独自の哲学へと発展していきます</original>
                <spell/>
            </t>
            <t vertical="0" index="40" torder="1" hasRuby="0" id="" time="">
                <start-time>00:02:42,380</start-time>
                <end-time>00:02:45,331</end-time>
                <translation>另一方面 从大正7年开始
一方大正7年から</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" index="41" torder="1" hasRuby="0" id="" time="">
                <start-time>00:02:45,331</start-time>
                <end-time>00:02:49,525</end-time>
                <translation>接踵而至的不幸再次袭击了西田
相次ぐ不幸が再び西田を襲いました</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" index="42" torder="1" hasRuby="0" id="" time="">
                <start-time>00:02:49,525</start-time>
                <end-time>00:02:51,525</end-time>
                <translation>母亲去世
母親の死</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" index="43" torder="1" hasRuby="0" id="" time="">
                <start-time>00:02:51,525</start-time>
                <end-time>00:02:57,975</end-time>
                <translation>一直支持他的妻子因脑溢血倒下</translation>
                <original>そして支え続けてくれた妻が脳出血で倒れます</original>
                <spell/>
            </t>
            <t vertical="0" index="44" torder="1" hasRuby="0" id="" time="">
                <start-time>00:02:57,975</start-time>
                <end-time>00:03:03,060</end-time>
                <translation>翌年 年仅22岁的长子去世</translation>
                <original>翌年にはまだ22歳の若さで長男が亡くなり</original>
                <spell/>
            </t>
            <t vertical="0" index="45" torder="1" hasRuby="0" id="" time="">
                <start-time>00:03:03,060</start-time>
                <end-time>00:03:08,875</end-time>
                <translation>三女、四女、六女也病倒了
3女4女6女も病に倒れ</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" index="46" torder="1" hasRuby="0" id="" time="">
                <start-time>00:03:08,875</start-time>
                <end-time>00:03:12,820</end-time>
                <translation>拼命的看护也徒劳无功 妻子去世了</translation>
                <original>必死の看病もむなしく妻は亡くなります</original>
                <spell/>
            </t>
            <t vertical="0" index="47" torder="1" hasRuby="0" id="" time="">
                <start-time>00:03:16,170</start-time>
                <end-time>00:03:20,775</end-time>
                <translation>深切地厌倦了这人生</translation>
                <original>しみじみとこの人生を厭いけり</original>
                <spell/>
            </t>
            <t vertical="0" index="48" torder="1" hasRuby="0" id="" time="">
                <start-time>00:03:20,775</start-time>
                <end-time>00:03:24,020</end-time>
                <translation>如同今日的冬日一般</translation>
                <original>けふこの頃の冬の日のごと</original>
                <spell/>
            </t>
            <t vertical="0" index="49" torder="1" hasRuby="0" id="" time="">
                <start-time>00:03:26,520</start-time>
                <end-time>00:03:31,575</end-time>
                <translation>存在并活着这件事本身就是悲哀</translation>
                <original>存在し生きることそのものが悲哀である</original>
                <spell/>
            </t>
            <t vertical="0" index="50" torder="1" hasRuby="0" id="" time="">
                <start-time>00:03:31,575</start-time>
                <end-time>00:03:33,725</end-time>
                <translation>这种人生观</translation>
                <original>というその人生観は</original>
                <spell/>
            </t>
            <t vertical="0" index="51" torder="1" hasRuby="0" id="" time="">
                <start-time>00:03:33,725</start-time>
                <end-time>00:03:39,250</end-time>
                <translation>不久将西田引向了自我存在的矛盾性这一思想</translation>
                <original>やがて自己存在の矛盾性という思想へ西田を導きました</original>
                <spell/>
            </t>
            <t vertical="0" index="52" torder="1" hasRuby="0" id="" time="">
                <start-time>00:03:40,475</start-time>
                <end-time>00:03:43,122</end-time>
                <translation>然后 昭和14年</translation>
                <original>そして昭和14年</original>
                <spell/>
            </t>
            <t vertical="0" index="53" torder="1" hasRuby="0" id="" time="">
                <start-time>00:03:43,122</start-time>
                <end-time>00:03:47,715</end-time>
                <translation>他发表了论文《绝对矛盾的自我同一》
論文絶対矛盾的自己同一を発表します</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" index="54" torder="1" hasRuby="0" id="" time="">
                <start-time>00:03:50,390</start-time>
                <end-time>00:03:56,000</end-time>
                <translation>现实世界必须始终是“他的一”</translation>
                <original>現実の世界はどこまでも他の一でなければならない</original>
                <spell/>
            </t>
            <t vertical="0" index="55" torder="1" hasRuby="0" id="" time="">
                <start-time>00:03:56,000</start-time>
                <end-time>00:03:57,737</end-time>
                <translation>必须是个体与个体
個物と個物との</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" index="56" torder="1" hasRuby="0" id="" time="">
                <start-time>00:03:57,737</start-time>
                <end-time>00:04:01,900</end-time>
                <translation>相互限定的世界</translation>
                <original>相互限定の世界でなければならない</original>
                <spell/>
            </t>
            <t vertical="0" index="57" torder="1" hasRuby="0" id="" time="">
                <start-time>00:04:01,900</start-time>
                <end-time>00:04:05,625</end-time>
                <translation>因此 我认为现实世界
故に私は現実の世界は</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" index="58" torder="1" hasRuby="0" id="" time="">
                <start-time>00:04:05,625</start-time>
                <end-time>00:04:09,515</end-time>
                <translation>就是绝对矛盾的自我同一
絶対矛盾的自己同一というのである</translation>
                <original/>
                <spell/>
            </t>
            <t vertical="0" index="59" torder="1" hasRuby="0" id="" time="">
                <start-time>00:04:11,465</start-time>
                <end-time>00:04:16,000</end-time>
                <translation>不同的事物保持其差异而成为一体</translation>
                <original>異なるものが異なるままで一つになる</original>
