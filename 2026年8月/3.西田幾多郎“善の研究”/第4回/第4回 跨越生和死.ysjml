            <t vertical="0" index="207" torder="1" hasRuby="0" id="" time="">
                <start-time>00:11:55,900</start-time>
                <end-time>00:12:00,025</end-time>
                <translation>首先 关于“过去与未来的矛盾自我同一的现在”
