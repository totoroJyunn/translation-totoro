            <t vertical="0" index="95" torder="1" hasRuby="0" id="" time="">
                <start-time>00:06:09,650</start-time>
                <end-time>00:06:10,660</end-time>
                <translation>我们应当铭记这一点</translation>
                <original>私たちは覚えておきたい</original>
                <spell/>
            </t>
            <t vertical="0" index="96" torder="1" hasRuby="0" id="" time="">
                <start-time>00:06:10,660</start-time>
                <end-time>00:06:13,260</end-time>
                <translation>因此 我们的痛苦与悲伤</translation>
                <original>ですので私たちの苦しみや悲しみも</original>
                <spell/>
            </t>
            <t vertical="0" index="97" torder="1" hasRuby="0" id="" time="">
                <start-time>00:06:13,260</start-time>
                <end-time>00:06:15,450</end-time>
                <translation>并不会仅仅终结于自身</translation>
