            </t>
            <t vertical="0" index="61" torder="1" hasRuby="0" id="" time="">
                <start-time>00:04:19,975</start-time>
                <end-time>00:04:23,350</end-time>
                <translation>西田将绝对矛盾的自我同一</translation>
                <original>西田は絶対矛盾的自己同一を</original>
