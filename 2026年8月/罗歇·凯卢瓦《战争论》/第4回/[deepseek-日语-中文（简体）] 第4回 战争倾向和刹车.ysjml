            <t index="214" id="" time="" vertical="0" torder="1" hasRuby="0">
                <start-time>00:13:09,775</start-time>
                <end-time>00:13:13,000</end-time>
                <translation>所以这就会无休止地持续下去</translation>
                <original>だからどこまでも続けていくことになって</original>
