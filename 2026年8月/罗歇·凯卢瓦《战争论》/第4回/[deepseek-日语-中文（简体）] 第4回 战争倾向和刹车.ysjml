            </t>
            <t index="196" id="" time="" vertical="0" torder="1" hasRuby="0">
                <start-time>00:12:23,220</start-time>
                <end-time>00:12:25,875</end-time>
                <translation>然后 恐怖分子发动了战争</translation>
