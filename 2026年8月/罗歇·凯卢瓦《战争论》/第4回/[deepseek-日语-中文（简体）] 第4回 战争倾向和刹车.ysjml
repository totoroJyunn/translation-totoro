            <t index="211" id="" time="" vertical="0" torder="1" hasRuby="0">
                <start-time>00:13:03,675</start-time>
                <end-time>00:13:06,252</end-time>
                <translation>现在进展到什么程度</translation>
                <original>今どれぐらいの見込みなのか</original>
