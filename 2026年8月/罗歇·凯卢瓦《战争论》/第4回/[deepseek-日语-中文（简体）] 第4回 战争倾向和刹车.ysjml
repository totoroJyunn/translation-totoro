            <t index="206" id="" time="" vertical="0" torder="1" hasRuby="0">
                <start-time>00:12:50,025</start-time>
                <end-time>00:12:52,980</end-time>
                <translation>自从阿富汗轰炸以来</translation>
                <original>アフガニスタン爆撃以来ね</original>
                <spell/>
            </t>
            <t index="207" id="" time="" vertical="0" torder="1" hasRuby="0">
                <start-time>00:12:52,980</start-time>
                <end-time>00:12:56,075</end-time>
                <translation>所谓的战果 就是杀了恐怖分子</translation>
