            <t index="218" id="" time="" vertical="0" torder="1" hasRuby="0">
                <start-time>00:13:21,350</start-time>
                <end-time>00:13:24,950</end-time>
                <translation>界限真的会消失</translation>
                <original>本当に限界が消えちゃう</original>
