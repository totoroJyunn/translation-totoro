            <t index="239" id="" time="" vertical="0" torder="1" hasRuby="0">
                <start-time>00:14:27,325</start-time>
                <end-time>00:14:31,200</end-time>
                <translation>由国家主导的这类开发研究</translation>
                <original>国家主導でそういう開発研究っていうのが</original>
