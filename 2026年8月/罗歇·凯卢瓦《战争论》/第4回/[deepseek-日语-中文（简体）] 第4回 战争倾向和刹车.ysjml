            <t index="205" id="" time="" vertical="0" torder="1" hasRuby="0">
                <start-time>00:12:48,225</start-time>
                <end-time>00:12:50,025</end-time>
                <translation>直接就会这么想呢 不论如何</translation>
                <original>リアルでしたねなんかね</original>
