                <original/>
                <spell/>
            </t>
            <t index="163" id="" time="" vertical="0" torder="1" hasRuby="0">
                <start-time>00:10:40,625</start-time>
                <end-time>00:10:43,480</end-time>
                <translation>全方位措施得以实施
