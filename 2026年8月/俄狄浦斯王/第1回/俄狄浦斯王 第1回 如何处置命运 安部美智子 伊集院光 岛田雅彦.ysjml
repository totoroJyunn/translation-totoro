            </t>
            <t index="48" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:02:50,718</start-time>
                <end-time>00:02:51,621</end-time>
                <translation>没错啊</translation>
                <original>そうなんですよ</original>
                <spell/>
            </t>
            <t index="49" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:02:51,621</start-time>
                <end-time>00:02:53,811</end-time>
                <translation>所以在那之后</translation>
                <original>だからその後のね</original>
