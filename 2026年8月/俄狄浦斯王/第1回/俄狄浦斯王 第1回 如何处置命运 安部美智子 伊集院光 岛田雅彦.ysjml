                <original>役者によって演じられるっていう意味です</original>
                <spell/>
            </t>
            <t index="161" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:07:52,955</start-time>
                <end-time>00:07:54,705</end-time>
