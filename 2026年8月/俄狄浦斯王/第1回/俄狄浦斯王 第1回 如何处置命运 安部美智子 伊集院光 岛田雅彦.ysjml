            <t index="50" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:02:53,811</start-time>
                <end-time>00:02:56,490</end-time>
                <translation>古今东西所写的一切故事</translation>
                <original>あの古今東西に書かれるあらゆる物語は</original>
