            <t index="454" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:22:21,838</start-time>
                <end-time>00:22:24,318</end-time>
                <translation>即使觉得结果会完全陷入僵局</translation>
                <original>結果完全にこれ手詰まりになるっていう</original>
