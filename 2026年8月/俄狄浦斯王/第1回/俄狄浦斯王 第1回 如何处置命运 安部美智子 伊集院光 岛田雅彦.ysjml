            <t index="453" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:22:19,609</start-time>
                <end-time>00:22:21,838</end-time>
                <translation>不想的话心里就不踏实</translation>
                <original>考えないと落ち着かないし</original>
