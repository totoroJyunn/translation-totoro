            <t index="448" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:22:07,409</start-time>
                <end-time>00:22:09,447</end-time>
                <translation>这么个立场</translation>
                <original>という立場ですね</original>
