            </t>
            <t index="410" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:20:26,208</start-time>
                <end-time>00:20:27,474</end-time>
                <translation>他是一位预言家</translation>
                <original>預言者なんですね</original>
