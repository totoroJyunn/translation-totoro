            <t index="420" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:20:54,334</start-time>
                <end-time>00:20:56,004</end-time>
                <translation>“无论如何”</translation>
                <original>どうあってもこのことは</original>
