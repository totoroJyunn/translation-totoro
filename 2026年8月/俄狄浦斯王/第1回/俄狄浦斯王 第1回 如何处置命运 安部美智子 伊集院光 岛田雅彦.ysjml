            <t index="450" torder="1" time="" id="" hasRuby="0" vertical="0">
                <start-time>00:22:12,205</start-time>
                <end-time>00:22:14,572</end-time>
                <translation>是那种觉得想了也没用的事</translation>
                <original>考えてもしょうがないことを</original>
