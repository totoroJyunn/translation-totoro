            <t hasRuby="0" torder="1" id="" time="" vertical="0" index="411">
                <start-time>00:22:08,344</start-time>
                <end-time>00:22:11,808</end-time>
                <translation>我觉得 任何人的自我认知里</translation>
                <original>どんな人の自己認識でもこういう</original>
                <spell/>
            </t>
