            <t hasRuby="0" torder="1" id="" time="" vertical="0" index="14">
                <start-time>00:01:27,940</start-time>
                <end-time>00:01:30,440</end-time>
                <translation>好的 本月的书目是《俄狄浦斯王》</translation>
                <original>さあ今月はオイディプス王</original>
                <spell/>
            </t>
            <t hasRuby="0" torder="1" id="" time="" vertical="0" index="15">
                <start-time>00:01:30,440</start-time>
                <end-time>00:01:33,650</end-time>
