            </t>
            <t hasRuby="0" torder="1" id="" time="" vertical="0" index="44">
                <start-time>00:02:49,500</start-time>
                <end-time>00:02:51,500</end-time>
                <translation>才有趣呢</translation>
                <original>面白いんですね</original>
                <spell/>
            </t>
            <t hasRuby="0" torder="1" id="" time="" vertical="0" index="45">
                <start-time>00:02:51,500</start-time>
                <end-time>00:02:55,491</end-time>
                <translation>这部《俄狄浦斯王》中散布着哪些主题呢？</translation>
