            <t hasRuby="0" torder="1" id="" time="" vertical="0" index="371">
                <start-time>00:19:57,221</start-time>
                <end-time>00:20:01,373</end-time>
                <translation>既有探寻到的自我其实没什么了不起的情况</translation>
