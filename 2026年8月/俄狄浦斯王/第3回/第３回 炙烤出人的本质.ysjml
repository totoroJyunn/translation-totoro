            <t hasRuby="0" torder="1" id="" time="" vertical="0" index="399">
                <start-time>00:21:30,652</start-time>
                <end-time>00:21:34,257</end-time>
                <translation>我就会想 会不会我其实是有钱人家的孩子呢</translation>
