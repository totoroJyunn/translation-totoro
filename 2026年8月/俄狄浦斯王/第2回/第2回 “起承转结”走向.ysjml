            <t time="" hasRuby="0" index="266" torder="1" vertical="0" id="">
                <start-time>00:15:23,439</start-time>
                <end-time>00:15:26,035</end-time>
                <translation>俄狄浦斯却惊了“真的假的啊”</translation>
                <original>マジかってなってるわけですもんね</original>
