            <t time="" hasRuby="0" index="187" torder="1" vertical="0" id="">
                <start-time>00:11:21,363</start-time>
                <end-time>00:11:22,832</end-time>
                <translation>就变得疑神疑鬼的了</translation>
                <original>今みたいに物入りになるね</original>
