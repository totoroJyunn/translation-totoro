            <t time="" hasRuby="0" index="267" torder="1" vertical="0" id="">
                <start-time>00:15:26,035</start-time>
                <end-time>00:15:28,204</end-time>
                <translation>紧接着接下来</translation>
                <original>これに畳みかけるようにですね</original>
