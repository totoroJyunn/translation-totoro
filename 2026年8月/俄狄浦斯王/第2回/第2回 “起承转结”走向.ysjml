            <t time="" hasRuby="0" index="239" torder="1" vertical="0" id="">
                <start-time>00:14:06,413</start-time>
                <end-time>00:14:08,564</end-time>
                <translation>我正是</translation>
                <original>このわしこそは</original>
                <spell/>
            </t>
            <t time="" hasRuby="0" index="240" torder="1" vertical="0" id="">
                <start-time>00:14:08,564</start-time>
                <end-time>00:14:12,993</end-time>
                <translation>不被任何人迎入家中</translation>
                <original>何人からも家に迎え入れられることも</original>
                <spell/>
            </t>
            <t time="" hasRuby="0" index="241" torder="1" vertical="0" id="">
                <start-time>00:14:12,993</start-time>
                <end-time>00:14:15,916</end-time>
                <translation>也不被允许与人交谈</translation>
                <original>話しかけられることも許されず</original>
