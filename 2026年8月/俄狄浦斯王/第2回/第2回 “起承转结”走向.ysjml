            </t>
            <t time="" hasRuby="0" index="183" torder="1" vertical="0" id="">
                <start-time>00:11:15,550</start-time>
                <end-time>00:11:16,440</end-time>
                <translation>俄狄浦斯也是</translation>
                <original>オイディプスが</original>
                <spell/>
            </t>
            <t time="" hasRuby="0" index="184" torder="1" vertical="0" id="">
                <start-time>00:11:16,440</start-time>
                <end-time>00:11:17,780</end-time>
                <translation>想到原来如此 原来如此</translation>
                <original>なるほどなるほど</original>
                <spell/>
            </t>
            <t time="" hasRuby="0" index="185" torder="1" vertical="0" id="">
                <start-time>00:11:17,780</start-time>
                <end-time>00:11:19,825</end-time>
                <translation>这两个是一伙的</translation>
                <original>これとこれが一味でこうして</original>
