            <t time="" hasRuby="0" index="186" torder="1" vertical="0" id="">
                <start-time>00:11:19,825</start-time>
                <end-time>00:11:21,363</end-time>
                <translation>都是觊觎我的位子</translation>
                <original>俺のことを嫌っていれば</original>
