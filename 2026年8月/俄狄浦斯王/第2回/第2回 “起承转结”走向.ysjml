            <t time="" hasRuby="0" index="255" torder="1" vertical="0" id="">
                <start-time>00:14:59,648</start-time>
                <end-time>00:15:01,401</end-time>
                <translation>前后很好地保持了连贯性</translation>
                <original>ちゃんと整合性取れてる</original>
                <spell/>
