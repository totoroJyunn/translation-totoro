            </t>
            <t time="" hasRuby="0" index="182" torder="1" vertical="0" id="">
                <start-time>00:11:13,200</start-time>
                <end-time>00:11:15,550</end-time>
                <translation>往往就跳不出来了呢</translation>
                <original>そこから逃れられなくなるじゃないですか</original>
