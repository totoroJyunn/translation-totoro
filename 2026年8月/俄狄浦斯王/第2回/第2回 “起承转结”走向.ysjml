            <t time="" hasRuby="0" index="168" torder="1" vertical="0" id="">
                <start-time>00:10:30,700</start-time>
                <end-time>00:10:33,575</end-time>
                <translation>这是非常出人意料的事情</translation>
                <original>これはものすごく意外なことなわけで</original>
