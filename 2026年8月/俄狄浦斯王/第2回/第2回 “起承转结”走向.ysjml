            <t time="" hasRuby="0" index="264" torder="1" vertical="0" id="">
                <start-time>00:15:19,900</start-time>
                <end-time>00:15:21,050</end-time>
                <translation>才这么说的呢</translation>
                <original>言ってるんですよね</original>
