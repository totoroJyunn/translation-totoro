            <t time="" hasRuby="0" index="252" torder="1" vertical="0" id="">
                <start-time>00:14:52,860</start-time>
                <end-time>00:14:55,611</end-time>
                <translation>刚才那段情节</translation>
                <original>もうあのくだりと</original>
