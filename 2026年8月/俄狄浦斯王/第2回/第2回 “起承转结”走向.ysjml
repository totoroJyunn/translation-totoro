            </t>
            <t time="" hasRuby="0" index="148" torder="1" vertical="0" id="">
                <start-time>00:09:28,800</start-time>
                <end-time>00:09:30,553</end-time>
                <translation>必须派人去请他来</translation>
                <original>呼びにやらねばならぬと</original>
