            </t>
            <t time="" hasRuby="0" index="277" torder="1" vertical="0" id="">
                <start-time>00:15:55,033</start-time>
                <end-time>00:15:56,553</end-time>
                <translation>这个科林斯的使者</translation>
                <original>コリントスの父者が</original>
                <spell/>
            </t>
            <t time="" hasRuby="0" index="278" torder="1" vertical="0" id="">
                <start-time>00:15:56,553</start-time>
                <end-time>00:15:59,528</end-time>
