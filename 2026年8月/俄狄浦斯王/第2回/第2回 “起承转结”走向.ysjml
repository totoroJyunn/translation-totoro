            </t>
            <t time="" hasRuby="0" index="210" torder="1" vertical="0" id="">
                <start-time>00:12:20,990</start-time>
                <end-time>00:12:22,650</end-time>
                <translation>这样一个教训</translation>
                <original>っていう一つの教訓も</original>
