            <t time="" hasRuby="0" index="272" torder="1" vertical="0" id="">
                <start-time>00:15:40,620</start-time>
                <end-time>00:15:44,020</end-time>
                <translation>但俄狄浦斯以为那是他的亲生父亲</translation>
                <original>だけどオイディプスは実の父だと思っています</original>
                <spell/>
            </t>
            <t time="" hasRuby="0" index="273" torder="1" vertical="0" id="">
                <start-time>00:15:44,020</start-time>
                <end-time>00:15:45,235</end-time>
                <translation>他这么以为 他这么以为</translation>
                <original>思ってます思ってます</original>
                <spell/>
            </t>
            <t time="" hasRuby="0" index="274" torder="1" vertical="0" id="">
                <start-time>00:15:45,235</start-time>
                <end-time>00:15:47,760</end-time>
                <translation>收到科林斯国王的死讯</translation>
                <original>コリントス王の死の知らせを受け</original>
