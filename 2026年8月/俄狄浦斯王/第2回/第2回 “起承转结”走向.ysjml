                <start-time>00:15:06,691</start-time>
                <end-time>00:15:09,358</end-time>
                <translation>因为我家前夫</translation>
                <original>だってうちの元の旦那は</original>
                <spell/>
            </t>
            <t time="" hasRuby="0" index="259" torder="1" vertical="0" id="">
                <start-time>00:15:09,358</start-time>
                <end-time>00:15:10,975</end-time>
                <translation>明明说会被儿子杀死</translation>
                <original>子供に殺されるって言ったのに</original>
