            <t time="" hasRuby="0" index="250" torder="1" vertical="0" id="">
                <start-time>00:14:47,861</start-time>
                <end-time>00:14:49,395</end-time>
                <translation>真是厉害啊</translation>
                <original>すごいですねこれ</original>
