            </t>
            <t time="" hasRuby="0" index="214" torder="1" vertical="0" id="">
                <start-time>00:12:30,253</start-time>
                <end-time>00:12:33,730</end-time>
                <translation>从寻找犯人变成寻找自我？
犯人探しから自分探し?</translation>
                <original/>
                <spell/>
