                <end-time>00:16:02,900</end-time>
                <translation>就这样坦白了出来</translation>
                <original>ということを告白してしまう</original>
                <spell/>
            </t>
            <t time="" hasRuby="0" index="280" torder="1" vertical="0" id="">
                <start-time>00:16:02,900</start-time>
                <end-time>00:16:05,994</end-time>
                <translation>这种起伏太厉害了</translation>
                <original>すごいなこの揺ら揺さぶり方</original>
