        <part lastModifyTime="0" updateMethod="0">
            <t index="1" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:00:03,925</start-time>
                <end-time>00:00:08,225</end-time>
                <translation>希腊悲剧杰作《俄狄浦斯王》</translation>
                <original>ギリシャ悲劇の傑作オイディプス王</original>
                <spell/>
            </t>
            <t index="2" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:00:08,225</start-time>
                <end-time>00:00:12,800</end-time>
                <translation>其续篇描绘了双目失明的俄狄浦斯之后的故事</translation>
                <original>その続編には盲目となったオイディプスのその後が描かれます</original>
                <spell/>
            </t>
            <t index="3" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:00:17,120</start-time>
                <end-time>00:00:18,880</end-time>
                <translation>被逐出国家的俄狄浦斯</translation>
                <original>国を追われたオイディプスが</original>
                <spell/>
            </t>
            <t index="4" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:00:18,880</start-time>
                <end-time>00:00:21,920</end-time>
                <translation>在人生最后抵达的境界</translation>
                <original>人生の最後にたどり着いた境地</original>
                <spell/>
            </t>
            <t index="5" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:00:24,150</start-time>
                <end-time>00:00:27,310</end-time>
                <translation>其中蕴含着对战争的愚蠢</translation>
                <original>そこには戦争の愚かしさや</original>
                <spell/>
            </t>
            <t index="6" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:00:27,310</start-time>
                <end-time>00:00:31,625</end-time>
                <translation>以及人之为人的存在方式发出警告的深邃智慧</translation>
                <original>人としての在り方を警告する深い知恵がありました</original>
                <spell/>
            </t>
            <t index="7" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:00:33,700</start-time>
                <end-time>00:00:37,220</end-time>
                <translation>本回将从这部写于2500年前的名著中</translation>
                <original>2500年前に書かれた名著から</original>
                <spell/>
            </t>
            <t index="8" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:00:37,220</start-time>
                <end-time>00:00:40,040</end-time>
                <translation>解读出与现代社会相通的信息</translation>
                <original>現代に通じるメッセージを読み解きます</original>
                <spell/>
            </t>
            <t index="9" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:01:02,900</start-time>
                <end-time>00:01:08,450</end-time>
                <translation>第4回 在走向灭亡的时代活下去
第4回　滅びゆく時代を生き抜く</translation>
                <original/>
                <spell/>
            </t>
            <t index="10" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:01:09,010</start-time>
                <end-time>00:01:11,220</end-time>
                <translation>《100分de名著》的主持人武内陶子
100分de名著司会の竹内陶子です</translation>
                <original/>
                <spell/>
            </t>
            <t index="11" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:01:11,220</start-time>
                <end-time>00:01:12,300</end-time>
                <translation>伊集院光
伊集院光です</translation>
                <original/>
                <spell/>
            </t>
            <t index="12" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:01:12,300</start-time>
                <end-time>00:01:14,475</end-time>
                <translation>来吧《俄狄浦斯王》</translation>
                <original>さあオイディプス王</original>
                <spell/>
            </t>
            <t index="13" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:01:14,475</start-time>
                <end-time>00:01:18,061</end-time>
                <translation>今天我们来看看双目失明的俄狄浦斯王</translation>
                <original>今日は盲目となったオイディプス王の</original>
                <spell/>
            </t>
            <t index="14" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:01:18,061</start-time>
                <end-time>00:01:20,360</end-time>
                <translation>-在那之后的故事 -在那之后？</translation>
                <original>-その後を見ていきます　-その後?</original>
                <spell/>
            </t>
            <t index="15" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:01:20,360</start-time>
                <end-time>00:01:22,699</end-time>
                <translation>- 之后的故事 - 之后还有？</translation>
                <original>-その後なんです　-その後ですか</original>
                <spell/>
            </t>
            <t index="16" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:01:22,699</start-time>
                <end-time>00:01:26,000</end-time>
                <translation>是的 本次的讲师依然是作家岛田雅彦老师
はい今回も講師の先生は作家の島田雅彦さんです</translation>
                <original/>
                <spell/>
            </t>
            <t index="17" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:01:26,000</start-time>
                <end-time>00:01:28,625</end-time>
                <translation>请多多关照</translation>
                <original>どうぞよろしくお願いいたします</original>
                <spell/>
            </t>
            <t index="18" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:01:28,625</start-time>
                <end-time>00:01:32,525</end-time>
                <translation>这么说来 这部《俄狄浦斯王》还有续集啊</translation>
                <original>というわけでこのオイディプス王はその後があるんですね</original>
                <spell/>
            </t>
            <t index="19" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:01:32,525</start-time>
                <end-time>00:01:35,000</end-time>
                <translation>是的 就是这本</translation>
                <original>そうですねこれなんですけども</original>
                <spell/>
            </t>
            <t index="20" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:01:35,000</start-time>
                <end-time>00:01:39,950</end-time>
                <translation>《俄狄浦斯王》是索福克勒斯在创作巅峰期写下的</translation>
                <original>オイディプス王はソポクレスが脂の乗り切った時代に書かれた</original>
                <spell/>
            </t>
            <t index="21" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:01:39,950</start-time>
                <end-time>00:01:43,650</end-time>
                <translation>故事本身也是人值壮年的故事
それ自体が壮年の物語</translation>
                <original/>
                <spell/>
            </t>
            <t index="22" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:01:43,650</start-time>
                <end-time>00:01:47,450</end-time>
                <translation>是波澜万丈的故事 而与之相对</translation>
                <original>波乱万丈の物語だったのに対してですね</original>
                <spell/>
            </t>
            <t index="23" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:01:47,450</start-time>
                <end-time>00:01:52,400</end-time>
                <translation>这部续篇是索福克勒斯在晚年最后阶段创作的作品</translation>
                <original>こちらの続編はソポクレス最晩年に書かれた作品で</original>
                <spell/>
            </t>
            <t index="24" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:01:52,400</start-time>
                <end-time>00:01:58,000</end-time>
                <translation>讲述了步入老境的俄狄浦斯的续集</translation>
                <original>老境に達したオイディプスのその後の物語になっております</original>
                <spell/>
            </t>
            <t index="25" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:01:58,000</start-time>
                <end-time>00:02:00,050</end-time>
                <translation>虽然我很想知道</translation>
                <original>知りたいですけど</original>
                <spell/>
            </t>
            <t index="26" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:02:00,050</start-time>
                <end-time>00:02:02,350</end-time>
                <translation>但之前结尾不是相当好嘛</translation>
                <original>かなりいい感じで終わってたじゃないですか</original>
                <spell/>
            </t>
            <t index="27" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:02:02,350</start-time>
                <end-time>00:02:05,800</end-time>
                <translation>是呢 他以自我惩罚的形式刺瞎了双眼</translation>
                <original>そうですね自己懲罰という形で目をついて</original>
                <spell/>
            </t>
            <t index="28" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:02:05,800</start-time>
                <end-time>00:02:09,275</end-time>
                <translation>并将自己从自己的国家放逐出去</translation>
                <original>自らの国から自分を追放するということで</original>
                <spell/>
            </t>
            <t index="29" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:02:09,275</start-time>
                <end-time>00:02:15,250</end-time>
                <translation>一般来说 大家都会觉得这样就没有后续了吧</translation>
                <original>まあこれで普通後はないよねと思うところなんですが</original>
                <spell/>
            </t>
            <t index="30" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:02:15,250</start-time>
                <end-time>00:02:18,500</end-time>
                <translation>一个已经看清了真正的自我的人</translation>
                <original>本当の自分というものを見てしまったものが</original>
                <spell/>
            </t>
            <t index="31" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:02:18,500</start-time>
                <end-time>00:02:22,225</end-time>
                <translation>在那之后竟然还有第二段人生</translation>
                <original>そこからまだ第二の人生があるということが</original>
                <spell/>
            </t>
            <t index="32" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:02:22,225</start-time>
                <end-time>00:02:23,750</end-time>
                <translation>可以一窥其中呢</translation>
                <original>分かるわけですね</original>
                <spell/>
            </t>
            <t index="33" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:02:23,750</start-time>
                <end-time>00:02:24,960</end-time>
                <translation>开始有点期待了</translation>
                <original>ちょっと楽しみになってまいりました</original>
                <spell/>
            </t>
            <t index="34" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:02:24,960</start-time>
                <end-time>00:02:27,850</end-time>
                <translation>是啊 索福克勒斯写了些什么呢</translation>
                <original>ねえソポクレス何を書き込んだんでしょうか</original>
                <spell/>
            </t>
            <t index="35" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:02:27,850</start-time>
                <end-time>00:02:29,225</end-time>
                <translation>请看这边</translation>
                <original>こちらをご覧ください</original>
                <spell/>
            </t>
            <t index="36" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:02:32,300</start-time>
                <end-time>00:02:34,525</end-time>
                <translation>仿佛被命运玩弄一般</translation>
                <original>運命にもてあそばれるかのように</original>
                <spell/>
            </t>
            <t index="37" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:02:34,525</start-time>
                <end-time>00:02:36,780</end-time>
                <translation>杀死了亲生父亲</translation>
                <original>実の父を殺し</original>
                <spell/>
            </t>
            <t index="38" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:02:36,780</start-time>
                <end-time>00:02:41,525</end-time>
                <translation>并与母亲生下了孩子的 俄狄浦斯</translation>
                <original>母との間に子をなしたオイディプス</original>
                <spell/>
            </t>
            <t index="39" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:02:41,525</start-time>
                <end-time>00:02:45,625</end-time>
                <translation>得知真相后 自己刺瞎了双眼的 俄狄浦斯</translation>
                <original>その事実を知り自ら目をつぶしたオイディプスが</original>
                <spell/>
            </t>
            <t index="40" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:02:45,625</start-time>
                <end-time>00:02:49,080</end-time>
                <translation>故事以他被逐出国家结尾</translation>
                <original>国を追われるところで物語は終わりました</original>
                <spell/>
            </t>
            <t index="41" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:02:52,855</start-time>
                <end-time>00:02:56,500</end-time>
                <translation>《俄狄浦斯王》上演二十多年后
オイディプス王上演から二十数年後</translation>
                <original/>
                <spell/>
            </t>
            <t index="42" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:02:56,500</start-time>
                <end-time>00:02:59,700</end-time>
                <translation>索福克勒斯在晚年写下的续篇</translation>
                <original>ソポクレスが最晩年に書いた続編が</original>
                <spell/>
            </t>
            <t index="43" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:02:59,700</start-time>
                <end-time>00:03:01,840</end-time>
                <translation>就是《俄狄浦斯在科罗诺斯》</translation>
                <original>コロノスのオイディプスです</original>
                <spell/>
            </t>
            <t index="44" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:03:04,990</start-time>
                <end-time>00:03:08,925</end-time>
                <translation>俄狄浦斯作为被诅咒的存在 遭人厌恶</translation>
                <original>オイディプスは呪わしい存在として意味嫌われ</original>
                <spell/>
            </t>
            <t index="45" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:03:08,925</start-time>
                <end-time>00:03:11,100</end-time>
                <translation>沦落为乞讨者</translation>
                <original>物乞いへと身をやつしていました</original>
                <spell/>
            </t>
            <t index="46" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:03:13,725</start-time>
                <end-time>00:03:16,450</end-time>
                <translation>领着年老的俄狄浦斯的手前行的</translation>
                <original>年老いたオイディプスの手を引くのは</original>
                <spell/>
            </t>
            <t index="47" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:03:16,450</start-time>
                <end-time>00:03:19,000</end-time>
                <translation>是他女儿安提戈涅</translation>
                <original>娘アンティゴネ</original>
                <spell/>
            </t>
            <t index="48" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:03:19,000</start-time>
                <end-time>00:03:22,140</end-time>
                <translation>她一直充当他的眼睛 支撑着他</translation>
                <original>彼の目となり支え続けてきました</original>
                <spell/>
            </t>
            <t index="49" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:03:25,215</start-time>
                <end-time>00:03:26,575</end-time>
                <translation>在雅典郊外</translation>
                <original>アテナイの外れ</original>
                <spell/>
