            <t index="323" id="" vertical="0" torder="1" hasRuby="0" time="">
                <start-time>00:18:22,515</start-time>
                <end-time>00:18:28,620</end-time>
                <translation>俄狄浦斯选择了在雅典的土地上成为守护神</translation>
